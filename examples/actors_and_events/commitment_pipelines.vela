; Commitment pipelines (`.then` via `|>`): running multi-step fallible chains
; inside `rush (...)`, continuing with caller `.then` transformations after
; `<<-`, applying inline lambda combinators, and combining parallel commitments.

kind OrderError
    BadQty(raw: text)
    OutOfStock(available: int)
fi

task parse_qty(raw: text) -> int ~ OrderError
    <- int(raw) { <- fail BadQty(raw) }
fi

task reserve_stock(wanted: int, available: int) -> int ~ OrderError
    when wanted > available
        <- fail OutOfStock(available)
    fi
    <- wanted
fi

task unit_price(cents_each: int, qty: int) -> int
    <- qty * cents_each
fi

task add_tax(subtotal: int) -> int
    <- subtotal + subtotal / 10
fi

task apply_discount(total: int, pct: int) -> int
    <- total - (total * pct) / 100
fi

task then_map(val: int, next: (int) -> int) -> int
    <- val |> next()
fi

task format_badge(cents: int, label: text@r, r: region default) -> text@r
    <- "{label}: {cents}c" at r
fi

task compute_shipping(weight: int) -> int
    <- 400 + weight * 25
fi

task load_profile_tier(user_id: int) -> int
    <- when user_id >= 100 15 else 5 fi
fi

task main()
    region r default

    ; 1. Whole `.then` pipeline executing concurrently inside `rush (...)`
    fixed ok_quote = rush ("20" |> parse_qty() |> reserve_stock(50) |>> unit_price(150) |> add_tax())
    fixed fail_quote = rush ("80" |> parse_qty() |> reserve_stock(50) |>> unit_price(150) |> add_tax())

    ; 2. Post-await `.then` continuation pipeline with region formatting on the caller
    fixed badge = <<- ok_quote |> apply_discount(10) |> format_badge("ok") at r { failure e
        "err"
    }
    show(badge)

    fixed fallback = <<- fail_quote |> apply_discount(10) { failure e
        show("caught pipe failure: ", e)
        0
    }
    show("fallback total: ", fallback)

    ; 3. Inline lambda continuation after awaiting a commitment
    fixed base_c = rush unit_price(10, 4)
    fixed mapped = <<- base_c |> then_map((x: int) -> int <- x * 2 + 5 fi)
    show("lambda mapped: ", mapped)

    ; 4. Dependent waterfall (stage 1 feeds stage 2) alongside parallel shipping job
    fixed tier_c = rush load_profile_tier(105)
    fixed ship_c = rush compute_shipping(8)
    fixed discount_pct = <<- tier_c
    fixed discounted_ship_c = rush apply_discount(<<- ship_c, discount_pct)
    show("final shipping: ", <<- discounted_ship_c)
fi
