; Tasks as values, lambdas, and a decorator. A task's name without `()` is a
; value of its type, written as its header without names: `(int) -> int`. A
; lambda is a task with no name, written where its value goes, which takes
; nothing from the code around it. A startup decorator, `$d` above a task, runs
; `d(task)` once, before `main`; a wrapper, `$(w)`, runs `w` at every call of
; the task, which is given the task to call. A type group, `P...`, lets one
; wrapper fit a task of any parameters.

shape Rule
    name: text
    check: (int) -> bool
fi

; How many times a counted task has run.
shape Runs
    shared flex count: int = 0
fi

; Counts each call of the task it wraps, whatever the task takes.
task counted<P..., R>(next: (P...) -> R, args: P...) -> R
    Runs.count++
    <- next(args...)
fi

; Says that a rule is ready, trying it on 4.
task announce(rule: (int) -> bool)
    show("rule ready: 4 passes it? ", rule(4))
fi

; Wraps a rule so that no negative number passes it.
task never_negative(rule: (int) -> bool, n: int) -> bool
    <- n >= 0 and rule(n)
fi

$announce
$(counted, never_negative)
task is_even(n: int) -> bool
    <- n % 2 == 0
fi

; How many of the numbers pass a rule.
task count(xs: [int]@r, keep: (int) -> bool) -> int
    flex n = 0
    each x in xs
        when keep(x)
            n++
        fi
    fi
    <- n
fi

; Each number changed by a task, into a new slice.
task mapped(xs: [int]@r, change: (int) -> int, out: region) -> [int]@out
    flex ys = new [int]() at out
    each x in xs
        ys.add(change(x))
    fi
    <- ys
fi

task main()
    region r
    fixed xs = [3, 8, 15, 4, 23, 42, -6, ...] at r
    fixed even = Rule { name: "even", check: is_even }
    fixed big = Rule { name: "big", check: (n: int) -> bool <- n > 10 fi }
    fixed odd = Rule { name: "odd", check: (n: int) -> bool <- not is_even(n) fi }
    fixed rules = [even, big, odd]
    each rule in rules
        show(rule.name, ": ", count(xs, rule.check))
    fi
    fixed doubled = mapped(xs, (x: int) -> int <- x * 2 fi, r)
    show(doubled)
    fixed squared = mapped(xs, (x: int) -> int
        fixed y = x * x
        <- y
    fi, r)
    show(squared)
    show("is_even ran ", Runs.count, " times")
fi
