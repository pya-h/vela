; Vela demo: tasks, shapes, pointers, control flow, and text

shape Point
    x: int
    y: int
fi

task add(a: int, b: int) -> int
    <- a + b
fi

task manhattan(p: Point) -> int
    <- p.x + p.y
fi

task main()
    bind sum = add(3, 4)
    show(sum)

    bind p = Point { x: 10, y: 20 }
    show(p.x)
    show(manhattan(p))

    hold i = 0
    loop i < 5
        show(i)
        i++
    fi

    each n in 0..3
        show(n)
    fi

    when sum > 5
        show("big")
    else
        show("small")
    fi

    region numbers
    bind ptr: ^int@numbers = new int(42) at numbers
    ; Text holding values is new text, so it goes in a region too.
    show("the answer is {ptr^}" at numbers)
fi
