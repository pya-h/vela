; What things cost, in cents. The discount rule is private to this file.

kind Item
    Apple
    Bread
    Cheese(grams: int)
fi

task price_of(item: Item) -> int
    match item
    case Apple
        <- 40
    case Bread
        <- 250
    case Cheese grams
        <- cheese(grams)
    fi
fi

priv task cheese(grams: int) -> int
    when grams >= 500
        <- grams * 2        ; big pieces cost less per gram
    fi
    <- grams * 3
fi
