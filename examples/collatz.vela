; Collatz walks: from a number, halve it when it is even, or take three times
; it and one when it is odd, until it reaches 1. A loop in three parts counts
; the steps of each walk, and 'endless' looks for the first start whose walk
; is longer than a goal, stopping once it finds one.

task steps(from: int) -> int
    flex count = 0
    loop flex n = from || n != 1 || count++
        when n % 2 == 0
            n = n / 2
        else
            n = 3 * n + 1
        fi
    fi
    <- count
fi

task main()
    ; The walks of the first few starts, and the longest of them.
    flex longest = 0
    loop flex start = 1, fixed last = 8 || start <= last || start++
        fixed walk = steps(start)
        show(start, ": ", walk, " steps")
        when walk > longest
            longest = walk
        fi
    fi
    show("longest: ", longest)

    ; The first start whose walk takes more than 100 steps.
    flex start = 1
    endless
        when steps(start) > 100
            break
        fi
        start++
    fi
    show("first past 100: ", start, " (", steps(start), " steps)")
fi
