; A tiny to-do list: a linked list of shapes, each pointing to the next one
; (a `maybe ^Item`, since the last item has none), all in one region that
; frees them together; variants with and without a payload, `is` and plan B to
; read maybe values, text compared by contents, and a task with two named
; results.
kind Status
    Todo
    Done
    Blocked(reason: text)
fi

shape Item
    title: text
    status: Status
    next: maybe ^Item
fi

; A status in a region holds its text there, so the task names that region,
; and so does the text it sends, which may be the reason.
task describe(s: Status@r) -> text@r
    <- match s
    case Todo = "todo"
    case Done = "done"
    case Blocked reason = reason
    fi
fi

; `show` writes each value in turn, so the line needs no text of its own: the
; title, the status, and the brackets around it are written one after another.
; `flex` makes the parameter the task's own copy, which walks down the list.
task print_list(flex current: maybe ^Item@r)
    loop current is {flex item}
        show(item^.title, " [", describe(item^.status), "]")
        current = item^.next
    fi
fi

; Two things to report, so two results, and naming them makes the counting
; read as the task's answer: reaching the end sends what they hold.
task progress(first: maybe ^Item@r) -> done: int, total: int
    done, total <- 0, 0
    when first is {item}
        ; The rest of the list, counted by the same task.
        fixed rest_done, rest_total = progress(item^.next)
        done, total <- rest_done, rest_total + 1
        when item^.status is Done
            done <- done + 1
        fi
    fi
fi

; Reads the list given, so it walks it by calling itself for the rest: no flex
; name may be given what a fixed one owns.
task find(first: maybe ^Item@r, title: text) -> maybe ^Item@r
    when first is {item}
        when item^.title == title
            <- item
        fi
        <- find(item^.next, title)
    fi
    <- none
fi

; Adding allocates, so `add` takes the region to allocate in.
task add(r: region, title: text, status: Status, next: maybe ^Item@r) -> ^Item@r
    <- new Item(Item { title: title, status: status, next: next }) at r
fi

task main()
    ; Every item lives in `todos`, which frees them all when main ends.
    region todos
    flex third = add(todos, "ship it", Blocked("waiting for review"), none)
    flex second = add(todos, "write tests", Done, third)
    flex first = add(todos, "fix the parser", Todo, second)
    print_list(first)
    fixed done, total = progress(first)
    show(done, " of ", total, " done")

    when find(first, "write tests") is {flex tests}
        tests^.status = Todo
    fi
    ; Only the count of done items is wanted now, so the other is dropped.
    fixed still_done, _ = progress(first)
    show(still_done, " of them now")
    show(find(first, "celebrate") == none)

    ; A plan B gives a value to use when there is nothing to extract.
    fixed start = find(first, "celebrate") { first }
    show(start^.title)
fi
