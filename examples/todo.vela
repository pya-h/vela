# A tiny to-do list: a linked list of shapes, each pointing to the next one
# (a `maybe ^Item`, since the last item has none), variants with and without
# a payload, `is` and plan B to read maybe values, and text compared by contents.

kind Status
    Todo
    Done
    Blocked(reason: text)
fi

shape Item
    title: text
    status: Status
    next: maybe ^Item
fi

task describe(s: Status) -> text
    match s
    case Todo
        <- "todo"
    case Done
        <- "done"
    case Blocked reason
        <- reason
    fi
fi

task print_list(first: maybe ^Item)
    hold current = first
    loop current is {item}
        show(item^.title)
        show(describe(item^.status))
        current = item^.next
    fi
fi

task count_done(first: maybe ^Item) -> int
    hold count = 0
    hold current = first
    loop current is {item}
        when item^.status is Done
            count = count + 1
        fi
        current = item^.next
    fi
    <- count
fi

task find(first: maybe ^Item, title: text) -> maybe ^Item
    hold current = first
    loop current is {item}
        when item^.title == title
            <- item
        fi
        current = item^.next
    fi
    <- none
fi

task main()
    bind third = new Item(Item { title: "ship it", status: Blocked("waiting for review"), next: none })
    bind second = new Item(Item { title: "write tests", status: Done, next: third })
    bind first = new Item(Item { title: "fix the parser", status: Todo, next: second })
    print_list(first)
    show(count_done(first))

    when find(first, "write tests") is {tests}
        tests^.status = Todo
    fi
    show(count_done(first))
    show(find(first, "celebrate") == none)

    # A plan B gives a value to use when there is nothing to extract.
    bind start = find(first, "celebrate") { first }
    show(start^.title)

    free(third)
    free(second)
    free(first)
fi
