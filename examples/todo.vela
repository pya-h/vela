# A tiny to-do list: a linked list of shapes, each pointing to the next one
# (a `maybe ^Item`, since the last item has none), all in one region that
# frees them together; variants with and without a payload, `is` and plan B to
# read maybe values, text compared by contents, and a task with two named
# results.
kind Status
    Todo
    Done
    Blocked(reason: text)
fi

shape Item
    title: text
    status: Status
    next: maybe ^Item
fi

task describe(s: Status) -> text
    match s
    case Todo
        <- "todo"
    case Done
        <- "done"
    case Blocked reason
        <- reason
    fi
fi

task print_list(first: maybe ^Item@r)
    hold current = first
    loop current is {item}
        show(item^.title)
        show(describe(item^.status))
        current = item^.next
    fi
fi

# Two things to report, so two results, and naming them makes the counting
# read as the task's answer: reaching the end sends what they hold.
task progress(first: maybe ^Item@r) -> done: int, total: int
    hold current = first
    done, total <- 0, 0
    loop current is {item}
        when item^.status is Done
            done <- done + 1
        fi
        total <- total + 1
        current = item^.next
    fi
fi

task find(first: maybe ^Item@r, title: text) -> maybe ^Item@r
    hold current = first
    loop current is {item}
        when item^.title == title
            <- item
        fi
        current = item^.next
    fi
    <- none
fi

# Adding allocates, so `add` takes the region to allocate in.
task add(r: region, title: text, status: Status, next: maybe ^Item@r) -> ^Item@r
    <- new Item(Item { title: title, status: status, next: next }) at r
fi

task main()
    # Every item lives in `todos`, which frees them all when main ends.
    region todos
    bind third = add(todos, "ship it", Blocked("waiting for review"), none)
    bind second = add(todos, "write tests", Done, third)
    bind first = add(todos, "fix the parser", Todo, second)
    print_list(first)
    bind done, total = progress(first)
    show(done)
    show(total)

    when find(first, "write tests") is {tests}
        tests^.status = Todo
    fi
    # Only the count of done items is wanted now, so the other is dropped.
    bind still_done, _ = progress(first)
    show(still_done)
    show(find(first, "celebrate") == none)

    # A plan B gives a value to use when there is nothing to extract.
    bind start = find(first, "celebrate") { first }
    show(start^.title)
fi
