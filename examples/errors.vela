# Errors as values: a task that can fail sends `T ~ E`, and its caller
# handles the error with match, is, or a plan B.

kind ReadingError
    Missing
    TooCold(value: int)
    TooHot(value: int)

    # A reason holds a number, so saying why is new text, which goes in the
    # region the method is given. `show(problem)` calls this for us, in a region
    # it makes for the line, so printing a reason names no region at all.
    str(r: region) -> text@r
        match .this
        case Missing
            <- "no reading"
        case TooCold value
            <- "too cold: {value}" at r
        case TooHot value
            <- "too hot: {value}" at r
        fi
    fi
fi

task check(reading: maybe int) -> int ~ ReadingError
    bind value = reading { <- fail Missing }
    # Alternatives, so one chain: the first condition that holds sends.
    when value < -50
        <- fail TooCold(value)
    else when value > 60
        <- fail TooHot(value)
    fi
    <- value
fi

# `unit ~ E` sends nothing when it works: reaching the end succeeds.
task add_reading(sum: ^int@r, reading: maybe int) -> unit ~ ReadingError
    bind value = check(reading) {
        failure problem
        <- fail problem
    }
    sum^ = sum^ + value
fi

task main()
    # match handles both outcomes.
    match check(21)
    case {value}
        show("reading: ", value)
    case failure problem
        show(problem)
    fi

    # is runs a block for one outcome only.
    when check(99) is failure problem
        show(problem)
    fi

    # A plan B gives the value to use instead; `fail e` names the error.
    show(check(none) { 0 })
    bind lowest = check(-80) {
        failure problem
        show(problem)
        -50
    }
    show(lowest)

    # An error can't be ignored by accident: an empty plan B ignores it on purpose.
    region totals
    bind sum = new int(0) at totals
    add_reading(sum, 10) { }
    add_reading(sum, 70) {
        failure problem
        show(problem)
    }
    add_reading(sum, 5) { }
    show("sum: ", sum^)
fi
