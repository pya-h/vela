; Errors as values: a task that can fail sends `T ~ E`, and its caller
; handles the error with match, is, or a plan B.

kind ReadingError
    Missing
    TooCold(value: int)
    TooHot(value: int)

    ; A reason holds a number, so saying why is new text, which goes in the
    ; region the method is given. `show(problem)` calls this for us, in a region
    ; it makes for the line, so printing a reason names no region at all.
    str(r: region) -> text@r
        <- match .this
        case Missing = "no reading"
        case TooCold value = "too cold: {value}" at r
        case TooHot value = "too hot: {value}" at r
        fi
    fi
fi

task check(reading: maybe int) -> int ~ ReadingError
    bind value = reading { <- fail Missing }
    ; Alternatives, so one chain: the first condition that holds sends.
    when value < -50
        <- fail TooCold(value)
    else when value > 60
        <- fail TooHot(value)
    fi
    <- value
fi

; `nothing ~ E` sends nothing when it works: reaching the end succeeds. `hold&`
; makes `sum` the caller's own variable, which the call gives as `&total`.
task add_reading(hold& sum: int, reading: maybe int) -> nothing ~ ReadingError
    bind value = check(reading) {
        failure problem
        <- fail problem
    }
    sum = sum + value
fi

task main()
    ; match handles both outcomes.
    match check(21)
    case {value}
        show("reading: ", value)
    case failure problem
        show(problem)
    fi

    ; is runs a block for one outcome only.
    when check(99) is failure problem
        show(problem)
    fi

    ; A plan B gives the value to use instead; `fail e` names the error.
    show(check(none) { 0 })
    bind lowest = check(-80) {
        failure problem
        show(problem)
        -50
    }
    show(lowest)

    ; An error can't be ignored by accident: an empty plan B ignores it on purpose.
    hold total = 0
    add_reading(&total, 10) { }
    add_reading(&total, 70) {
        failure problem
        show(problem)
    }
    add_reading(&total, 5) { }
    show("sum: ", total)

    ; A plan B giving none keeps the value when there is one: a maybe, which
    ; `~=` compares with a plain value, false when it is empty.
    bind kept = check(-80) { none }
    bind fine = check(30) { none }
    show(kept, " ", fine, " ", fine ~= 30, " ", kept ~= 30)

    ; An is joined with and: the value, then a test of it.
    when check(21) is {value} and value > 20
        show("warm: ", value)
    fi
fi
