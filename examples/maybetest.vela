
task main()
    fixed x: maybe int = 1
    fixed a = x { 10 }
    show(a)
    fixed y = x { <- }  ; if its none then end program
    when x is { z }
        show("yeah")
        show(z)
    fi
    show(x)
    show(y)
    ; heap allocated stuff can be changed even if they
    region r default
    fixed x2 = new [int]([1,2,3])
    x2[0] = 2
    show(x2[0])
    fixed pnt = new int(1)
    pnt^ = 2
    show(pnt^)
fi