# A program in several files. `use` loads another file from this file's
# folder: shop/cart.vela is used through its name, as `cart.add(…)`, and the
# names in parentheses from shop/prices.vela are brought in directly. `priv`
# keeps a task, shape, kind, or field to the file that declares it.

use shop/cart
use shop/prices (Item, price_of)

task main()
    hold basket = cart.empty()
    basket = cart.add(basket, prices.Apple, 6)
    basket = cart.add(basket, prices.Bread, 1)
    basket = cart.add(basket, prices.Cheese(600), 1)
    show(basket.items)                       # 8
    show(cart.total(basket))                 # 1690 cents

    # Item came in by name; its variants are still named through `prices`.
    bind snack: Item = prices.Cheese(100)
    show(price_of(snack))                    # 300

    # `basket.total` would be an error here: the field is private to cart.vela,
    # so only its tasks can change it, and it always matches what was added.
fi
