task main()
    ; 1. Assertions
    assert 1 + 1 == 2, "basic addition"
    !assert 2 + 2 == 5, "refutation holds"

    ; 2. Indexed each loop
    fixed fruits = ["apple", "banana", "cherry"]
    each i, fruit in fruits
        show(i, ": ", fruit)
    fi

    ; 3. Inclusive and stepped ranges
    flex even_sum = 0
    each n in 0..2..=10
        even_sum = even_sum + n
    fi
    show("sum of evens 0..=10: ", even_sum)

    ; 4. Boolean condition keywords & prefix !
    fixed ready = true
    fixed active = false
    assert ready xor active
    assert !active
    assert not active

    ; 5. Integer bitwise operators
    fixed flags = 0b0011
    fixed mask  = 0b0101
    show("and: ", flags & mask)
    show("or:  ", flags | mask)
    show("xor: ", flags ^^ mask)
    show("shl: ", flags << 2)
    show("shr: ", flags >> 1)
fi
