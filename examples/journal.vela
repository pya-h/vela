; Notes read from input: `scan` shows a prompt and reads a line into a region,
; giving none once the input ends. Each line is read into a region of its own,
; and only the notes kept are copied into the slice's region with `copy()`. The
; notes are shown back last first. Run it and type a few lines (an empty line or
; Ctrl-D ends them), or give it a file: `./journal < notes.txt`.

; `default` makes the region this task is given the one its allocations use, so
; only what goes somewhere else names a region.
task read_notes(r: region default) -> [text]@r
    hold notes = new [text]()
    hold reading = true
    loop reading
        ; Freed at the end of every pass, with the line read into it. Inside this
        ; block it is the default, so the line needs no `at line_memory`.
        region line_memory default
        bind line = scan("note> ") { "" }
        when line == ""
            reading = false
        else
            ; A copy goes where the value it becomes goes, which is the slice's
            ; own region: a default never settles that for it.
            notes.add(line.copy())
        fi
    fi
    <- notes
fi

task main()
    ; Written out, as it always could be: a region is named where memory goes.
    region kept
    bind name = scan("Your name: ") at kept { "stranger" }
    show("Hello, ", name, "!")
    hold notes = read_notes(kept)
    show(notes.len, " notes, last first")
    hold number = notes.len
    loop notes.len > 0
        ; `show` writes each value in turn, so a line printed once needs no text
        ; of its own, and no region to hold it.
        show(number, ". ", notes.del())
        number--
    fi
fi
