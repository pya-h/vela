; Tuples: values held together, as `(text, int)`, read by position (`t.0`,
; `t.1`) and taken apart into names, in a binding or in a pattern. A tuple's
; items never change; a `flex` tuple can only take a whole new one.

; The lowest and highest score, as one tuple.
task range_of(scores: [(text, int)]@r) -> (int, int)
    flex low = scores[0].1
    flex high = scores[0].1
    each entry in scores
        fixed _, score = entry
        when score < low
            low = score
        fi
        when score > high
            high = score
        fi
    fi
    <- (low, high)
fi

; The name and score of the best entry, or none when there are none. Its text
; is in the slice's region.
task best(scores: [(text, int)]@r) -> maybe (text, int)@r
    when scores.len == 0
        <- none
    fi
    flex top = scores[0]
    each entry in scores
        when entry.1 > top.1
            top = entry
        fi
    fi
    <- top
fi

task main()
    region r
    flex scores = new [(text, int)]() at r
    scores.add(("Ada", 91))
    scores.add(("Bob", 78))
    scores.add(("Cy", 85))
    show(scores[0])
    fixed low, high = range_of(scores)
    show(high - low)                         ; 13

    ; A pattern takes the value out of the maybe and the tuple apart at once.
    when best(scores) is {(name, score)}
        show(name)                           ; Ada
        show(score)                          ; 91
    fi

    ; An entry is replaced whole; its items can't be assigned.
    scores[1] = ("Bob", 95)
    when best(scores) is {(_, top)}
        show(top)                            ; 95
    fi
fi
