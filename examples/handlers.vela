; Handlers kept as values: each takes the running total as a place it may
; change, so a table of them can be run in turn, and one that builds text is
; given the region to build it in. A task type says how each parameter is
; given: 'flex& int' for a place the task changes, '@r' for a region.

task add_ten(flex& total: int)
    total = total + 10
fi

task halve(flex& total: int)
    total = total / 2
fi

task square(flex& total: int)
    total = total * total
fi

; Builds its report in the region it is given, so the report lives there.
task report(r: region, total: int) -> text@r
    <- "total is " + total.str()@r at r
fi

; Logs each step: a wrapper gives the place on to the step it wraps.
task logged(next: (flex& int) -> nothing, flex& total: int)
    fixed before = total
    next(&total)
    show(before, " -> ", total)
fi

$(logged)
task double(flex& total: int)
    total = total * 2
fi

task run_all(steps: [(flex& int) -> nothing]@s, flex& total: int)
    each step in steps
        step(&total)
    fi
fi

task main()
    region r
    fixed steps = [add_ten, double, halve, square, ...] at r
    flex total = 1
    run_all(steps, &total)
    fixed describe: (@s, int) -> text@s = report
    show(describe(r, total))
fi
