; Primes below a limit, found twice: into a slice of fixed length filled by
; index, and into a slice that grows with add. Then del takes them out again,
; last first, and a loop through the slice as it is at each pass meets its end
; halfway.

task is_prime(n: int) -> bool
    each i in 2..(n/2 + 1)
        when n % i == 0
            <- false
        fi
    fi
    <- true
fi

task primes_below_no_add(r: region, limit: int) -> [int]@r
    bind primes: [int]@r = new [int]([0#limit]) at r  ; filled by index; primes_below does the same with add
    hold idx = 0

    each i in 2..limit
        when is_prime(i)
            primes[idx] = i
            idx = idx + 1
        fi
    fi
    <- (primes[0..idx])
fi

task primes_below(r: region, limit: int) -> [int]@r
    hold results: [int]@r = new [int]() at r

    each i in 2..limit
        when is_prime(i)
            results.add(i)
        fi
    fi
    <- results
fi

priv task main()
    region r
    bind primes_limit = 50
    bind results = primes_below(r, primes_limit)
    show("Found: ")
    show(results.len)
    show("-----------------------")
    each x in results
        show(x)
    fi
    show("-----------------------")

    hold x = results
    loop x.len > 0
        show(x.del())
    fi
    show("-----------------------")
    show(results.len) ; 15: x has a length of its own, so taking items out of x leaves results' as it was
    show(x.len)
    ; show(x.del()) would stop the program: vela: del() on an empty slice
    show("-----------------------")
    ; each through &y reads y as it is at each pass: every del takes the last
    ; item off, so the loop meets the end halfway, after 2 to 19
    hold y = results.copy() at r
    each p in &y
        show(p)
        y.del()
    fi
fi
