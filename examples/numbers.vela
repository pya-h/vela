# Numbers read from input: `scan` reads a line of text, and `int(line)` reads a
# number from that text, which may be no number at all — so it sends
# `int or ParseError`, handled here with a `match`. Run it and type a few numbers
# (an empty line or Ctrl-D ends them), or give it a file: `./numbers < readings.txt`.

task main()
    hold count = 0
    hold refused = 0
    hold total = 0
    hold largest = 0
    hold reading = true
    loop reading
        # Freed at the end of every pass, with the line read into it.
        region line_memory
        bind line = scan("> ") at line_memory { "" }
        when line == ""
            reading = false
        else
            match int(line)
            case {value}
                count = count + 1
                total = total + value
                when count == 1 or value > largest
                    largest = value
                fi
            case fail why
                refused = refused + 1
                # `ParseError` says which way the text was no number.
                match why
                case NotANumber
                    show(line, " is no number")
                case TooLarge
                    show(line, " does not fit in an int")
                fi
            fi
        fi
    fi
    when count == 0
        show("no numbers")
    else
        show(count, " read, ", refused, " refused")
        show("total ", total, ", largest ", largest)
        # An average is a float, so the count becomes one: an int and a float
        # don't mix on their own.
        show("average ", float(total) / float(count))
    fi
fi
