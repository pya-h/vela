; Numbers read from input: `scan("> ", int)` shows the prompt, reads a line, and
; sends the number it holds, or an `InputError` saying there is none — because
; the input ended, or because the line was no number, which holds the
; `ParseError` that reading it gave. Reading a number from text a program already
; has is `int(t)`, which sends that `ParseError` on its own, and reads a whole
; number written in another base too, as code writes one: `0x1F`, `0o17`, `0b101`.
;
; Run it and type a few numbers (Ctrl-D, or the end of a file given as input,
; ends them), or give it a file: `./numbers < readings.txt`.

include std/math

; The numbers a program reads may also come from text it holds.
task from_text()
    each written in ["6", "6.5", "-0", "0x1F", "-0b101", "010", "0b102"]
        match int(written)
        case {value}
            show(written, " is ", value)
        case failure why
            match why
            case NotANumber
                show(written, " is no whole number")
            case TooLarge
                show(written, " does not fit in an int")
            fi
        fi
    fi
fi

task main()
    from_text()

    hold count = 0
    hold refused = 0
    hold total = 0
    hold largest = 0
    ; The squares add up to how far the numbers spread from zero.
    hold squares = 0.0
    hold reading = true
    loop reading
        match scan("> ", int)
        case {value}
            count++
            total += value
            ; An int raised to 2, a constant, stays an exact int.
            squares += float(value ** 2)
            when count == 1 or value > largest
                largest = value
            fi
        case failure e
            match e
            ; Nothing more to read, so the loop is done.
            case Ended
                reading = false
            ; A line that was no number: the reason says which way.
            case NoNumber why
                refused++
                match why
                case NotANumber
                    show("that is no number")
                case TooLarge
                    show("that does not fit in an int")
                fi
            fi
        fi
    fi

    when count == 0
        show("no numbers")
    else
        show(count, " read, ", refused, " refused")
        show("total ", total, ", largest ", largest)
        ; An average is a float, so the count becomes one: an int and a float
        ; don't mix on their own.
        show("average ", float(total) / float(count))
        show("root mean square ", math.pow(squares / float(count), 0.5))
    fi
fi
