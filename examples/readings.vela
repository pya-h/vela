; Sensor readings, read with loops that give values. Each pass's last line
; gives the loop's value, the final pass's is the one kept, and a loop that
; has none fails with LoopResult: it never ran, a break stopped it, its final
; pass ended with continue, or its last line failed on purpose.

include std/loops {LoopResult}

shape Reading
    sensor: text
    value: int
fi

; Why a search found nothing, said in words.
task why(r: region, result: LoopResult<int, text>@r) -> text@r
    <- match result
    case Skipped = "no readings"
    case Broke spot = "a broken sensor at {spot { -1 }}" at r
    case EndedByContinue = "only quiet readings"
    case Manual reason = reason
    fi
fi

; The last reading above the floor, stopping at a broken sensor (a value
; below zero), and failing on purpose when the last reading is too high.
task last_above(readings: [Reading]@r, floor: int) -> int ~ LoopResult<int, text>
    flex last = 0
    fixed found = loop flex i = 0 || i < readings.len || i++
        fixed reading = readings[i]
        when reading.value < 0
            break = i
        fi
        when reading.value <= floor
            continue
        fi
        last = reading.value
    finally
        when last > 900 fail LoopResult.Manual("too high") else last fi
    fi
    <- found
fi

task main()
    region r
    fixed day = [Reading { sensor: "north", value: 12 }, Reading { sensor: "east", value: 40 }, Reading { sensor: "west", value: 31 }, ...] at r
    fixed night = [Reading { sensor: "north", value: 50 }, Reading { sensor: "east", value: 3 }, ...] at r
    fixed faulty = [Reading { sensor: "north", value: 22 }, Reading { sensor: "east", value: -1 }, Reading { sensor: "west", value: 70 }, ...] at r
    fixed spike = [Reading { sensor: "north", value: 22 }, Reading { sensor: "east", value: 950 }, ...] at r
    fixed empty = new [Reading]() at r

    each readings in [day, night, faulty, spike, empty]
        match last_above(readings, 10)
        case {value}
            show("last above 10: ", value)
        case failure result
            show("nothing found: ", why(r, result))
        fi
    fi

    ; The sum of the readings, as the value of a loop in three parts.
    fixed sum = loop flex i = 0, total = 0 || i < day.len || i++
        total += day[i].value
    finally
        total
    fi
    show("day total: ", sum { 0 })

    ; As a statement with a plan B, a loop gives nothing and only fails.
    each reading in faulty
        when reading.value < 0
            break
        fi
    fi {
        show("the faulty list has a broken sensor")
    }
fi
