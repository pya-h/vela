; Regions: a tree built in a region, a scratch region for every loop pass,
; and the one result that must survive copied into a longer-lived region.

kind Tree
    Leaf(value: int)
    Branch(left: ^Tree, right: ^Tree)
fi

; Allocates, so it takes the region to build in. Taken last, the region can be
; named after a call, as it is after `new`: `build(depth, seed) at r`.
task build(depth: int, seed: int, r: region) -> Tree@r
    when depth == 0
        <- Leaf(seed % 10)
    fi
    bind left = new Tree(build(depth - 1, seed * 3 + 1) at r) at r
    bind right = new@r Tree(build(depth - 1, seed * 7 + 2)@r)
    <- Branch(left, right)
fi

; Only reads, so it names the region without taking it.
task total(t: Tree@r) -> int
    <- match t
    case Leaf value = value
    case Branch left right = total(left^) + total(right^)
    fi
fi

; Copies a tree, node by node, into another region.
task copy(t: Tree@from, to: region) -> Tree@to
    match t
    case Leaf value
        <- Leaf(value)
    case Branch left right
        <- Branch(new Tree(copy(left^) at to) at to, new Tree(copy(right^)@to) at to)
    fi
fi

task main()
    region kept
    hold best: Tree@kept = Leaf(0)
    each round in 0..5
        region pass                      ; empty again, and freed, on every pass
        bind candidate = build(6, round) at pass
        show(total(candidate))
        when total(candidate) > total(best)
            best = copy(candidate) at kept
        fi
    fi
    show(total(best))
fi
