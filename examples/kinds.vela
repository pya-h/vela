# Kinds and pattern matching. A kind's methods, written below its variants,
# read the value as `.this` and take it apart with `match .this`; one marked
# `alters` may move the value to another variant, or the same one with new
# values.

kind Shape
    Circle(radius: float)
    Rectangle(width: float, height: float)
    Dot

    # A method named `str` says how the value becomes text. It makes new text,
    # so it takes the region the text goes in, and `"{shape}"` calls it.
    str(r: region) -> text@r
        match .this
        case Circle radius
            <- "circle of {radius}" at r
        case Rectangle w h
            <- "rectangle {w} by {h}" at r
        case Dot
            <- "dot"
        fi
    fi

    area() -> float
        match .this
        case Circle radius
            <- 3.14159 * radius * radius
        case Rectangle w h
            <- w * h
        case Dot
            <- 0.0
        fi
    fi

    alters grow()
        match .this
        case Circle radius
            .this = Circle(radius * 2.0)
        case Rectangle w h
            .this = Rectangle(w * 2.0, h * 2.0)
        case Dot
            .this = Circle(1.0)
        fi
    fi
fi

task main()
    # The text the shapes describe themselves with goes here.
    region said

    bind c = Circle(5.0)
    show("{c} covers {c.area()}" at said)

    # Only a `hold` value can change.
    hold rect = Rectangle(3.0, 4.0)
    rect.grow()
    show("{rect} covers {rect.area()}" at said)

    hold d = Dot
    show(d.str() at said)
    d.grow()
    show(text(d) at said)
fi
