# Kinds and pattern matching

kind Shape
    Circle(radius: float)
    Rectangle(width: float, height: float)
fi

task describe(s: Shape)
    match s
    case Circle r
        show("circle")
        show(r)
    case Rectangle w h
        show("rectangle")
        show(w)
        show(h)
    fi
fi

task main()
    bind c = Circle(5.0)
    bind r = Rectangle(3.0, 4.0)
    describe(c)
    describe(r)
fi
