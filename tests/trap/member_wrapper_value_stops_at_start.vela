; trap: division by zero at 9:19 in wrapper 'C.limited' on task 'C.get'
; A member wrapper's value stops where the program starts, named as its wrapper.
shape C
    n: int
    limited(next: (C, int) -> int, cap: int, k: int) -> int
        show("cap ", cap)
        <- next(.this, k)
    fi
    $(.limited(10 / zero()))
    get(k: int) -> int
        <- .n + k
    fi
fi
task zero() -> int
    <- 0
fi
task main()
    show("main starts")
    fixed c = C { n: 1 }
    show(c.get(3))
fi
