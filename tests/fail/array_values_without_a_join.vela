; error: 9:27: an array's values have one type, but this one is maybe int and the ones before it are int ~ text
task risky(n: int) -> int ~ text
    <- n
fi

task main()
    fixed m: maybe int = 3
    ; Neither fits the other: one would have to be remade inside.
    fixed xs = [risky(1), m]
    show(xs.len)
fi
