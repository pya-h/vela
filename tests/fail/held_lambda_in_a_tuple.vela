; error: 10:16: 'f' is a '[flex @r]' lambda, which changes what it keeps, so it is never copied: call it, 'f(…)', or give it as a place, '&f', to a 'flex& f: [flex @r]() -> int' parameter
; A [flex @r] lambda is held alone.
task main()
    region r
    flex n = 0
    flex f = [flex @r]() -> int
        n = n + 1
        <- n
    fi
    fixed t = (f, 1)
    show(1)
fi
