; error: 16:14: this task's type takes region 'r' twice; each region it takes has a name of its own
; Each region a task type takes has a name of its own.
task bump(flex& n: int)
    n = n + 1
fi

task both(flex& a: int, fixed& b: int)
    a = b
fi

task squares(r: region, n: int) -> [int]@r
    <- new [int]() at r
fi

task main()
    fixed f: (@r, @r) -> int = squares
fi
