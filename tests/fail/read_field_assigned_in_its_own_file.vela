; error: 12:11: 'total' is a read-only field of 'Tally', which only the alters methods of 'Tally' change
; The field belongs to the shape rather than the file, so a task of the file
; that declares it is outside it too.
shape Tally
    read total: int = 0
fi

task main()
    flex tally = Tally {}
    show(tally.total)
    ; The line below is the mistake.
    tally.total = 5
fi
