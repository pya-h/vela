; error: 9:21: a lambda keeps a variable as a place, not a field or an item of one; keep the variable, 'hold& p'
; A lambda keeps a variable as a place, never a field or an item of one.
shape P
    x: int
fi
task main()
    hold p = P { x: 1 }
    region r
    bind f = [hold& p.x, @r]() -> nothing show(1) fi
fi
