; error: 16:14: a region is given as it is, so a task's type writes it '@r' alone, never as a place
; A region is given as it is, never as a place.
task bump(hold& n: int)
    n = n + 1
fi

task both(hold& a: int, bind& b: int)
    a = b
fi

task squares(r: region, n: int) -> [int]@r
    <- new [int]() at r
fi

task main()
    bind f: (hold& @r) -> int = squares
fi
