; error: 16:15: a region is given as it is, so a task's type writes it '@r' alone, never as a place
; A region is given as it is, never as a place.
task bump(flex& n: int)
    n = n + 1
fi

task both(flex& a: int, fixed& b: int)
    a = b
fi

task squares(r: region, n: int) -> [int]@r
    <- new [int]() at r
fi

task main()
    fixed f: (flex& @r) -> int = squares
fi
