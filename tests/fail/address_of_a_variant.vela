; error: 21:11: '&' takes the address of a place: a variable, a field or an item of one, or what a pointer points to, and this is a variant, which is a value, with no place of its own
shape Point
    x: int
    alters bump()
        .x = .x + 1
    fi
fi
kind Mood
    Calm
fi
task made() -> int
    <- 1
fi
task main()
    region r
    flex p = Point { x: 1 }
    fixed n = 1
    fixed t = "abc"
    fixed ptr = new int(1) at r
    fixed m: maybe ^int@r = ptr
    show(&Mood.Calm)
fi
