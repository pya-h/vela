; error: 7:5: 'File.open' changes the value it is called on, so it needs a place that can change, and 'notes' never does (declared at 6:11); a value declared with 'hold' can
include std/files {File, FileMode}

task main()
    region r
    fixed notes = File { path: "notes.txt" }
    notes.open(FileMode.Read) at r { failure e
        show("could not open")
    }
fi
