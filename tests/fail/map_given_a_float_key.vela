; error: 8:23: a map's key is compared and hashed, so it is an int, a unit, a char, a bool, text, a pointer, or a tuple of them, not a float, which nan makes unequal to itself
task firstKey<K, V>(m: [K: V]@r) -> int
    <- m.len
fi

task main()
    region r
    show(firstKey(new [float: int]() at r))
fi
