; error: 15:12: '.this' is the value a method is called on, and 'bad' is a shared method, called on its shape or kind rather than on a value; take the value as a parameter, or make 'bad' a method of the value
; A shared method has no value it is called on, so no .this.
shape Point
    x: int

    shared new(x: int) -> Point
        <- Point { x: x }
    fi

    area() -> int
        <- .x
    fi

    shared bad() -> Point
        <- .this
    fi
fi

task main()
fi
