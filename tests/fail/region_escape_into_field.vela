; error: 12:23: expected type maybe ^Node@a, got ^Node@b; a value can't move to another region: a pointer into one region is never stored in another
shape Node
    value: int
    next: maybe ^Node
fi
task main()
    region a
    bind first = new Node(Node { value: 1, next: none }) at a
    when true
        region b
        bind second = new Node(Node { value: 2, next: none }) at b
        first^.next = second
    fi
fi
