; error: 6:3: task 'cubes' is a (@r, @s, int) -> [int]@r, and wrapper 'logged' takes a (@r, @s, int) -> [int]@s first
; Wrappers whose task types differ in which region they send in: no hint about a value in no region.
task logged(next: (@a, @b, int) -> [int]@b, a: region, b: region, n: int) -> [int]@b
    <- next(a, b, n)
fi
$(logged)
task cubes(s: region, r: region, n: int) -> [int]@s
    flex made = new [int]() at s
    made.add(n)
    <- made
fi
task main()
    region outer
    region inner
    show(cubes(outer, inner, 3))
fi
