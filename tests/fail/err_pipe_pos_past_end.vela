; error: 19:16: '!>>>>' passes the failure as argument 4, but the call writes only 1, so argument 2 would be missing; write the arguments before it, or fewer '>'
kind ErrA
    A
fi

kind ErrB
    B
fi

task risky() -> int ~ ErrA
    <- fail ErrA.A
fi

task wrap(tag: text, e: ErrA) -> ErrB
    <- ErrB.B
fi

task caller() -> int ~ ErrB
    <- risky() !>>>> wrap("x")
fi

task main()
    show(caller() { 0 })
fi
