shape Point
    x: int
fi
kind Held
    Pair(p: Point)
    Empty
fi
kind Bad
    Read(n: int ~ ParseError)
fi
task make() -> Point
    <- Point { x: 1 }
fi
task main()
    region r
    flex p = Point { x: 1 }
    fixed xs = [1, 2]
    fixed h: Held = Held.Empty
    fixed e = int("1")
    show(&p ~= &p)
fi
