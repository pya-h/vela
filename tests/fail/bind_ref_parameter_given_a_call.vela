; error: 30:16: task 'look' reads 'p' where the caller keeps it, so it takes a place: a variable, a field or an item of one, or what a pointer points to, and this is a value made here
shape Point
    x: int

    alters grow(bind& by: Point)
        .x = .x + by.x
    fi
fi

task look(bind& p: Point) -> int
    <- p.x
fi

task both(bind& a: Point, hold& b: Point)
    b.x = a.x
fi

task keep(bind p: Point) -> int
    <- p.x
fi

task make() -> Point
    <- Point { x: 1 }
fi

task main()
    region r
    hold p = Point { x: 1 }
    hold s = new [Point]([p]) at r
    show(look(&make()))
fi
