shape Bag
    items: [int]
fi

task poke(flex xs: [int]@r, flex m: [text: int]@r, r: region)
    xs[0] = 9
    m["b"] = 2
fi

task main()
    region r default
    fixed xs = [1, 2, ...]
    flex ys = xs
    ys[0] = 9
    fixed a = Bag { items: [5, 6, ...] }
    flex c = a
    c.items[0] = 50
    fixed m = ["a": 1]
    poke(xs, m, r)
fi
