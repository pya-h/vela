; error: 14:12: method 'area' is already defined at 10:5
; A shared method and a method of one shape share one namespace.
shape Point
    x: int

    shared new(x: int) -> Point
        <- Point { x: x }
    fi

    area() -> int
        <- .x
    fi

    shared area() -> int
        <- 1
    fi
fi

task main()
fi
