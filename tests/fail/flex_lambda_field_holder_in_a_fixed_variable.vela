; error: 22:11: 'c' is a 'Counter@r', holding a '[flex @r]' lambda, which changes what it keeps, so it is held in a 'flex' variable: 'flex c = …'
; A shape holding a '[flex @this]' lambda is held in a 'flex' variable.
shape Counter
    n: int
    next: [flex @this]() -> int

    peek() -> int
        <- .n
    fi
fi

task counter(start: int, r: region) -> Counter@r
    flex k = start
    <- Counter { n: start, next: [flex @r]() -> int
        k = k + 1
        <- k
    fi }
fi

task main()
    region r
    fixed c = counter(1, r)
    show(c.peek())
fi
