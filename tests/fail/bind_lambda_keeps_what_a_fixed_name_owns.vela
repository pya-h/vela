; A '[bind @r]' lambda changes the contents of its copies, and a copy of a
; slice shares its items, so it can't keep a copy of a fixed one.

task main()
    region r
    fixed xs = [1, 2, ...] at r
    fixed f = [bind @r]() -> nothing
        xs[0] = 9
    fi
    f()
    show(xs)
fi
