; error: 3:6: task 'f' can finish without setting 'total'
; A break inside a loop giving a value stops the endless loop around it.
task f() -> total: int
    outer => endless
        fixed r = each k in 0..3
            when k == 1
                break outer
            fi
        finally
            0
        fi
        show(r { 0 })
    fi
fi
task main()
    show(f())
fi
