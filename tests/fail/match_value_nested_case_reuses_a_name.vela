; error: 12:17: 'other' is already defined at 10:13
kind Reading
    Ok(value: int)
    Missing
fi

task main()
    fixed value = 3
    fixed chosen = match Ok(value)
    case Ok other
        match Ok(other)
        case Ok other
            other
        case Missing
            0
        fi
    case Missing
        0
    fi
    show(chosen)
fi
