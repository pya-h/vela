; Calling a [hold @r] lambda changes what it keeps, so it is called through a place that changes.
task main()
    region r
    hold c = 0
    hold tick = [hold @r]() -> int
        c = c + 1
        <- c
    fi
    region s
    bind f = [bind& tick, @s]() -> int <- tick() fi
    show(f())
fi
