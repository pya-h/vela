; error: 14:5: a shared method is called on its shape or kind, with no value it could change, so it is never 'alters'
; 'alters' before 'shared' is refused the same way.
shape Point
    x: int

    shared new(x: int) -> Point
        <- Point { x: x }
    fi

    area() -> int
        <- .x
    fi

    alters shared bad()
    fi
fi

task main()
fi
