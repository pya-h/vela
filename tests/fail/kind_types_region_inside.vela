; error: 10:26: a type given lives in the region of the value holding it, so it names no region; write 'Option<text>@r'
; The types a kind is given take the region of the whole, which names it.
kind Option<T>
    Some(value: T)
    None
fi

task main()
    region r
    fixed o: Option<text@r> = Option.Some("x")
    show(o)
fi
