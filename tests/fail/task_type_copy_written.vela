; error: 16:15: a task's type takes a value as its type alone, '(int) -> nothing', whether the task copies it or not; 'hold&', with '&' against 'hold', is the caller's place
; A task type takes a copy as a value, written as its type alone.
task bump(flex& n: int)
    n = n + 1
fi

task both(flex& a: int, fixed& b: int)
    a = b
fi

task squares(r: region, n: int) -> [int]@r
    <- new [int]() at r
fi

task main()
    fixed f: (flex int) -> nothing = bump
fi
