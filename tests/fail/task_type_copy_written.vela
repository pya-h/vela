; error: 16:14: a task's type takes a value as its type alone, '(int) -> nothing', whether the task copies it or not; 'hold&', with '&' against 'hold', is the caller's place
; A task type takes a copy as a value, written as its type alone.
task bump(hold& n: int)
    n = n + 1
fi

task both(hold& a: int, bind& b: int)
    a = b
fi

task squares(r: region, n: int) -> [int]@r
    <- new [int]() at r
fi

task main()
    bind f: (hold int) -> nothing = bump
fi
