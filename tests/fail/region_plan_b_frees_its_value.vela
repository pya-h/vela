# error: 14:9: this value is in region 'local', which is freed when the plan B ends, so it can't be the plan B's value
shape Node
    value: int
    next: maybe ^Node
fi

task first(list: maybe ^Node@r) -> maybe ^Node@r
    <- list
fi

task main()
    bind p = first(none) {
        region local
        new Node(Node { value: 5, next: none }) in local
    }
    show(p^.value)
fi
