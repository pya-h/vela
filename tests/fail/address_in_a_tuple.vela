shape Point
    x: int
    alters bump()
        .x = .x + 1
    fi
fi
kind Mood
    Calm
fi
task made() -> int
    <- 1
fi
task main()
    region r
    hold p = Point { x: 1 }
    bind n = 1
    bind t = "abc"
    bind ptr = new int(1) at r
    bind m: maybe ^int@r = ptr
    show((&n, 1))
fi
