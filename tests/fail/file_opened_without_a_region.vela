# error: 6:11: method 'File.open' takes the region it makes memory in last, as 'within'; name it after the call, as in '… at r' or '…@r', or in the parentheses
include std/files {File, FileMode}

task main()
    hold notes = File { path: "notes.txt" }
    notes.open(FileMode.Read) { failure e
        show("could not open")
    }
fi
