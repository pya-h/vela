; error: 15:31: cannot send a value holding 'text@r' region memory as message argument 's'; the actor can outlive the sender's region
actor Logger
    last: text = "none"

    on Add(s: text)
        last = s
    fi
fi

task main()
    fixed a = spawn Logger()
    loop 1 == 1
        region r
        fixed msg = "hello".str(r)
        a.dispatch(Logger.Add(msg))
        break
    fi
fi
