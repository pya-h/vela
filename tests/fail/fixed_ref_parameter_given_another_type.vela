; error: 30:15: expected type Point, got int; 'p' is given the place itself, which the task reads where it is, so the place is of exactly its type
shape Point
    x: int

    alters grow(fixed& by: Point)
        .x = .x + by.x
    fi
fi

task look(fixed& p: Point) -> int
    <- p.x
fi

task both(fixed& a: Point, flex& b: Point)
    b.x = a.x
fi

task keep(fixed p: Point) -> int
    <- p.x
fi

task make() -> Point
    <- Point { x: 1 }
fi

task main()
    region r
    flex p = Point { x: 1 }
    flex s = new [Point]([p]) at r
    show(look(&p.x))
fi
