; error: 10:31: 'f' is a '[hold @r]' lambda, which is never copied, so a lambda can't keep it; give it as a parameter, 'hold& f'
; A lambda never keeps a [hold @r] lambda, which is never copied.
task main()
    region r
    hold n = 0
    hold f = [hold @r]() -> int
        n = n + 1
        <- n
    fi
    bind g = [@r]() -> int <- f() fi
    show(g())
fi
