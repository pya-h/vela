; error: 10:32: 'f' is a '[flex @r]' lambda, which is never copied, so a lambda can't keep a copy of it; give it as a parameter, 'flex& f', or keep it as a place, '[flex& f, @s]', in a region declared after it
; A lambda never keeps a [flex @r] lambda, which is never copied.
task main()
    region r
    flex n = 0
    flex f = [flex @r]() -> int
        n = n + 1
        <- n
    fi
    fixed g = [@r]() -> int <- f() fi
    show(g())
fi
