; error: 8:21: this value is in region 'pass', which is freed when the pass ends, so it can't be what the loop fails with
; A break's value in a region a pass declares would outlive the region.
task main()
    region outer
    fixed r = each x in 0..3
        region pass
        when x == 1
            break = ("o{x}" at outer, "p{x}" at pass)
        fi
        x
    fi
    show(r { 0 })
fi
