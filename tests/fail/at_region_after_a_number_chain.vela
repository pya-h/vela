; error: 9:27: numbers are added without a region, so 'at work' after '+' names the region of none of them; a call that takes its region last names it with '@' right after it, as in 'f(x)@work'
task count(xs: [int]@q, work: region) -> int
    <- xs.len
fi

task main()
    region work
    bind xs = new [int]([1, 2]) at work
    show(1 + count(xs) at work)
fi
