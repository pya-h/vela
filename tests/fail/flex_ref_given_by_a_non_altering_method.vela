; error: 6:18: giving '.n' to 'x' changes the value this method is called on, so 'alters' goes before its name, as in 'alters peek(…)'
shape Counter
    n: int = 0

    peek() -> int
        sample(&.n)
        <- .n
    fi
fi

task sample(flex& x: int)
    x = 10
fi

task main()
    fixed c = Counter {}
    show(c.peek())
fi
