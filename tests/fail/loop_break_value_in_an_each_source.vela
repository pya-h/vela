; error: 7:21: this loop gives no value, so its 'break' gives none; a loop gives one where it is a value, as in 'bind r = loop … fi'
; A loop in what an each goes through runs before the each.
task main()
    fixed c = true
    fixed r = each x in (when c
        each z in 0..2
            break = 5
        fi
        [1, 2]
    else
        [3, 4]
    fi)
        x
    fi
    show(r { 0 })
fi
