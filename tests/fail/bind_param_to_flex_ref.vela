; error: 10:13: 'xs' is given the place itself, to change, so it needs a place that can be assigned as a whole, and 'xs' is a 'bind' name, which stays bound to one value; a 'bind&' takes it to change only its contents

task change(flex& xs: [int]@r)
    xs[0] = 9
fi

task main()
    region r
    bind xs = [1, 2, ...] at r
    change(&xs)
fi
