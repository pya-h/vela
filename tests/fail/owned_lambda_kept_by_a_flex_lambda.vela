; A '[flex @r]' lambda's copies may change, so it can't keep a lambda that sends
; back what a fixed name owns.

task main()
    region r
    fixed xs = [1, 2, ...] at r
    fixed g = [@r]() -> [int]@r <- xs fi
    flex k = [flex @r]() -> int
