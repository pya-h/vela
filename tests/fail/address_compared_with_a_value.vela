; error: 21:16: an address is compared with another place's address or with a pointer, but this value is int; to compare where two places are, mark both, as in '&a == &b'
shape Point
    x: int
    alters bump()
        .x = .x + 1
    fi
fi
kind Mood
    Calm
fi
task made() -> int
    <- 1
fi
task main()
    region r
    flex p = Point { x: 1 }
    fixed n = 1
    fixed t = "abc"
    fixed ptr = new int(1) at r
    fixed m: maybe ^int@r = ptr
    show(&n == 1)
fi
