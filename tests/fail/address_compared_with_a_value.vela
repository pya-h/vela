; error: 21:16: an address is compared with another place's address or with a pointer, but this value is int; to compare where two places are, mark both, as in '&a == &b'
shape Point
    x: int
    alters bump()
        .x = .x + 1
    fi
fi
kind Mood
    Calm
fi
task made() -> int
    <- 1
fi
task main()
    region r
    hold p = Point { x: 1 }
    bind n = 1
    bind t = "abc"
    bind ptr = new int(1) at r
    bind m: maybe ^int@r = ptr
    show(&n == 1)
fi
