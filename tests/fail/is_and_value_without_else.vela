; error: 11:14: a 'when' used as a value needs an 'else': without one, nothing gives the value when the condition doesn't hold
task half(n: int) -> maybe int
    when n % 2 == 0
        <- n / 2
    fi
    <- none
fi
task main()
    bind m = half(4)
    bind n = half(6)
    bind v = when m is {x} and x > 0 x fi
    show(v)
fi
