; error: 18:12: 'k' is a variable, not a region
; A region a task value takes is a region the caller allocates in.
task bump(flex& n: int)
    n = n + 1
fi

task both(flex& a: int, fixed& b: int)
    a = b
fi

task squares(r: region, n: int) -> [int]@r
    <- new [int]() at r
fi

task main()
    fixed g = squares
    fixed k = 3
    show(g(k, 3))
fi
