; error: 12:15: 'b.items' changes, so it can't be given what fixed 'xs' owns: nothing changes through what a fixed name owns; give it a copy: 'xs.copy() at r'
; A field that changes may not take it.

shape Bag
    items: [int]
fi

task main()
    region r default
    fixed xs = [1, ...]
    flex b = Bag { items: [2, ...] }
    b.items = xs
fi
