; error: 18:14: task 'dup' takes 'T' as a type, and is given a '[flex @r]' lambda for it, which changes what it keeps and is never copied, as its body may copy a value of that type; give it a '[@r]' lambda, or a task taking the lambda as 'flex& f: [flex @r]() -> int'
; A task taking types is given no [flex @r] lambda, which its body might copy.
task dup<T>(flex& x: T) -> T
    <- x
fi

task counter(r: region) -> [flex @r]() -> int
    flex n = 0
    <- [flex @r]() -> int
        n = n + 1
        <- n
    fi
fi

task main()
    region r
    flex g = counter(r)
    flex h = dup(&g)
    show(g(), " ", h(), " ", g())
fi
