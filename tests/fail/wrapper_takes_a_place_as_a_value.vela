; error: 19:3: task 'put' takes 'flex& n: int', and wrapper 'logged' takes 'n: int' in its place
; A wrapper takes the task's values as the task does, a place as a place.
task bump(flex& n: int)
    n = n + 1
fi

task both(flex& a: int, fixed& b: int)
    a = b
fi

task squares(r: region, n: int) -> [int]@r
    <- new [int]() at r
fi

task logged(next: (flex& int) -> int, n: int) -> int
    <- 0
fi

$(logged)
task put(flex& n: int) -> int
    <- n
fi

task main()
fi
