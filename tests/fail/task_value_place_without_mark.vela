; error: 18:7: task 'f' changes 'value 1', the place it is given, so the call marks that place with '&', as in '&c'
; A call of a task value marks a place it gives, as a named call does.
task bump(flex& n: int)
    n = n + 1
fi

task both(flex& a: int, fixed& b: int)
    a = b
fi

task squares(r: region, n: int) -> [int]@r
    <- new [int]() at r
fi

task main()
    flex c = 1
    fixed f = bump
    f(c)
fi
