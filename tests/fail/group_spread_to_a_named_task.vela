; error: 12:20: a group's values go on whole to a task value taking the group, as in 'next(args...)'; giving them to task 'call' is not built yet
; A group's values go to a task value, not yet to a named task.
task call<P..., R>(f: (P...) -> R, args: P...) -> R
    <- f(args...)
fi

task add(a: int, b: int) -> int
    <- a + b
fi

task g<P..., R>(h: (P...) -> R, args: P...) -> R
    <- call(h, args...)
fi
