; error: 7:33: '.x' names a member of the value a method is called on, and a lambda takes nothing from the method around it; give the value as a parameter
; A lambda written in a method has no value it is called on.
shape P
    x: int

    get() -> int
        fixed f = () -> int <- .x fi
        <- f()
    fi
fi

task main()
    show(P { x: 1 }.get())
fi
