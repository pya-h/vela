; error: 6:21: 'total' is a result of this task, which only '<-' sets, so a lambda doesn't keep it as a place
; A result of the task is set only by '<-'.
task make(r: region) -> total: int
    total <- 1
    region s
    bind f = [hold& total, @s]() -> nothing total <- 2 fi
fi
task main()
    region r
    show(make(r))
fi
