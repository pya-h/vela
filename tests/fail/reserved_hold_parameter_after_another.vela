; error: 4:27: 'hold' is a reserved word with no use yet; a variable that changes is written 'flex'
; The error is at the old word, wherever in the header it is.

task countdown(step: int, hold n: int) -> int
    loop n > 0
        n = n - step
    fi
    <- n
fi

task main()
    show(countdown(1, 3))
fi
