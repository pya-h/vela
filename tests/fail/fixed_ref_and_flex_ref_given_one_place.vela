; error: 30:14: 'p' is given as 'a' too, and the call changes it through 'b'; a place the call changes is given once, so keep a copy of it in a variable first, and give that as the other
shape Point
    x: int

    alters grow(fixed& by: Point)
        .x = .x + by.x
    fi
fi

task look(fixed& p: Point) -> int
    <- p.x
fi

task both(fixed& a: Point, flex& b: Point)
    b.x = a.x
fi

task keep(fixed p: Point) -> int
    <- p.x
fi

task make() -> Point
    <- Point { x: 1 }
fi

task main()
    region r
    flex p = Point { x: 1 }
    flex s = new [Point]([p]) at r
    both(&p, &p)
fi
