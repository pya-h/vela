; error: 8:15: 'TakeIter.next' changes the value it is called on, so it needs a place that can change, and 'it' never does (declared at 7:11); a value declared with 'flex' can
include std/collections

task main()
    region r
    flex nums: [int]@r = new [int]([1, 2, 3]) at r
    fixed it = nums.take(2)
    each n in it
        show(n)
    fi
fi
