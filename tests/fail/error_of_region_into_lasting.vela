# error: 10:13: expected an error of type Problem, got Problem@r; this value holds text in region 'r', and a 'Problem' here holds text that lasts as long as the program; to keep text of a region, name it, as in 'Problem@r'
kind Problem
    Bad(line: text)
fi

task main()
    region r
    hold outer: int or Problem = 0
    bind line = scan("") at r { "" }
    outer = fail Bad(line)
    show(1)
fi
