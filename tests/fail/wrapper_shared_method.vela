; error: 9:8: a wrapper is a task, named alone or with its module, as in '$(timed)' or '$(m.timed)'; a shared method or field of a shape or kind can't be one yet
; A shared method can't be a wrapper yet.
shape Timer
    shared timed(next: (int) -> int, n: int) -> int
        <- next(n)
    fi
fi

$(Timer.timed)
task one(x: int) -> int
    <- x
fi

task main()
fi
