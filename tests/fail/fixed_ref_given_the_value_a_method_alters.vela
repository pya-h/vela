; error: 30:12: 'p' is given as the value it is called on too, and the method changes the value it is called on while it reads it through 'by'; a place the call changes is given once, so keep a copy of it in a variable first, and give that as the other
shape Point
    x: int

    alters grow(fixed& by: Point)
        .x = .x + by.x
    fi
fi

task look(fixed& p: Point) -> int
    <- p.x
fi

task both(fixed& a: Point, flex& b: Point)
    b.x = a.x
fi

task keep(fixed p: Point) -> int
    <- p.x
fi

task make() -> Point
    <- Point { x: 1 }
fi

task main()
    region r
    flex p = Point { x: 1 }
    flex s = new [Point]([p]) at r
    p.grow(&p)
fi
