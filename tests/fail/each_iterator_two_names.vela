; error: 8:13: 'each i, n' names a key and its value, which only a map gives; an iterator gives one item at a time, so name one
include std/collections

task main()
    region r
    flex nums: [int]@r = new [int]([1, 2, 3]) at r
    flex it = nums.take(2)
    each i, n in it
        show(n)
    fi
fi
