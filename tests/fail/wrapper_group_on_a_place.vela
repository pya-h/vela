; error: 19:3: wrapper 'traced' takes the task's values in a group, and a group's values are given as values, so it can't take 'n', which task 'put' takes as a place or a region; a wrapper written for the task's own parameters can
; A group gives its values as values, so a wrapper taking one fits no task taking a place.
task bump(hold& n: int)
    n = n + 1
fi

task both(hold& a: int, bind& b: int)
    a = b
fi

task squares(r: region, n: int) -> [int]@r
    <- new [int]() at r
fi

task traced<P..., R>(next: (P...) -> R, args: P...) -> R
    <- next(args...)
fi

$(traced)
task put(hold& n: int) -> int
    <- n
fi

task main()
fi
