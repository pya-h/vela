; error: 12:30: 'both' is given what fixed 'a' owns, and nothing changes through what a fixed name owns; give it a copy: 'a.copy() at r'
; An array of a fixed name's pointers too.

shape Node
    v: int
    next: maybe ^Node
fi

task main()
    region r default
    fixed a = new Node(Node { v: 1, next: none })
    flex both: [^Node@r#2] = [a, a]
fi
