; error: 30:15: task 'look' reads 'p' where the caller keeps it, so it takes a place marked with '&', as in '&a', and this is a value made here; a parameter written 'p: …' takes a copy
shape Point
    x: int

    alters grow(fixed& by: Point)
        .x = .x + by.x
    fi
fi

task look(fixed& p: Point) -> int
    <- p.x
fi

task both(fixed& a: Point, flex& b: Point)
    b.x = a.x
fi

task keep(fixed p: Point) -> int
    <- p.x
fi

task make() -> Point
    <- Point { x: 1 }
fi

task main()
    region r
    flex p = Point { x: 1 }
    flex s = new [Point]([p]) at r
    show(look(Point { x: 2 }))
fi
