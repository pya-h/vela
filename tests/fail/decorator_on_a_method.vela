; error: 11:5: a decorator in a shape goes on the lines above a shared method, as in '$register' above 'shared new(…)'; this is a method of every value, which has no value to be called on where the program starts
; A method of every value takes no decorator: it has no value to be called on
; where the program starts.
task reg(f: (int) -> int)
    show(f(1))
fi

shape P
    x: int

    $reg
    get() -> int
        <- .x
    fi
fi

task main()
fi
