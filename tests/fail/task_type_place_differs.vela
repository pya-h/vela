; error: 16:40: expected type (fixed& int) -> nothing, got (flex& int) -> nothing
; A task type says how each parameter is given, and a place changed is not a place read.
task bump(flex& n: int)
    n = n + 1
fi

task both(flex& a: int, fixed& b: int)
    a = b
fi

task squares(r: region, n: int) -> [int]@r
    <- new [int]() at r
fi

task main()
    fixed f: (fixed& int) -> nothing = bump
fi
