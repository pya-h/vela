; error: 8:3: task 'put' is a (flex& int) -> int, and wrapper 'logged' takes a (int) -> int first
; A wrapper takes the rest of the chain as the task takes its values: a place as a place.
task logged(next: (int) -> int, label: text, n: int) -> int
    show(label)
    <- next(n)
fi

$(logged("a"))
task put(flex& n: int) -> int
    n = 1
    <- n
fi

task main()
fi
