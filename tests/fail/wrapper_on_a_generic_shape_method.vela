; error: 10:7: 'get' is a method of 'Box', which takes types, so it can't have wrappers yet: each wrapper is given it as a value, and only a task that takes none can be one
; A method of a shape that takes types takes no wrappers yet.
task plain<P..., R>(next: (P...) -> R, args: P...) -> R
    <- next(args...)
fi

shape Box<T>
    v: T

    $(plain)
    get() -> T
        <- .v
    fi
fi

task main()
fi
