; error: 13:11: wrapper 'counted' takes this as a place, with 'flex&', but a wrapper's own values are worked out once, where the program starts, so none is a place; take it as a value, or name the place inside the wrapper
; A wrapper's own value is worked out once, where the program starts, so it
; is no place a 'flex&' parameter changes.
shape Stats
    shared flex calls: int = 0
fi

task counted(next: (int) -> int, flex& c: int, n: int) -> int
    c = c + 1
    <- next(n)
fi

$(counted(&Stats.calls))
task sq(n: int) -> int
    <- n * n
fi

task main()
    show(sq(2))
    show(Stats.calls)
fi
