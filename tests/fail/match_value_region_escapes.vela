; error: 16:9: this value is in region 'inner', which is freed when the case ends, so it can't be the match's value
shape Note
    title: text
fi

kind Which
    First
    Second
fi

task main()
    fixed w = First
    fixed escaped = match w
    case _
        region inner
        new Note(Note { title: "x" }) at inner
    fi
    show(escaped^.title)
fi
