; error: 11:5: cannot assign to immutable variable 'p'; 'p' is a 'fixed&' parameter, which only reads the caller's place, and one that changes it is written 'flex& p: Point'
shape Point
    x: int

    alters grow(fixed& by: Point)
        .x = .x + by.x
    fi
fi

task f(fixed& p: Point)
    p = Point { x: 2 }
fi
