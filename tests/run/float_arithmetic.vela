; Float literals, arithmetic in floats, and float remainder. An int doesn't
; become a float on its own, so every int taking part is written 'float(n)'.

shape Vec1
    x: float
fi

task half(n: int) -> float
    <- float(n) / 2.0
fi

task main()
    show(3.0 / 2.0)
    show(float(1) + 2.5)
    bind x = float(1) + 2.5
    show(x)
    bind y = float(7) / 2.0
    show(y)
    show(7 / 2)
    show(5.5 % 2.0)
    show(float(7) % 2.5)
    show(-7.5 % 2.0)
    show(7 % 3)
    show(0.1 + 0.2)
    show(1000000000000000000000.0)
    show(-2.5 * float(2))

    hold f = 0.0
    f = f + float(1)
    show(f)

    bind v = Vec1 { x: 2.0 }
    show(v.x * float(2))
    show(half(3))
fi
