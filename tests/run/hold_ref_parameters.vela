; A parameter written `flex& x: T` is the caller's place: every change the task
; makes to `x` is a change there. The call marks the place it gives with `&`,
; so a reader sees at the call what may change.

include hold_ref_parameters/tally {Tally, double}

shape Counter
    n: int = 0

    alters tick()
        .n = .n + 1
    fi

    ; A method takes one too, and gives its own fields.
    alters add_to(flex& total: int)
        total = total + .n
        double(&.n)
    fi
fi

task sample(flex& x: int)
    x = 10
fi

task swap(flex& a: int, flex& b: int)
    a, b = b, a
fi

; A shape: its fields change, its alters methods are called, and a field of it
; is given on to another task.
task bump(flex& c: Counter)
    c.tick()
    c.n = c.n + 5
    sample(&c.n)
    c.n = c.n + 1
fi

; A slice grows where the caller keeps it.
task push_two(flex& xs: [int]@r, r: region)
    xs.add(1)
    xs.add(2)
fi

; A generic task, and a recursive one, which passes its own place on.
task put<T>(flex& place: T, value: T)
    place = value
fi

task count_down(flex& n: int, flex& steps: int)
    when n > 0
        n = n - 1
        steps = steps + 1
        count_down(&n, &steps)
    fi
fi

; Text whose region the call settles, and a tuple given a new value.
task rename(flex& t: text@p, to: text@p)
    t = to
fi

task widen(flex& ends: (int, int))
    ends = (ends.0 - 1, ends.1 + 1)
fi

task main()
    flex a = 1
    sample(&a)
    show(a)
    flex b = 2
    swap(&a, &b)
    show(a, " ", b)

    flex c = Counter {}
    bump(&c)
    show(c.n)
    flex total = 100
    c.add_to(&total)
    show(total, " ", c.n)

    ; Two different fields, and two different items of an array.
    flex pair = Counter { n: 3 }
    flex other = Counter { n: 4 }
    swap(&pair.n, &other.n)
    flex arr = [1, 2, 3]
    swap(&arr[0], &arr[2])
    show(pair.n, " ", other.n, " ", arr[0], arr[1], arr[2])

    region r
    flex xs = new [int]() at r
    push_two(&xs, r)
    show(xs.len)
    flex p = new Counter(Counter {}) at r
    bump(&p^)
    swap(&p^.n, &a)
    show(p^.n, " ", a)

    flex word = "x"
    put(&word, "y")
    put(&a, 5)
    flex steps = 0
    count_down(&a, &steps)
    show(word, " ", a, " ", steps)
    rename(&word, "lasting")
    flex made = "made" + "!" at r
    rename(&made, "again" + "?" at r)
    show(word, " ", made)
    flex ends = (1, 2)
    widen(&ends)
    show(ends.0, " ", ends.1)

    flex tally = Tally { count: 7 }
    flex sum = 1
    tally.add_into(&sum)
    double(&sum)
    show(sum, " ", tally.count)
fi
