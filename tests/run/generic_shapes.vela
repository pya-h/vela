; Shapes that take types: `shape Box<T>` is checked once, with `T` standing for
; the type each value of it is given, and one shape is made for each set of types
; the program uses it with. The types given name no region, as a shape's fields
; don't: they are in the region of the value holding them, which the whole type
; names (`Box<text>@r`). A literal names its types (`Box<int> { value: none }`)
; or the values it gives say which they are (`Box { value: 1 }`).

shape Box<T>
    value: T
fi

shape Pair<A: frozen, B: frozen>
    left: A
    right: B
fi

; A shape that takes types can hold anything a field can: text, a slice, a
; pointer, a tuple, another shape given types.
shape Holder<T>
    items: [T]
    label: text
fi

; A field may name the shape again, with the types it takes, behind a pointer.
shape Node<T>
    value: T
    next: maybe ^Node<T>
fi

; A word says what every type given for it must allow, as for a task.
shape Shown<T: shown>
    value: T
fi

task tell<T: shown>(b: Shown<T>@r)
    show(b.value)
fi

; A task that takes types can take and make values of a shape given them: the
; region comes from the header, as for any value holding text or pointers.
task boxOf<T>(r: region, v: T) -> Box<T>@r
    <- Box { value: v }
fi

task valueOf<T>(b: Box<T>@r) -> T
    <- b.value
fi

task firstOf<T>(boxes: [Box<T>]@r) -> maybe T
    each b in boxes
        <- b.value
    fi
    <- none
fi

; One region name for two shapes given different types: the one made for a type
; that holds nothing in a region names none, and the region is dropped for it.
task swap<A: frozen, B: frozen>(a: Box<A>@r, b: Box<B>@r) -> (Box<B>@r, Box<A>@r)
    <- (b, a)
fi

; A shape made for its types is one type with the shape given them, so a header
; that takes no types may name it as it is written, and its region is the one the
; values live in.
task textOf(b: Box<text>@r) -> text@r
    <- b.value
fi

; A shape given types may be given to another, with one region for the whole.
task leftText(p: Pair<Box<text>, int>@r) -> text@r
    <- p.left.value
fi

kind Holding
    Nothing
    Number(box: Box<int>)
fi

task main()
    region r

    ; The types are written, or the values say which they are.
    bind written: Box<int> = Box<int> { value: 1 }
    show(written.value)
    bind worked = Box { value: 2.5 }
    show(worked.value)
    bind empty: Box<maybe int> = Box<maybe int> { value: none }
    show(empty.value)

    ; The shape made for one set of types serves every region: the text of a
    ; `Box<text>` is in the region of the box.
    bind here: Box<text>@r = Box { value: "in a region".copy() at r }
    show(here.value)
    bind lasting: Box<text> = Box { value: "as long as the program" }
    show(lasting.value)

    ; Two types at once, with the words they must allow.
    bind pair: Pair<int, text> = Pair { left: 3, right: "three" }
    show(pair.left)
    show(pair.right)

    ; A shape given types holds what any field holds.
    hold items = new [int]() at r
    items.add(4)
    items.add(5)
    bind holder: Holder<int>@r = Holder { items: items, label: "counts" }
    show(holder.label)
    show(holder.items[1])
    bind nested = Box { value: Box { value: 6 } }
    show(nested.value.value)
    bind tuple: Box<(int, bool)> = Box { value: (7, true) }
    show(tuple.value.0)

    ; A field naming the shape again, behind a pointer.
    bind tail: ^Node<int>@r = new Node<int>(Node { value: 9, next: none }) at r
    bind head: ^Node<int>@r = new Node<int>(Node { value: 8, next: tail }) at r
    show(head^.value)
    when head^.next is {second}
        show(second^.value)
    fi

    ; Tasks that take types, with values of shapes given types.
    tell(Shown { value: "shown" })
    tell(Shown { value: 10 })
    bind made = boxOf(r, 11)
    show(made.value)
    bind text_box = boxOf(r, "boxed".copy() at r)
    show(text_box.value)
    show(valueOf(made))
    bind boxes: [Box<int>]@r = new [Box<int>]([Box { value: 12 }, Box { value: 13 }]) at r
    show(firstOf(boxes))
    each b in boxes
        show(b.value)
    fi

    bind swapped = swap(written, here)
    show(swapped.0.value)
    show(swapped.1.value)

    ; A header that takes no types naming a shape made for its types, and a
    ; shape given types given to another.
    show(textOf(here))
    bind deep: Box<Box<text>>@r = Box { value: Box { value: "two boxes deep".copy() at r } }
    show(deep.value.value)
    bind paired: Pair<Box<text>, int>@r = Pair { left: Box { value: "on the left".copy() at r }, right: 16 }
    show(leftText(paired))
    show(paired.right)

    ; A kind's payload, a `maybe`, and a copy into another region.
    bind holding = Holding.Number(Box { value: 14 })
    match holding
        case Nothing
            show(0)
        case Number box
            show(box.value)
    fi
    bind maybe_box: maybe Box<int> = Box { value: 15 }
    when maybe_box is {inner}
        show(inner.value)
    fi
    region other
    bind copied: Box<text>@other = here.copy() at other
    show(copied.value)
fi
