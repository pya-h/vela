; warning: 17:8: 'xs' is the task's own copy of the caller's slice, and an 'add' leaves its items shared with the caller's only when it finds room in place; when it needs more room it copies them to a block of its own, so what the task writes afterwards may or may not be seen by the caller; to change the caller's slice, take the caller's place, 'flex& xs: [int]@r', or work on a copy of its own, 'xs.copy() at r'
; warning: 19:8: 'xs' is the task's own copy of the caller's slice, and a 'del' moves the items after the one taken out in the memory the caller's slice shares, so the caller's slice sees them moved, though its length stays as it was; to change the caller's slice, take the caller's place, 'flex& xs: [int]@r', or work on a copy of its own, 'xs.copy() at r'
; warning: 26:11: 'xs' is the task's own copy of the caller's slice, and a 'del' gives the last item's space back to the room the caller's slice may share, so a later 'add' may go over an item the caller still counts, though its length stays as it was; to change the caller's slice, take the caller's place, 'flex& xs: [int]@r', or work on a copy of its own, 'xs.copy() at r'
; warning: 36:5: this writes an item of 'xs' after 'ys.add(…)' at 35:8; 'xs' and 'ys' were made of one slice and share items only while an add finds room in place, so the write may or may not be seen through 'ys'; use the slice you changed, or give the copy items of its own, as in 'flex ys = xs.copy() at r'
; warning: 49:12: this uses 'part' after 'zs.del(…)' at 47:8; 'part' and 'zs' were made of one slice and share its items, and 'del' moves the items after the one taken out in that shared memory, so 'part' sees them moved; use the slice you changed, or give the copy items of its own, as in 'flex ys = xs.copy() at r'
; warning: 58:5: this writes an item of 'xs' after 'xs.add(…)' at 57:8; a copy or part of 'xs' made earlier shares its items only while an add finds room in place, so the write may or may not be seen through it; use the slice you changed, or give the copy items of its own, as in 'flex ys = xs.copy() at r'
; warning: 69:8: this uses 'ws' after 'vs.del(…)' at 68:8; 'ws' and 'vs' were made of one slice and share its items, and 'del' moves the items after the one taken out in that shared memory, so 'ws' sees them moved; use the slice you changed, or give the copy items of its own, as in 'flex ys = xs.copy() at r'
; A copy or a part of a slice shares its items with it only while an add finds
; room in place, and a del moves the items they share, so what is done to one
; may or may not show in the other. The compiler warns where a program leans on
; that, once in each task for each case; the second of each, marked below, is
; held back (`--repeat-warnings` shows it).

; The task's own copy of the caller's slice: the first add and the first del
; are warned of, not the second of either.
task trim(flex xs: [int]@r, r: region) -> int
    xs.add(1)
    xs.add(2)                   ; held back
    xs.del(0)
    xs.del(0)                   ; held back
    <- xs.len
fi

; A last item taken out moves no item, but gives its room back.
task pop(flex xs: [int]@r) -> int
    <- xs.del()
fi

; A copy, written after an add on the slice it was made of, and through the
; slice that was added to.
task add_then_write() -> int
    region r default
    flex xs = [1, 2, 3, ...]
    flex ys = xs
    ys.add(4)
    xs[0] = 9
    ys[1] = 8                   ; held back
    <- xs.len + ys.len
fi

; A part, used after a del on the slice it is a part of; its length alone is
; no use.
task del_then_use() -> int
    region r default
    flex zs = [1, 2, 3, 4, ...]
    fixed part = zs[1..3]
    zs.del(0)
    fixed n = part.len
    <- n + part[0] + part[1]    ; warned once, at the first read
fi

; A fixed copy counts too, and the write is through the slice that was added to.
task fixed_copy() -> int
    region r default
    flex xs = [1, 2, ...]
    fixed view = xs
    xs.add(3)
    xs[0] = 7
    <- view.len
fi

; A copy made by an assignment.
task assigned() -> int
    region r default
    flex ws = [1, 2, 3, ...]
    flex vs = [5, ...]
    vs = ws
    vs.del(1)
    <- ws[0]
fi

task main()
    region r default
    flex nums = [1, 2, 3, ...]
    show(trim(nums, r))
    show(pop(nums))
    show(add_then_write())
    show(del_then_use())
    show(fixed_copy())
    show(assigned())
fi
