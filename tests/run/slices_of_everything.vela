; Slices of shapes with fields written through them, a slice of an array held
; in a slice (sharing its items), and a slice of slices.

shape Point
    x: int
    y: int
fi

task main()
    region r
    fixed pts = new@r [Point]([Point { x: 0, y: 0 }#3])
    pts[1].x = 5
    each p in pts
        show(p.x)
    fi
    fixed rows = new [[int#4]]([[1, 2, 3, 4]#2]) at r
    fixed part = rows[1][1..3]
    part[0] = 20
    show(rows[1][1])
    show(rows[0][1])
    fixed row = new [int]([0#3]) at r
    fixed table = new [[int]]([row#2]) at r
    table[0][2] = 8
    show(table[1][2])
    show(table.len * table[0].len)
fi
