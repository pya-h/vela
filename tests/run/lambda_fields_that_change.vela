; Fields holding lambdas that change things. A '[bind @this]' lambda changes only
; what every copy of it shares, so the value holding it is copied as any other. A
; '[flex @this]' lambda changes its own copies, so the value holding it is held as
; such a lambda is: in a 'flex' variable, given as a place, never copied.

shape Tally
    put: [bind @this](int) -> nothing
fi

shape Counter
    start: int
    next: [flex @this]() -> int

    peek() -> int
        <- .start
    fi

    alters twice() -> int
        <- .next() + .next()
    fi
fi

shape Pair
    left: Counter
    right: int
fi

task counter(start: int, r: region) -> Counter@r
    flex n = start
    <- Counter { start: start, next: [flex @r]() -> int
        n = n + 1
        <- n
    fi }
fi

task bump(flex& c: Counter@r) -> int
    <- c.next()
fi

task look(fixed& c: Counter@r) -> int
    <- c.peek()
fi

task main()
    region r
    flex totals = [0, 0, ...] at r
    flex t: Tally@r = Tally { put: [bind @r](n: int) -> nothing
        totals[0] = totals[0] + n
    fi }
    t.put(2)
    flex other = t
    other.put(5)
    show(totals)

    flex c = counter(10, r)
    show(c.next(), " ", c.next(), " ", c.twice())
    show(bump(&c), " ", look(&c))

    flex p: Pair@r = Pair { left: counter(0, r), right: 1 }
    show(p.left.next(), " ", p.left.peek() + p.right)
    c = counter(100, r)
    show(c.next())
fi
