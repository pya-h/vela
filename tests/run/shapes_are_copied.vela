; A shape is a value: `flex b = a` and passing it to a task copy it, so
; changing the copy leaves the original as it was.

shape Point
    x: int
    y: int
fi

task moved(p: Point) -> Point
    flex q = p
    q.x = q.x + 100
    <- q
fi

task main()
    flex a = Point { x: 1, y: 2 }
    flex b = a
    b.x = 9
    show(a.x)
    show(b.x)
    fixed c = moved(a)
    show(a.x)
    show(c.x)
fi
