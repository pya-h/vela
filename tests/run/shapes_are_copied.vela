# A shape is a value: `hold b = a` and passing it to a task copy it, so
# changing the copy leaves the original as it was.

shape Point
    x: int
    y: int
fi

task moved(p: Point) -> Point
    hold q = p
    q.x = q.x + 100
    <- q
fi

task main()
    hold a = Point { x: 1, y: 2 }
    hold b = a
    b.x = 9
    show(a.x)
    show(b.x)
    bind c = moved(a)
    show(a.x)
    show(c.x)
fi
