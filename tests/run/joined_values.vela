; Where several values must have one type — the items of an array, the branches
; of a `match` or a `when` used as a value — their types are joined by one rule:
; a `maybe` or an error side is wrapped around whatever is already there, and a
; value already made is never changed inside. Parentheses group a type, so both
; nestings can be written: `maybe int ~ text` is `(maybe int) ~ text`, and
; `maybe (int ~ text)` is the other one.

task risky(n: int) -> int ~ text
    when n > 0
        <- n
    fi
    <- fail "no reading"
fi

task divide(a: int, b: int) -> (int, int)
    <- (a / b, a % b)
fi

; One type in parentheses is that type, here `int`.
task twice(x: (int)) -> int
    <- x * 2
fi

; Both nestings, written down, as a parameter and as a result.
task kept(v: maybe (int ~ text)) -> int
    fixed inner = v { <- -1 }
    <- inner { -2 }
fi

task sent(n: int) -> (maybe int) ~ text
    when n < 0
        <- fail "negative"
    fi
    when n == 0
        <- none
    fi
    <- n
fi

; The same result type, written without parentheses: `~` holds the whole type
; before it, so this is the one above, not `maybe (int ~ text)`.
task also(n: int) -> maybe int ~ text
    <- sent(n)
fi

task main()
    fixed m: maybe int = 3
    show(twice(21))

    ; An array of a value and `none`: the wrapper goes around the value.
    fixed xs = [1, none]
    show(xs[0] { -1 }, " ", xs[1] { -1 })

    ; A `maybe int` beside a failure keeps the maybe and gains an error side.
    fixed ys = [m, fail "no"]
    match ys[0]
    case {inside}
        show("ys: ", inside { -1 })
    case failure e
        show("ys failed: ", e)
    fi
    match ys[1]
    case {inside}
        show("ys: ", inside { -1 })
    case failure e
        show("ys failed: ", e)
    fi

    ; An `int ~ text` beside `none` keeps its error side and goes inside a maybe.
    fixed zs = [risky(1), none]
    show(kept(zs[0]), " ", kept(zs[1]), " ", kept(risky(-1)))

    ; The branches of a value `match` or `when` are joined by the same rule.
    fixed first = when m == none
        fail "nothing"
    else
        m
    fi
    show(first { none } { -3 })
    fixed second = when m == none
        none
    else
        risky(2)
    fi
    show(kept(second))

    ; A tuple written out is built item by item, so an item becomes what that
    ; item's type is; one already made is taken apart to build another.
    fixed pair: (int, maybe int) = (2, 3)
    fixed made = divide(17, 5)
    fixed widened: (int, maybe int) = (made.0, made.1)
    show(pair.0, " ", pair.1 { -1 }, " ", widened.0, " ", widened.1 { -1 })

    ; A task can send either nesting, and each keeps its own outcomes.
    show(sent(5) { none } { -4 }, " ", sent(0) { none } { -5 }, " ", sent(-1) { none } { -6 })
    show(also(7) { none } { -7 })
fi
