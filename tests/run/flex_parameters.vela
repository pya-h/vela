; warning: 50:8: 'xs' is the task's own copy of the caller's slice, and an 'add' leaves its items shared with the caller's only when it finds room in place; when it needs more room it copies them to a block of its own, so what the task writes afterwards may or may not be seen by the caller; to change the caller's slice, take the caller's place, 'flex& xs: [int]@r', or work on a copy of its own, 'xs.copy() at r'
; A parameter written `flex x: T` is the task's own copy: the task may change
; it as it changes any `flex` variable, and the value the caller gave never
; changes, so the call needs no mark.

include flex_parameters/steps {collatz}

shape Counter
    n: int = 0

    alters tick()
        .n = .n + 1
    fi

    ; A method takes one too.
    alters add_all(flex by: [int#3])
        by[0] = by[0] + by[1] + by[2]
        .n = .n + by[0]
    fi
fi

task countdown(flex n: int, step: int) -> int
    flex steps = 0
    loop n > 0
        n = n - step
        steps = steps + 1
    fi
    <- steps
fi

; A shape: its fields change, and its alters methods can be called.
task bumped(flex c: Counter) -> int
    c.tick()
    c.n = c.n + 10
    <- c.n
fi

; Text is given a part of itself, and a tuple another tuple.
task cut(flex t: text, flex pair: (int, int)) -> text, int
    when t.len > 2
        t = t[0..2]
    fi
    pair = (pair.1, pair.0)
    <- t, pair.0
fi

; A slice is its own copy of the caller's: adding to it leaves the caller's
; length as it was.
task grown(flex xs: [int]@r, r: region) -> int
    xs.add(9)
    xs.add(10)
    <- xs.len
fi

; A generic task, and a recursive one.
task last_of<T>(flex items: [T#3], fill: T) -> T
    items[2] = fill
    <- items[2]
fi

task digits(flex n: int) -> int
    when n < 10
        <- 1
    fi
    n = n / 10
    <- 1 + digits(n)
fi

task main()
    fixed a = 10
    show(countdown(a, 3), " ", a)

    flex c = Counter {}
    show(bumped(c), " ", c.n)
    fixed arr = [1, 2, 3]
    c.add_all(arr)
    show(c.n, " ", arr[0])

    fixed word = "hey"
    fixed short, first = cut(word, (1, 2))
    show(short, " ", first, " ", word)

    region r
    flex xs = new [int]() at r
    xs.add(1)
    show(grown(xs, r), " ", xs.len)

    show(last_of([1, 2, 3], 7), " ", last_of(["a", "b", "c"], "z"))
    show(digits(12345), " ", collatz(6))
fi
