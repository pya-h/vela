# Types may be used before they are declared, and may point to themselves. A
# kind holding pointers lives in a region, like the pointers it holds.

shape Segment
    from: Point
    to: Point
fi

kind List
    Nil
    Cons(head: Point, tail: ^List)
fi

shape Point
    x: int
    y: int
fi

shape Node
    value: int
    next: maybe ^Node
fi

task length(l: List@r) -> int
    match l
    case Nil
        <- 0
    case Cons head tail
        <- 1 + length(tail^)
    fi
fi

task sum_x(l: List@r) -> int
    match l
    case Nil
        <- 0
    case Cons head tail
        <- head.x + sum_x(tail^)
    fi
fi

task main()
    bind s = Segment { from: Point { x: 1, y: 2 }, to: Point { x: 3, y: 4 } }
    show(s.to.y - s.from.y)
    region lists
    bind empty: ^List@lists = new List(Nil) in lists
    bind one: ^List@lists = new List(Cons(Point { x: 5, y: 0 }, empty)) in lists
    bind two = Cons(Point { x: 7, y: 0 }, one)
    show(length(two))
    show(sum_x(two))
fi
