# A shape whose fields any file reads and only its own alters methods change. The one
# with no value to fall back on is given by the literal that makes the value;
# the others start at theirs and no literal gives them.

kind Mode
    Idle
    Counting
fi

shape Meter
    read label: text
    read count: int = 0
    read mode: Mode = Mode.Idle

    alters tick()
        .count = .count + 1
        .mode = Mode.Counting
    fi

    alters rename(to: text)
        .label = to
    fi

    alters reset()
        .count = 0
        .mode = Mode.Idle
    fi
fi
