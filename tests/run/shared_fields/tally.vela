; A module whose shape keeps shared fields, used from tests/run/shared_fields.vela.

shape Tally
    n: int = 0
    ; Any file reads it; only the methods of Tally change it.
    shared read made: int = 0
    ; Any file that sees it may change it.
    shared flex limit: int = 3
    priv shared flex secret: int = 42

    alters tick()
        .n = .n + 1
        Tally.made = Tally.made + 1
    fi

    ; A method that doesn't change its value may still change shared fields.
    reveal() -> int
        Tally.secret = Tally.secret + 1
        <- Tally.secret
    fi
fi
