; `else when` chains: one `fi` closes the whole chain, and a chain does what a
; `when` written inside an `else` on its own lines does.

kind Light
    Off
    Dimmed(level: int)
    On
fi

task grade(score: int) -> text
    when score >= 90
        <- "top"
    else when score >= 60
        <- "pass"
    else when score >= 0
        <- "fail"
    else
        <- "not a score"
    fi
fi

; A chain with no final `else`: nothing runs when no condition holds.
task counted(n: int) -> int
    flex seen = 0
    when n > 10
        seen = 3
    else when n > 5
        seen = 2
    else when n > 0
        seen = 1
    fi
    <- seen
fi

task made() -> (int, int)
    show("made")
    <- (1, 2)
fi

task missing(m: maybe int) -> bool
    <- m { -1 } == -1
fi

task main()
    each score in 0..4
        show(grade(score * 40 - 40))
    fi
    show(counted(20), " ", counted(7), " ", counted(3), " ", counted(0))

    ; A pattern in a chain: its names are visible only in its own block.
    flex light: Light = Dimmed(4)
    when light is On
        show("on")
    else when light is Dimmed level
        show("dimmed ", level)
    else
        show("off")
    fi

    ; The same chain written as a `when` inside the `else`, which does the same.
    when 1 > 2
        show("never")
    else
        when 2 > 1
            show("nested")
        else
            show("never either")
        fi
    fi

    ; A chain inside a loop, with a region in one of its blocks.
    region kept default
    flex i = 0
    loop i < 3
        when i == 0
            show("zero")
        else when i == 1
            show("one " + i.str())
        else
            show("many")
        fi
        i = i + 1
    fi

    ; A read past a tuple's end works the tuple out, in the arm it is written
    ; in, only when that arm is reached, and not after an 'and' that failed.
    fixed k = 3
    when k > 5
        show("never")
    else when k > 4
        show("never either")
    else when missing(made().#5)
        show("past the end")
    fi
    when k > 1
        show("first")
    else when missing(made().#5)
        show("never")
    fi
    when k > 5 and missing(made().#5)
        show("never")
    fi
fi
