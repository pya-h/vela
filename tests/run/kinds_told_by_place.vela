; Kinds that take types, used before they are declared, held by shapes and
; other kinds, compared under 'same', and told their types by the place a
; when, a match, a maybe or a tuple goes.

task valueOr(o: Option<int>, fallback: int) -> int
    <- match o
    case Some v = v
    case None = fallback
    fi
fi

shape Holder
    o: Option<int>
    later: maybe Option<text>
fi

kind Wrap
    W(o: Option<int>)
    Nothing
fi

kind Pair<T>
    Both(first: Box<T>, second: T)
fi

kind Box<T>
    Held(value: T)
fi

kind Option<T: shown>
    Some(value: T)
    None
fi

task alike<T: same & shown>(a: Option<T>@r, b: Option<T>@r) -> bool
    <- a == b
fi

task same<T: same & shown>(a: T, b: T) -> bool
    <- a == b
fi

task pick(c: bool) -> Option<int>
    <- when c Option.None else Option.None fi
fi

task firstOf(c: bool) -> (Option<int>, int)
    <- (Option.None, 1)
fi

shape P
    x: int

    ; Two comparisons, the second with the field of this.
    around(a: int, b: int, c: int) -> bool
        fixed both = (a < b, c > .x)
        <- both.0 and both.1
    fi
fi

task main()
    fixed h = Holder { o: Option.Some(3), later: none }
    show(valueOr(h.o, 0), " ", h.later, " ", Wrap.W(Option.None), " ", Wrap.Nothing)
    show(Pair.Both(Box.Held(1), 2))

    fixed a: Option<int> = Option.Some(1)
    show(alike(a, Option.Some(1)), " ", alike(a, Option.None), " ", same(a, a), " ", same(Option.Some("x"), Option.Some("y")))

    flex x: Option<int> = Option.Some(1)
    x = match x
    case Some _ = Option.None
    case None = Option.None
    fi
    fixed q: maybe Option<int> = when true Option.None else none fi
    fixed t: (Option<int>, int) = (Option.None, 1)
    show(pick(true), " ", x, " ", q, " ", t, " ", firstOf(true))

    show(P { x: 1 }.around(1, 2, 3), " ", P { x: 5 }.around(1, 2, 3))
fi
