; Macros: `macro NAME = value` outside every task, a value the compiler
; computes from literals, other macros, and operators on them. Its type is its
; value's, and each use is that value, a C `#define`.

include macros/limits (LIMIT => MAX, GREETING)

macro P = 3.14159
macro TAU = P * 2.0
macro SIZE = 4
macro LAST = SIZE - 1
macro NAME = "vela"
macro TITLE = NAME + "!"
macro FIRST = 'a'
macro NEXT = FIRST + 1
macro BIG = SIZE > 2 and not false
macro SMALL = unit(200)
macro LOWEST = -9223372036854775807 - 1
macro WHOLE = int(2.9)
macro HALF = float(SIZE) / 2.0
; A macro may name one declared below it.
macro AREA = SIDE * SIDE
macro SIDE = 3

shape Circle
    radius: float = 1.0
    shared unit_area: float = P
fi

task circle_area(c: Circle) -> float
    <- P * c.radius * c.radius
fi

task main()
    show(P, " ", TAU, " ", HALF, " ", circle_area(Circle { radius: 2.0 }), " ", Circle.unit_area)
    show(SIZE, " ", LAST, " ", LOWEST, " ", WHOLE, " ", AREA)
    show(NAME, " ", TITLE, " ", NAME.len, " ", TITLE[4], " ", FIRST, " ", NEXT, " ", BIG)
    ; An int macro is a unit where one is expected, as a literal is.
    hold b: unit = SIZE
    show(b + SMALL, " ", SMALL)
    bind xs = [0#SIZE]
    show(xs, " ", xs[LAST])
    each i in 0..SIDE
        show(i)
    fi
    when SIZE == 4
        show("four")
    fi
    ; Another file's macros, through its module or brought in.
    show(MAX, " ", GREETING, " ", limits.DOUBLE_LIMIT, " ", limits.spare())
fi
