; Values are read left to right: one read before a call that changes it (given
; as `&a`, or as the value an alters method is called on) is read as it was.

shape Counter
    n: int = 0

    alters bump() -> int
        .n = .n + 10
        <- 0
    fi
fi

task bump(hold& x: int) -> int
    x = x + 100
    <- 0
fi

task pair(a: int, b: int) -> int
    <- a * 1000 + b
fi

task step(hold& x: int) -> bool
    x = x + 1
    <- x < 2
fi

task seven(hold& i: int) -> int
    i = i + 1
    <- 7
fi

task main()
    hold n = 1
    show(n + bump(&n), " ", n)
    show(pair(n, bump(&n)), " ", n)
    show(bump(&n) + n, " ", n)
    hold c = Counter {}
    show(c.n + c.bump(), " ", c.n)
    show(pair(c.n, c.bump()), " ", c.n)
    hold flag = false
    show(flag or bump(&n) == 0, " ", n)
    show(flag and bump(&n) == 0, " ", n)

    ; A loop's condition is read again before every round, change and all.
    hold k = 0
    hold rounds = 0
    loop k < 300 and bump(&k) == 0
        rounds = rounds + 1
    fi
    show(k, " ", rounds)

    ; The place given with '&' is found where the argument is read: not at all
    ; when 'and' skips its right side, again each round of a loop, and in the
    ; 'else when' that reaches it.
    hold arr = [0, 0, 0]
    hold i = 3
    show(i < 3 and step(&arr[i]))
    hold j = 0
    loop j < 3 and step(&arr[j])
        j = j + 1
    fi
    show(arr[0], arr[1], arr[2], " ", j)
    when j == 0
        show("none")
    else when step(&arr[j - 1])
        show("again")
    else
        show("stepped ", arr[2])
    fi

    ; An assignment finds its place before the value that changes the index.
    hold spot = 0
    hold slots = [0, 0, 0]
    slots[spot] = seven(&spot)
    show(slots[0], slots[1], slots[2], " ", spot)
fi
