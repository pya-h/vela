# when/else, loop, each, and early send

task sign(n: int) -> int
    when n < 0
        send -1
    end
    when n == 0
        send 0
    end
    send 1
end

task main()
    each i in 0..3
        when i == 1
            show("one")
        else
            show(i)
        end
    end

    hold total = 0
    hold k = 1
    loop k <= 4
        total = total + k
        k = k + 1
    end
    show(total)

    show(sign(-5))
    show(sign(0))
    show(sign(9))
end
