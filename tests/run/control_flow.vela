; when/else, loop, each, and early send

task sign(n: int) -> int
    when n < 0
        <- -1
    fi
    when n == 0
        <- 0
    fi
    <- 1
fi

task main()
    each i in 0..3
        when i == 1
            show("one")
        else
            show(i)
        fi
    fi

    hold total = 0
    hold k = 1
    loop k <= 4
        total = total + k
        k = k + 1
    fi
    show(total)

    show(sign(-5))
    show(sign(0))
    show(sign(9))
fi
