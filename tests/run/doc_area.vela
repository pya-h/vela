# The kinds example from docs/vela.html

kind Shape
    Circle(radius: float)
    Rectangle(width: float, height: float)
fi

task area(s: Shape) -> float
    match s
    case Circle r
        <- 3.14 * r * r
    case Rectangle w h
        <- w * h
    fi
fi

task main()
    show(area(Circle(2.5)))
    show(area(Rectangle(1.5, 4.5)))
fi
