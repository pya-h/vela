; `T ~ E`: a task that can fail sends a value or `fail error`. `match`, `is`,
; and plan B read the result; `unit ~ E` succeeds with a bare `<-` or by
; reaching its end.

kind BadSize
    Empty
    Negative(value: int)
fi

task check_size(size: int) -> int ~ BadSize
    when size < 0
        <- fail Negative(size)
    fi
    when size == 0
        <- fail Empty
    fi
    <- size * 2
fi

task explain(e: BadSize) -> text
    match e
    case Empty
        <- "empty"
    case Negative value
        when value < -100
            <- "very negative"
        fi
        <- "negative"
    fi
fi

task save(size: int) -> unit ~ text
    when size > 100
        <- fail "too big"
    fi
    when size == 50
        show("exactly fifty")
        <-
    fi
    show("saved")
fi

task lookup(key: text) -> maybe int ~ text
    when key == ""
        <- fail "no key"
    fi
    when key == "answer"
        <- 42
    fi
    <- none
fi

task save_twice(size: int) -> unit ~ text
    save(size) { failure e
        <- fail e
    }
    <- save(size)
fi

task doubled_or_zero(size: int) -> int
    bind n = check_size(size) {
        failure e
        show(explain(e))
        <- 0
    }
    <- n
fi

task main()
    show(check_size(3) { 0 })
    show(check_size(-1) { 0 })

    bind described = check_size(-500) {
        failure problem
        show(explain(problem))
        -1
    }
    show(described)

    show(doubled_or_zero(5))
    show(doubled_or_zero(0))

    match check_size(7)
    case {value}
        show(value)
    case failure e
        show(explain(e))
    fi

    when check_size(-2) is failure e
        show(explain(e))
    fi
    when check_size(1) is {value}
        show(value)
    fi

    save(10) { failure e
        show(e)
    }
    save(500) {
        failure reason
        show(reason)
    }
    save(50) { }
    save(1000) { failure _ }
    save_twice(300) { failure e
        show(e)
    }

    match save(200)
    case {_}
        show("fine")
    case failure message
        show(message)
    fi

    hold stored: int ~ BadSize = fail Empty
    show(stored { -1 })
    stored = 8
    show(stored { -1 })

    show(lookup("answer") { none } { 0 })
    show(lookup("other") { none })
    bind missing = lookup("") {
        failure why
        show(why)
        none
    }
    show(missing)
fi
