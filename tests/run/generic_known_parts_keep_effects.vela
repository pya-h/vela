; A copy of a generic task drops a part of a condition it knows never holds, and
; what comes after it, but what came before it still runs: here each tick shows.
task tick(k: int) -> bool
    show("tick ", k)
    <- true
fi

task f<P...: fixed & shown>(args: P...)
    bind t = (args...) { <- }
    when tick(1) and args.len > 5
        show("big")
    fi
    when tick(2) and t.#1 is none
        show("no second")
    fi
    loop tick(3) and args.len > 5
        show("loop")
    fi
    hold b = (tick(4) and args.len > 5) and true
    show(b)
    hold c = (tick(5) or args.len > 0) or false
    show(c)
    when args.len > 5 and tick(6)
        show("never")
    fi
fi

task main()
    f(1, 2)
fi
