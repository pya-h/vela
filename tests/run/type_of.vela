; `x.type`: the type of a value as code writes it, known to the compiler, so
; the value is never worked out. Regions are left out, a shape or kind is its
; own name, and in a task that takes types it is the type each use gives.

include type_of/shapes

shape Box<T>
    value: T
fi

shape Point
    x: int
    y: int

    own() -> text
        <- .type
    fi

    of_x() -> text
        <- .x.type
    fi

    inside() -> text
        <- .this.type
    fi
fi

kind Mood
    Calm
    Loud(level: int)
fi

task named<T>(v: T) -> text
    <- v.type
fi

task listed<T>(vs: [T#2]) -> text
    <- vs.type
fi

task count() -> int
    show("never")
    <- 1
fi

task main()
    region r
    show(1.type, " ", 2.5.type, " ", true.type, " ", "hi".type)
    fixed xs = [1, 2, 3]
    fixed grid = [[0.5#2]#3]
    show(xs.type, " ", grid.type, " ", grid[0].type, " ", xs.len.type)
    fixed items = new [float]() at r
    fixed words = new [text]() at r
    show(items.type, " ", words.type, " ", items[0..0].type)
    fixed p = Point { x: 1, y: 2 }
    fixed near = new Point(p) at r
    fixed far = new ^Point(near) at r
    show(p.type, " ", near.type, " ", far.type, " ", near^.type, " ", p.x.type)
    fixed m: maybe int = none
    fixed pair = (1, "a")
    show(m.type, " ", pair.type, " ", pair.1.type, " ", Mood.Loud(2).type)
    fixed b = Box<int> { value: 3 }
    fixed nested = Box<Box<text>> { value: Box<text> { value: "x" } }
    show(b.type, " ", nested.type, " ", nested.value.type)
    ; A shape or kind of another file is its own name.
    show(shapes.Crate { size: 1 }.type, " ", shapes.Weather.Sun.type, " ", shapes.Weather.Rain(2).type)
    ; Text in a region is text.
    fixed t = "a" + "b" at r
    show(t.type)
    ; In a task that takes types, the type each use gives.
    show(named(1), " ", named(xs), " ", named(b), " ", named(near), " ", named(pair))
    show(listed([p, p]), " ", listed(["a", "b"]))
    ; Inside a method, `.type` is the type of the value it is called on.
    show(p.own(), " ", p.inside(), " ", p.of_x())
    ; The value itself is never worked out, as C's sizeof.
    show(count().type)
    ; It is text like any other.
    fixed word = xs.type
    show(word.len, " ", word == "[int#3]")
fi
