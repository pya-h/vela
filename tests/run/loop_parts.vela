; warning: 107:5: this loop never ends by its condition; write 'endless' to say so
; warning: 111:5: this loop never ends by its condition; write 'endless' to say so
; warning: 121:12: this loop never ends: its condition reads only 'x', which nothing in the loop changes, and nothing in it leaves the loop
; Loops in three parts, 'loop start || condition || step', and 'endless'.

shape Counter
    n: int

    alters bump()
        .n++
    fi
fi

task advance(flex& spot: int)
    spot += 2
fi

task joined<T: shown>(r: region, xs: [T]@r) -> text@r
    flex out: text@r = ""
    loop flex i = 0 || i < xs.len || i++
        out += "{xs[i]} " at r
    fi
    <- out
fi

task main()
    region r

    ; A name of its own, and several of them, after 'flex' and 'fixed'.
    loop flex i = 0 || i < 3 || i++
        show("i ", i)
    fi
    flex total = 0
    loop flex i = 1, j = 10, fixed limit = 7 || i < j and i < limit || i++, j--
        total += i * j
    fi
    show("total ", total)

    ; Names already declared come first; the step may swap and call.
    flex k = 0
    flex calls = 0
    loop k = 1, calls = 0, flex a = 0, b = 1 || b < 30 || a, b = b, a + b, calls++
        show("fib ", b)
    fi
    show("k ", k, " calls ", calls)

    ; 'continue' runs the step, 'break' doesn't.
    flex last = 0
    loop last = 0 || last < 10 || last++
        when last % 2 == 1
            continue
        fi
        when last == 6
            break
        fi
        show("even ", last)
    fi
    show("last ", last)

    ; A part may be empty; the last '||' may be left out.
    flex m = 0
    loop || m < 3 || m++
        show("m ", m)
    fi
    loop flex w = 0 || w < 2
        show("w ", w)
        w++
    fi
    loop flex pos = 0 || pos < 7 || advance(&pos)
        show("pos ", pos)
    fi

    ; A pattern, and parts joined with 'and', as any loop takes them.
    fixed words = ["ox", "elk", "yak", "zebra", "eel"]
    loop flex n = 0 || words[#n] is {word} and word.len < 4 || n++
        show("word ", word)
    fi

    ; A step of any statement, a 'when' too, and the regions of a pass.
    loop flex s = 0 || s < 6 || s++, when s == 3 s++ fi
        region pass
        fixed label = "s{s}" at pass
        show(label)
    fi
    flex c = Counter { n: 0 }
    loop || c.n < 3 || c.bump()
        show("c ", c.n)
    fi
    show(joined(r, [1, 2, 3, ...] at r), joined(r, ["a", "b", ...] at r))

    ; 'endless', named, stopped from inside.
    flex e = 0
    outer => endless
        loop flex inner = 0 || || inner++
            e++
            when e > 7
                break outer
            fi
            when inner == 2
                break
            fi
        fi
    fi
    show("e ", e)

    ; Without the word, a loop that never ends by itself is told.
    loop || ||
        break
    fi
    flex t = 0
    loop true
        t++
        when t == 2
            break
        fi
    fi
    show("t ", t)
fi

task never(x: int)
    loop x < 10
        show(x)
    fi
fi
