; warning: 49:9: '&a' is where the place is, and 'a' is a parameter, given as the compiler chose: Wide takes 72 bytes, more than 64, so 'a' is where the caller keeps it, or a copy the caller makes first of a value that might change while the task runs, such as one behind a pointer, in a slice or a shared field, or named by a reference; write 'fixed& a: Wide' for the caller's place, or 'fixed a: Wide' for a copy of its own
; How a parameter is given, written before its name: nothing lets the compiler
; choose (a copy, or where the caller keeps a large value), `fixed x` is always
; a copy, and `fixed& x` is the caller's place, only read, which a call gives
; as `&a`. `flex x` and `flex& x` are the ones a task changes.

; Nine ints: large enough that the compiler reads a plain parameter where the
; caller keeps it.
shape Wide
    a: int
    b: int
    c: int
    d: int
    e: int
    f: int
    g: int
    h: int
    i: int

    ; A part of the value a method changes can't be read by it as well, but
    ; another place can.
    alters grow(fixed& by: Wide)
        .a = .a + by.a
    fi
fi

shape Point
    x: int
    y: int
fi

; `==` compares shapes by where they are, so two `fixed&`s given one place are
; equal, and two copies never are.
task one(fixed& a: Point, fixed& b: Point) -> bool
    <- a == b
fi

task copies(fixed a: Point, fixed b: Point) -> bool
    <- a == b
fi

; A strict copy is a place of its own; a plain large parameter is where the
; caller keeps it, as the compiler chose.
task copied(fixed a: Wide, fixed& b: Wide) -> bool
    <- &a == &b
fi

task chosen(a: Wide, fixed& b: Wide) -> bool
    <- &a == &b
fi

; A `flex` is a copy of the task's own as well, even one it never changes.
task held(flex a: Wide, fixed& b: Wide) -> bool
    <- &a == &b
fi

; An array read where it is, never copied.
task sum(fixed& xs: [int#3], fixed start: int) -> int
    flex total = start
    each x in xs
        total = total + x
    fi
    <- total
fi

; A `fixed&` passes its place on to another.
task onward(fixed& p: Point) -> bool
    <- one(&p, &p)
fi

task written(r: region, fixed& p: Point) -> text@r
    <- "{p.x},{p.y}" at r
fi

; In a task that takes types, any place of the type given.
task same_place<T: same>(fixed& a: T, fixed& b: T) -> bool
    <- a == b
fi

; The task's own copy of a pointer, which points to the caller's value: it
; changes that value through it, which nothing does through a 'fixed&' pointer.
task nudge(flex spot: ^Point@r) -> int
    spot^.x = spot^.x + 1
    <- spot^.x
fi

task open(fixed& m: maybe ^Point@r) -> int
    fixed spot = m { <- 0 }
    <- spot^.x
fi

task kept<T>(fixed& a: T) -> T
    <- a
fi

task main()
    region r
    fixed p = Point { x: 1, y: 2 }
    flex q = p
    show(one(&p, &p), " ", one(&p, &q), " ", copies(p, p), " ", onward(&q), " ", written(r, &q))
    flex w = Wide { a: 1, b: 0, c: 0, d: 0, e: 0, f: 0, g: 0, h: 0, i: 0 }
    fixed other = w
    show(copied(w, &w), " ", chosen(w, &w), " ", held(w, &w))
    w.grow(&other)
    w.grow(&other)
    show(w.a)
    fixed xs = [1, 2, 3]
    show(sum(&xs, 10))
    ; What a pointer points to, and a field, are places too.
    flex ptr = new Point(p) at r
    show(one(&ptr^, &ptr^), " ", one(&ptr^, &p), " ", same_place(&p.x, &p.x), " ", same_place(&xs, &xs), " ", same_place(&p, &q))
    flex held: maybe ^Point@r = ptr
    show(nudge(ptr), " ", open(&held), " ", kept(&ptr)^.x)
fi
