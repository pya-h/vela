; A lambda that keeps what it uses, written in an included module, is the
; module's own, beside one of the main file.
include lambda_keeps_in_a_module/lib

task main()
    region r
    flex c = lib.counter(r, 5)
    show(c(), " ", c())
    fixed msg = "main's lambda"
    flex g = [flex @r]() -> int
        show(msg)
        <- 0
    fi
    show(g())
fi
