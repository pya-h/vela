; A pointer always points to something; `maybe ^T` is the one that can be
; `none`. `is` walks a list, and a plan B supplies a missing pointer. The tasks
; name the list's region `r` without allocating in it.

shape Node
    value: int
    next: maybe ^Node
fi

task sum(list: maybe ^Node@r) -> int
    when list is {node}
        <- node^.value + sum(node^.next)
    fi
    <- 0
fi

task find(list: maybe ^Node@r, wanted: int) -> maybe ^Node@r
    when list is {node}
        when node^.value == wanted
            <- node
        fi
        <- find(node^.next, wanted)
    fi
    <- none
fi

task last(list: ^Node@r) -> ^Node@r
    when list^.next is {next}
        <- last(next)
    fi
    <- list
fi

task main()
    region nodes
    fixed empty: maybe ^Node@nodes = none
    show(empty == none)
    show(sum(empty))
    ; A list the program changes is held by flex names.
    flex third = new Node(Node { value: 3, next: none }) at nodes
    flex second = new Node(Node { value: 2, next: third }) at nodes
    flex first = new Node(Node { value: 1, next: second }) at nodes
    show(sum(first))
    show(last(first)^.value)

    when find(first, 2) is {flex found}
        show(found == second)
        found^.value = 20
    fi
    show(sum(first))
    show(find(first, 9) == none)

    when find(first, 9) is {found}
        show(found^.value)
    else
        show("not found")
    fi

    fixed fallback = find(first, 9) { third }
    show(fallback^.value)

    flex spare: maybe ^int@nodes = none
    spare = new int(7) at nodes
    when spare is {p}
        show(p^)
    fi
fi
