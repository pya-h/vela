; A pointer always points to something; `maybe ^T` is the one that can be
; `none`. `is` walks a list, and a plan B supplies a missing pointer. The tasks
; name the list's region `r` without allocating in it.

shape Node
    value: int
    next: maybe ^Node
fi

task sum(list: maybe ^Node@r) -> int
    flex total = 0
    flex current = list
    loop current is {node}
        total = total + node^.value
        current = node^.next
    fi
    <- total
fi

task find(list: maybe ^Node@r, wanted: int) -> maybe ^Node@r
    flex current = list
    loop current is {node}
        when node^.value == wanted
            <- node
        fi
        current = node^.next
    fi
    <- none
fi

task last(list: ^Node@r) -> ^Node@r
    flex current = list
    loop current^.next is {next}
        current = next
    fi
    <- current
fi

task main()
    region nodes
    fixed empty: maybe ^Node@nodes = none
    show(empty == none)
    show(sum(empty))
    fixed third = new Node(Node { value: 3, next: none }) at nodes
    fixed second = new Node(Node { value: 2, next: third }) at nodes
    fixed first = new Node(Node { value: 1, next: second }) at nodes
    show(sum(first))
    show(last(first)^.value)

    when find(first, 2) is {found}
        show(found == second)
        found^.value = 20
    fi
    show(sum(first))
    show(find(first, 9) == none)

    when find(first, 9) is {found}
        show(found^.value)
    else
        show("not found")
    fi

    fixed fallback = find(first, 9) { third }
    show(fallback^.value)

    flex spare: maybe ^int@nodes = none
    spare = new int(7) at nodes
    when spare is {p}
        show(p^)
    fi
fi
