shape Scaler
    factor: int

    scale(n: int) -> int
        <- n * .factor
    fi
fi

shape BigPayload
    a1: int
    a2: int
    a3: int
    a4: int
    a5: int
    a6: int
    a7: int
    a8: int
    a9: int
fi

kind SmallOk
    Tiny(n: int)
fi

kind BigOk::SmallOk
    Extra(label: text)
fi

task make_big(v: int) -> BigPayload
    <- BigPayload { a1: v, a2: v, a3: v, a4: v, a5: v, a6: v, a7: v, a8: v, a9: v }
fi

task sum_big(b: BigPayload) -> int
    <- b.a1 + b.a5 + b.a9
fi

task take_opt(v: maybe int) -> int
    when v is { n }
        <- n + 1
    else
        <- 0
    fi
fi

task make_small_ok() -> SmallOk
    <- Tiny(12)
fi

task read_big_ok(v: BigOk) -> int
    match v
    case Tiny n
        <- n
    case Extra _
        <- -1
    fi
fi

task fail_big_ok(flag: bool) -> BigOk ~ text
    when flag
        <- fail "recover_small"
    fi
    <- Extra("direct")
fi

task echo_local_text(s: text@r, out: region default) -> text@out
    <- "{s}!" at out
fi

task add_ten(n: int) -> int
    <- n + 10
fi

task double_it(n: int) -> int
    <- n * 2
fi

task add_one(n: int) -> int
    <- n + 1
fi

task maybe_fail(ok: bool) -> int ~ text
    when not ok
        <- fail "boom"
    fi
    <- 42
fi

task ping(ready: Chan[int], out: Chan[text])
    <<- ready
    "pong" ->> out
fi

task gated_value(gate: Chan[int], val: int) -> int
    <<- gate
    <- val
fi

task cancellable_worker(started: Chan[int], done: Chan[text]) -> int
    1 ->> started
    flex steps = 0
    endless
        when cancelled()
            "cancelled" ->> done
            <- steps
        fi
        steps += 1
        when steps == 100000000
            "finished" ->> done
            <- steps
        fi
    fi
    <- steps
fi

task slow_branch(gate: Chan[int]) -> text
    <<- gate
    <- "slow"
fi

task fast_branch() -> text
    <- "fast"
fi

task nested_outer(x: int) -> int
    fixed inner = rush double_it(x)
    <- (<<- inner) + 7
fi

task run_scoped_cancel(started: Chan[int], done: Chan[text]) -> text
    fixed bg = rush cancellable_worker(started, done)
    <<- started
    <- "leaving"
fi

task contextual_ident(doing: int) -> int
    <- doing + 1
fi

task greet_in(name: text@p, r: region default) -> text@r
    <- "hello, {name}" at r
fi

task log_via_chan(msg: text, out: Chan[text])
    msg ->> out
fi

task might_fail_int(fail_it: bool) -> int ~ text
    when fail_it
        <- fail "bad_input"
    fi
    <- 21
fi

task main()
    ; 1. Basic rush + <<- wait
    fixed a = rush add_ten(5)
    show("a: ", <<- a)

    ; 2. Shape method rush + .wait()
    fixed s = Scaler { factor: 6 }
    fixed b = rush s.scale(7)
    show("b: ", b.wait())

    ; 3. Pipe inside rush + <<- binding tighter than |>
    fixed piped_c = rush (3 |> add_ten() |> double_it())
    fixed piped_res = <<- piped_c |> add_one()
    show("piped: ", piped_res)

    ; 4. Parenthesis-free error handling with Plan B
    fixed ok_c = rush maybe_fail(true)
    fixed err_c = rush maybe_fail(false)
    fixed ok_val = <<- ok_c { failure e
        show("unexpected: ", e)
        0
    }
    fixed err_val = <<- err_c { failure e
        show("caught: ", e)
        99
    }
    show("ok_val: ", ok_val, " err_val: ", err_val)

    ; 5. Commitment[nothing] with <<- and select _ <<-
    fixed ready = chan_new<int>(1)
    fixed out = chan_new<text>(1)
    fixed p1 = rush ping(ready, out)
    1 ->> ready
    <<- p1
    show("ping1: ", <<- out)

    fixed p2 = rush ping(ready, out)
    1 ->> ready
    select
        case _ <<- p2
            show("ping2: ", <<- out)
    fi

    ; 6. Deterministic .poll() (none while blocked, then some after signal)
    fixed gate = chan_new<int>(1)
    fixed polled = rush gated_value(gate, 77)
    when polled.poll() is none
        show("poll1: none")
    else
        show("poll1: unexpected")
    fi
    1 ->> gate
    endless
        when polled.poll() is { v }
            show("poll2: ", v)
            break
        fi
    fi

    ; 7. Explicit .cancel() + cancelled() inside worker
    fixed started1 = chan_new<int>(1)
    fixed done1 = chan_new<text>(1)
    fixed w1 = rush cancellable_worker(started1, done1)
    <<- started1
    w1.cancel()
    <<- w1
    show("explicit_cancel: ", <<- done1)

    ; 8. Structured block-exit auto-cancel + wait before caller proceeds
    fixed started2 = chan_new<int>(1)
    fixed done2 = chan_new<text>(1)
    fixed left = run_scoped_cancel(started2, done2)
    show("scoped: ", left, " -> ", <<- done2)

    ; 9. select racing Commitments (winner chosen, losing arm auto-cancelled)
    fixed slow_gate = chan_new<int>(1)
    fixed c_slow = rush slow_branch(slow_gate)
    fixed c_fast = rush fast_branch()
    fixed race_winner = select
        case msg <<- c_slow = msg
        case msg <<- c_fast = msg
    fi
    show("race: ", race_winner)
    1 ->> slow_gate

    ; 10. Nested rush
    fixed n = rush nested_outer(10)
    show("nested: ", <<- n, " ident: ", contextual_ident(4))

    ; 11. Inline => (v) { ... } with failure fallback and fire-and-forget => { ... }
    fixed mapped = add_ten(5) => (v) { v * 3 }
    show("arrow_map: ", <<- mapped)

    fixed recovered_arrow = might_fail_int(true) => (v) { v + 1 } { failure e
        show("arrow_fail: ", e)
        100
    }
    fixed recovered_val = <<- recovered_arrow
    show("arrow_recover: ", recovered_val)

    fixed ff_out = chan_new<text>(1)
    log_via_chan("bg_logged", ff_out) => { }
    show("fire_forget: ", <<- ff_out)

    ; 12. Fluent .then and .recover on Commitment + |> then(lambda)
    fixed base_c = rush add_ten(4)
    fixed chained_c = base_c.then(n -> n * 2)
    show("fluent_then: ", <<- chained_c)

    fixed fall_c = rush might_fail_int(true)
    fixed safe_c = fall_c.recover(err -> err.len)
    show("fluent_recover: ", <<- safe_c)

    region cr default
    fixed scale = 3
    fixed piped_lambda = (<<- rush add_ten(2)) |> then([@cr] v -> v * scale + 1)
    show("pipe_lambda: ", piped_lambda)

    ; 13. maybe Commitment[int] slot assigned in branch, polled, and reassigned
    fixed slot_gate = chan_new<int>(1)
    flex slot: maybe Commitment[int] = none
    when true
        slot = rush gated_value(slot_gate, 88)
    fi
    when slot.poll() is none
        show("slot_poll1: none")
    else
        show("slot_poll1: unexpected")
    fi
    1 ->> slot_gate
    endless
        when slot.poll() is { sv }
            show("slot_poll2: ", sv)
            break
        fi
    fi
    ; Reassigning cancels old slot safely and binds new commitment to slot scope
    fixed cancel_started = chan_new<int>(1)
    fixed cancel_done = chan_new<text>(1)
    flex cslot: maybe Commitment[int] = rush cancellable_worker(cancel_started, cancel_done)
    <<- cancel_started
    cslot = none
    show("slot_reassign: ", <<- cancel_done)

    ; 14. Region-spliced rush task allocating into destination region
    region msg_r
    fixed suffix = "!"
    fixed c_greeting = rush greet_in("vela", msg_r)
    fixed greeting = <<- c_greeting
    fixed combined = "{greeting}{suffix}" at msg_r
    show("region_splice: ", combined)

    ; 15. Piped local text in rush + big payload >64B + widening/maybe in .then/.recover and |> then
    fixed prefix = "o"
    fixed local_txt = "{prefix}k" at msg_r
    fixed c_piped_txt = rush (local_txt |> echo_local_text() at msg_r)
    show("rush_piped_txt: ", <<- c_piped_txt)

    fixed c_big = (rush make_big(3)).then(sum_big)
    fixed p_big = make_big(4) |> then(sum_big)
    show("big_then: ", <<- c_big, " ", p_big)

    fixed c_opt = (rush add_ten(5)).then(add_one)
    fixed p_opt = 6 |> then(take_opt)
    show("opt_then: ", <<- c_opt, " ", p_opt)

    fixed p_widen = make_small_ok() |> then(read_big_ok)
    fixed c_rec = (rush fail_big_ok(true)).recover(_ -> BigOk.Tiny(25))
    show("widen_then_rec: ", p_widen, " ", read_big_ok(<<- c_rec))
fi
