; Regions are freed on every way out of their block: a `<-` from a plan B in
; a loop condition, on the right of `and`, and from nested plan Bs in a loop
; body. (tests/runtime.rs runs this under sanitizers, which fail on a leak.)

task pick(n: int) -> maybe int
    when n % 3 == 0
        <- none
    fi
    <- n
fi

task fails(n: int) -> int ~ text
    when n % 4 == 0
        <- fail "four"
    fi
    <- n
fi

task from_condition(limit: int) -> int
    region outer
    bind total = new int(0) at outer
    hold j = 1
    loop pick(j) {
        region c
        bind pc = new int(j) at c
        when pc^ > limit
            <- total^
        fi
        0 } < 100
        total^ = total^ + j
        j = j + 1
    fi
    <- -1
fi

task from_and(n: int) -> int
    region a
    bind pa = new int(n) at a
    match fails(pa^)
    case {v}
        <- v
    case failure msg
        region d
        bind pd = new text(msg) at d
        when pd^ == "four" and pick(pa^ / 4) { <- 1000 } > 0
            <- 1
        fi
    fi
    <- 2
fi

task main()
    show(from_condition(2))
    show(from_condition(50))
    show(from_and(5))
    show(from_and(4))
    show(from_and(12))
    each k in 0..1000
        region per
        bind p = new int(k) at per
        show(pick(p^) { fails(p^) { failure e
            region inner
            bind q = new int(0) at inner
            when k > 10
                <-
            fi
            q^ } })
    fi
fi
