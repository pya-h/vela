; A tuple or array written beside '~=' or '<>' becomes the other side's type
; where it can, as it does a written type.
task main()
    fixed t: (int, maybe int) = (1, none)
    show(t ~= (1, none), " ", (1, 2) ~= t, " ", t <> (1, 4))
    fixed a: [maybe int#2] = [1, none]
    show(a ~= [1, none], " ", a ~= [1, 2], " ", [none#2] ~= a)
    fixed m: maybe (int, maybe int) = (2, 3)
    show(m ~= (2, 3), " ", m ~= (2, none))
    fixed f: (float, text) = (1.5, "x")
    show(f ~= (1.5, "x"))
fi
