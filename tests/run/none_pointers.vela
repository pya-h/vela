# `none` is the empty pointer: it fits any pointer type and compares with any
# pointer.

shape Node
    value: int
    next: ^Node
fi

task sum(list: ^Node) -> int
    hold total = 0
    hold current = list
    loop current != none
        total = total + current^.value
        current = current^.next
    fi
    <- total
fi

task find(list: ^Node, wanted: int) -> ^Node
    hold current = list
    loop current != none
        when current^.value == wanted
            <- current
        fi
        current = current^.next
    fi
    <- none
fi

task main()
    bind empty: ^Node = none
    show(empty == none)
    show(none == empty)
    show(sum(empty))
    bind third = new Node(Node { value: 3, next: none })
    bind second = new Node(Node { value: 2, next: third })
    bind first = new Node(Node { value: 1, next: second })
    show(sum(first))
    show(find(first, 2) == second)
    show(find(first, 9) == none)
    hold spare: ^int = none
    show(spare == none)
    spare = new int(7)
    show(spare^)
    free(spare)
    free(third)
    free(second)
    free(first)
fi
