; Modules: a program in several files. `include` loads a file from this file's
; folder; what it declares is named through the module's name (`geometry.area`)
; or, when listed in parentheses, by its own name. `priv` keeps a task, shape,
; kind, or field to its own file.

include modules/geometry
include modules/palette (Color, Custom, describe)
include modules/bank
include modules/lists/stack
; The same module the stack includes, brought in here for its generic task.
include modules/numbers

; The same variant name as palette's Red, and the same task name as
; geometry's area: each module has names of its own.
kind Shade
    Red
    Dark(level: int)
fi

task area(size: int) -> int
    <- size * size
fi

task main()
    ; Tasks, shapes, and variants of a module, through its name.
    fixed square = geometry.Square(3.0)
    fixed circle = geometry.Circle(1.0)
    show(geometry.area(square))
    show(geometry.area(circle) > 3.0)
    show(area(4))
    fixed origin = geometry.Point { x: 0.0, y: 0.0 }
    fixed corner: geometry.Point = geometry.Point { x: 3.0, y: 4.0 }
    show(geometry.distance(origin, corner))
    geometry.main()
    ; A case names a variant alone: the value's kind says whose it is.
    match square
    case Circle radius
        show(radius)
    case Square side
        show(side)
    case Dot
        show(0.0)
    fi
    when geometry.Dot is Dot
        show("a dot")
    fi

    ; Names brought in with `include m (…)`, and the others still through `m.`.
    fixed red: Color = palette.Red
    show(describe(red))
    show(describe(Custom(10, 20, 30)))
    show(describe(palette.Blue))
    ; A method of a module's kind, called on a variant named through the module.
    region colors
    show(palette.Blue.str() at colors)
    show(palette.Color.Red.str(colors))
    show(text(red) at colors)
    match Dark(3)
    case Red
        show("red shade")
    case Dark level
        show(level)
    fi

    ; A private field, set and read through its module's tasks.
    flex account = bank.open("ada", 100)
    account = bank.deposit(account, 50)
    show(account.owner)
    show(bank.balance(account))
    fixed after = bank.withdraw(account, 500) {
        failure problem
        show(bank.explain(problem))
        account
    }
    show(bank.balance(after))

    ; A module in a folder, which includes another through `..`, with regions and
    ; named results.
    region r
    flex top: maybe ^stack.Node@r = none
    each i in 1..4
        top = stack.push(r, top, i * 10)
    fi
    fixed total, count = stack.sum(top)
    show(total)
    show(count)

    ; A task from another module that takes a type, with the type worked out
    ; from the arguments and written at the call.
    show(numbers.larger(3, 8))
    show(numbers.larger<float>(1.5, 0.5))

    ; A shape from another module that takes types, built here and there.
    fixed tally: numbers.Tally<int> = numbers.Tally { value: 5, count: 2 }
    show(tally.value)
    show(tally.count)
    fixed counted = numbers.tallyOf(r, "once")
    show(counted.value)
    show(counted.count)

    ; The builtin kinds a module sends, read here: their names are the same in
    ; every file, since no file declares them.
    show(numbers.read("42") { 0 })
    show(numbers.read("4x2") { -1 })
    show(numbers.refused() {
        failure e
        show(numbers.reason(e))
        -1
    })
    match numbers.stopped()
    case {value}
        show(value)
    case failure e
        show(numbers.reason(e))
    fi
fi
