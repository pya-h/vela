# Lists of names: types on some or all of them, `hold` from a call sending
# several results, and `_` dropping a result.

task divmod(a: int, b: int) -> int, int
    <- a / b, a % b
fi

task twice(n: int) -> int
    show("called")
    <- n * 2
fi

task main()
    bind x: int, y: float = 3, 0.5
    show(x)
    show(y)
    hold a, b = divmod(17, 5)
    a = a + b
    show(a)
    hold c: maybe int, d = none, 4
    c = d
    show(c)
    _ = twice(4)
    _, _ = divmod(1, 1)
fi
