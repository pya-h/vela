# Assigning to fields of hold variables, nested fields, and through pointers.

shape Point
    x: int
    y: int
fi

shape Line
    from: Point
    to: Point
fi

task main()
    hold line = Line { from: Point { x: 0, y: 0 }, to: Point { x: 1, y: 1 } }
    line.to.x = 5
    show(line.to.x)

    region r
    bind p = new Point(Point { x: 1, y: 2 }) at r
    p^.x = 9
    p^ = Point { x: p^.x + 1, y: 0 }
    show(p^.x)

    bind lp = new Line(line) at r
    lp^.from.y = 7
    show(lp^.from.y)
fi
