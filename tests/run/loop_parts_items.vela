; warning: 83:5: this loop never ends by its condition; write 'endless' to say so
; Items of a loop's parts with types, lambdas and blocks in them, a condition
; over several lines, and loops that never finish a task.

kind Either<A: shown, B: shown>
    Left(value: A)
    Right(value: B)
fi

shape Pair<L, R>
    left: L
    right: R
fi

shape Bag
    items: [int]
fi

kind Token
    Num(n: int)
    Stop
fi

task apply(f: (int) -> int, x: int) -> int
    <- f(x)
fi

task token(i: int) -> Token
    <- when i < 4 Token.Num(i * 2) else Token.Stop fi
fi

; Ends only by sending, so the task never finishes without a value.
task first_over(xs: [int]@r, limit: int) -> int
    flex i = 0
    endless
        when xs[i] > limit
            <- xs[i]
        fi
        i++
    fi
fi

; Results set inside the loop change its condition.
task count() -> total: int
    total <- 0
    loop total < 3
        total <- total + 1
    fi
fi

task main()
    region r

    ; The commas of types given part no items.
    loop flex e = Either<int, text>.Left(3), p: Pair<int, text> = Pair { left: 1, right: "a" }, n = 0 || n < 1 || n++
        show(e, " ", p.left, p.right)
    fi

    ; Nor do those of a lambda's call, before its 'fi' or after it.
    loop flex v = apply((x: int) -> int <- x * 2 fi, 3), j = 0 || j < v || j = apply((x: int) -> int <- x + 2 fi, j)
        show("j ", j)
    fi
    loop flex i = 0, fixed twice = (x: int) -> int <- x * 2 fi || i < 3 || i++
        show("twice ", twice(i))
    fi

    ; A condition over several lines, and the step after its 'fi'.
    loop flex k = 0 || match token(k)
    case Num n = n < 5
    case Stop = false
    fi || k++
        show("k ", k)
    fi

    ; A slice changed in the loop, and results set in it.
    flex b: Bag@r = Bag { items: [0, ...] at r }
    loop b.items.len < 3
        b.items.add(1)
    fi
    show(b.items.len, " ", count(), " ", first_over([1, 5, 9, ...] at r, 4))

    ; 'true' as the only part says no more than 'endless'.
    loop || true
        break
    fi
fi
