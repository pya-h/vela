; `xs[#i]` reads the item at `i` of an array, a slice, or text in a maybe:
; the item when `i` is in range, none when it isn't, so it never stops the
; program. `xs[i]` still reads the item itself and stops out of range.
shape Point
    x: int
fi

task three() -> [int#3]
    <- [7, 8, 9]
fi

task main()
    fixed xs = [1, 2, 3]
    fixed far = 5
    show(xs[#far], " ", xs[#0], " ", xs[#-1], " ", three()[#2], " ", [Point { x: 1 }][#0])
    ; A loop needs no length: it ends at the first none.
    flex j = 0
    loop xs[#j] is {item}
        show(item)
        j = j + 1
    fi
    when xs[#1] ~= 2
        show("two")
    fi
    show(xs[#9] { 0 } + xs[#2] { 0 })
    region r
    flex grown = new [int](xs) at r
    grown.add(4)
    show(grown[#3], " ", grown[#4], " ", grown[1..3][#1])
    ; Text gives a char, as t.at(i) does.
    show("hey"[#1], " ", "hey"[#3], " ", "hey"[#1] ~= "hey".at(1))
    ; A maybe of a pointer, and a maybe holding a maybe.
    flex boxes = new [^int]() at r
    boxes.add(new int(5) at r)
    show(boxes[#0] { new int(0) at r }^, " ", boxes[#1] == none)
    fixed maybes: [maybe int#2] = [1, none]
    show(maybes[#0], " ", maybes[#1], " ", maybes[#2])
fi
