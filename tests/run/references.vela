; A local reference is another name for a place: `flex& y = &x` changes it, so a
; change to either is a change to both, and `fixed& y = &x` only reads it, as it
; is when read. A reference is of its place's type, is never pointed elsewhere,
; and a copy of one, `flex z = y`, is a copy of what it names.

shape Counter
    n: int = 0

    alters tick()
        .n = .n + 1
    fi

    ; A method names a part of its own value.
    alters bump_by(k: int)
        flex& count = &.n
        count = count + k
    fi
fi

task add_hundred(flex& x: int)
    x = x + 100
fi

task main()
    flex x = 1
    flex& y = &x
    y = 5
    show(x)
    x = 7
    show(y)

    ; One that reads a value that never changes, and one that reads what a
    ; variable holds now.
    fixed a = 3
    fixed& b = &a
    fixed& seen = &x
    x = 11
    show(b, " ", seen)

    ; A field, a whole shape, and its alters methods through it; a reference
    ; is given on to a flex& parameter as the place it names.
    flex c = Counter {}
    flex& n = &c.n
    c.tick()
    n = n + 10
    show(c.n, " ", n)
    flex& cc = &c
    cc.tick()
    cc.bump_by(3)
    add_hundred(&cc.n)
    show(c.n)

    ; A slice kept in a variable, an array's item, and a reference to another.
    region r
    flex xs = new [int]() at r
    flex& ys = &xs
    ys.add(4)
    ys.add(5)
    show(xs.len)
    flex arr = [1, 2, 3]
    flex& mid = &arr[1]
    mid = 20
    flex& again = &y
    again = 9
    show(arr[1], " ", x)

    ; What a pointer points to.
    flex p = new Counter(Counter {}) at r
    flex& pn = &p^.n
    pn = 42
    show(p^.n)

    ; A reference that reads a pointer.
    fixed& pointer = &p
    show(pointer^.n)

    ; A copy is a copy.
    flex z = y
    z = 0
    show(x, " ", z)

    ; Each block has its own names: a reference in one, a variable in another.
    each i in 0..2
        when i == 0
            flex& first = &arr[0]
            first = 50
        else
            flex first = 1
            show(first)
        fi
    fi
    show(arr[0])
fi
