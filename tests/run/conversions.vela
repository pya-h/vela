# Turning a value into a number: `float(x)` and `int(x)`, called by the name of
# the type, as `text(x) at r` is. They make no memory, so they name no region.
# `float` of an int always works. `int` of a float is its whole part, toward
# zero, and `int` of a bool is 1 or 0.

task half(n: int) -> float
    <- float(n) / 2.0
fi

task counted<T: shown>(value: T, ok: bool) -> int
    show("counting ", value)
    <- int(ok)
fi

task main()
    region r
    bind n = 7

    # An int as a float, which never fails.
    show(float(n))
    show(float(n) / 2.0)
    show(half(7), " ", half(-3))

    # A float as an int: the whole part, toward zero, so it rounds neither way.
    show(int(2.9), " ", int(2.1), " ", int(2.0))
    show(int(-2.9), " ", int(-2.1), " ", int(-0.5))

    # A bool as an int, which counts.
    show(int(true), " ", int(false))
    show("over three: ", int(n > 3) + int(n > 100))

    # A number turned into its own type is the value itself.
    show(int(n), " ", float(2.5))

    # The values they give are numbers like any other: they add, compare, go
    # into text, and fit where a number is expected.
    show(float(n) + 0.5, " ", int(2.9) * 3)
    show(float(n) > 6.5, " ", int(2.9) == 2)
    show(text(float(n)) at r, " ", "whole {int(2.9)}" at r)
    show(half(int(5.9)))

    # Both edges of an int, which a float holds exactly.
    bind biggest = 9223372036854775807
    bind smallest = -9223372036854775807 - 1
    show(int(float(smallest)) == smallest)
    show(float(biggest) > 9000000000000000000.0)

    # A float that is a whole number already, and one that is not.
    hold total = 0
    each v in [0.5, 1.5, 2.5, 3.5]
        total = total + int(v)
    fi
    show("truncated sum: ", total)

    # In a task that takes types, where the value is shown and the bool counted.
    # One call to a line: which side of a '+' runs first isn't defined.
    bind said = counted("a", true)
    bind quiet = counted(2, false)
    show(said + quiet)
fi
