; A shape whose own field is private and falls back on a value: another module
; can build it, and still can't read or write that field.

kind Power
    Off
    On
fi

shape Machine
    priv used: int = 0
    name: text
    power: Power = Power.Off

    alters run()
        .used = .used + 1
        .power = Power.On
    fi

    runs() -> int
        <- .used
    fi
fi

; A default may give what only this module can, such as a private field that
; falls back on nothing: a literal elsewhere that leaves out `cell` still gets it.
shape Cell
    priv charge: int

    level() -> int
        <- .charge
    fi
fi

shape Plant
    cell: Cell = Cell { charge: 5 }
fi
