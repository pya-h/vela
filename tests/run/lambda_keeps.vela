; Lambdas that keep what they use, [@r](…): a copy of each variable of the code
; around them they use, kept in r when they are made, read where it is kept;
; [flex @r] changes its copies, and the variables never change through them.
task counter(r: region, start: int) -> [flex @r]() -> int
    flex n = start
    <- [flex @r]() -> int
        n = n + 1
        <- n
    fi
fi

task adder(r: region, flex& total: int) -> [@r](int) -> int
    <- [@r](n: int) -> int <- n + total fi
fi

task greeter(r: region, name: text) -> [@r](text) -> text@r
    <- [@r](greeting: text) -> text@r <- greeting + ", " + name at r fi
fi

task apply(f: [@r](int) -> int, x: int) -> int
    <- f(x)
fi

task twice<T>(f: [@r](T) -> T, x: T) -> T
    <- f(f(x))
fi

task double(x: int) -> int
    <- x * 2
fi

shape Box
    n: int
    maker(r: region) -> [@r]() -> int
        fixed k = .n
        <- [@r]() -> int <- k fi
    fi
fi

task main()
    region r
    flex next = counter(r, 10)
    show(next(), " ", next(), " ", next())
    flex total = 5
    fixed add = adder(r, &total)
    total = 100
    show(add(1), " ", total)
    fixed hi = greeter(r, "Ada")
    show(hi("hello"))
    fixed step = 3
    fixed plus = [@r](x: int) -> int <- x + step fi
    show(plus(1), " ", apply(plus, 5), " ", twice(plus, 1))
    ; A task, or a task value, goes where a lambda that keeps is expected.
    fixed plain = (x: int) -> int <- x - 1 fi
    fixed kept: [@r](int) -> int = plain
    show(apply(double, 4), " ", kept(1), " ", apply(kept, 10), " ", apply((x: int) -> int <- x * 3 fi, 2))
    ; What lives in r is used where it is: a change to an item is seen.
    flex xs = new [int]() at r
    xs.add(1)
    xs.add(2)
    flex scale = [flex @r]() -> int
        xs[0] = xs[0] * 10
        <- xs[0]
    fi
    show(scale(), " ", scale(), " ", xs[0], " ", xs.len)
    flex fs = new [[@r]() -> int]() at r
    each i in 0..3
        fs.add([@r]() -> int <- i * step fi)
    fi
    each f in fs
        show(f())
    fi
    flex later: maybe [@r]() -> int = none
    later = [@r]() -> int <- step + 1 fi
    when later is {f}
        show(f())
    fi
    fixed outer = [@r](n: int) -> int
        fixed inner = [@r](m: int) -> int <- m + n + step fi
        <- inner(1)
    fi
    show(outer(10))
    fixed made = [@r](n: int) -> [int]@r
        flex ys = new [int]() at r
        ys.add(n)
        ys.add(xs.len)
        <- ys
    fi
    show(made(7))
    show(Box { n: 42 }.maker(r)())
    show(plus)
fi
