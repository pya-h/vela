; Text joined at the end of its region's memory grows in place, and text
; made from it before stays as it was.
task main()
    region r
    flex t: text@r = "" + "" at r
    each i in 0..3000
        t += "x"
    fi
    flex u = t + "!" at r
    t += "y"
    flex v = t + "z" at r
    t += "{t.len}"
    show(t.len, " ", u.len, " ", v.len)
    show(u[2998..3001], " ", v[2999..3002], " ", t[2999..3005])
    ; Itself joined to itself.
    flex w: text@r = "ab" + "" at r
    w += w
    w += w
    show(w)
fi
