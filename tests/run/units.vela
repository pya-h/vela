; A unit is a whole number from 0 to 255 in one byte. A number written out
; becomes one where a unit is expected, and beside one; arithmetic on units
; stops the program when a result doesn't fit (see tests/trap/unit_*).
task twice(b: unit) -> unit
    <- b * 2
fi

task main()
    hold b: unit = 200
    b = b + 55
    show(b)
    show(twice(100))
    bind m: maybe unit = 7
    show(m, " ", m ~= 7)
    bind xs: [unit#3] = [1, 2, 3]
    show(xs, " ", xs ~= [1, 2, 3])
    ; Conversions: to an int or a float always, to a unit when it fits.
    show(int(b) + 1, " ", float(b), " ", unit(3.9), " ", unit(true), " ", unit(40) + 2)
    show(unit("42") { 0 }, " ", unit("300") { 9 }, " ", unit("-1") { 8 }, " ", unit("x") { 7 })
    show(b == 255, " ", b > 3, " ", b ~= 255, " ", 1 < b, " ", b.type)
    region r
    show("b is {b}" at r, " ", b.str() at r, " ", text(b) at r)
    show((b, 1))
    show(b / 2, " ", b % 7, " ", b - b + 3 - 1)
    show(scan("", unit) { 0 })
fi
