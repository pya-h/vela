; A '[bind @r]' lambda changes the contents of what it keeps: the items of
; its copy of a slice, which are the slice's own. Like a '[flex @r]' one, it is
; never copied, so a 'flex' variable holds it.

task main()
    region r
    flex xs = new [int]() at r
    xs.add(1)
    flex inc = [bind @r](n: int) -> nothing
        xs[0] = xs[0] + n
    fi
    inc(2)
    inc(3)
    show(xs[0])
fi
