; A '[bind @r]' lambda changes the contents of what it keeps: the items of
; its copy of a slice, which are the slice's own. Every copy of the lambda shares
; them anyway, so it is copied as a slice is, and a 'flex' or 'bind' name calls it.

task main()
    region r
    flex xs = new [int]() at r
    xs.add(1)
    flex inc = [bind @r](n: int) -> nothing
        xs[0] = xs[0] + n
    fi
    inc(2)
    inc(3)
    flex other = inc
    other(10)
    bind third = other
    third(100)
    show(xs[0])
fi
