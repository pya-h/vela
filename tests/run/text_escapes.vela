; Text reaches C exactly as written: no trigraphs, raw control bytes, or
; escapes that swallow the characters after them.
task main()
    show("what??!")
    show("a??/b")
    show("??=??(??)??<??>??'??-")
    show("tab\tseparated")
    show("quote \" and backslash \\")
    show("ab")
    show("é1")
    show("héllo, wörld ✓7")
    show("100% sure")
    ; A NUL is a byte of the text like any other.
    show("ab\0cd")
fi
