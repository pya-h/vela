; Figures and their measures, for tests/run/modules.vela.

shape Point
    x: float
    y: float
fi

kind Figure
    Circle(radius: float)
    Square(side: float)
    Dot
fi

task area(figure: Figure) -> float
    match figure
    case Circle radius
        <- pi() * radius * radius
    case Square side
        <- side * side
    case Dot
        <- 0.0
    fi
fi

task distance(a: Point, b: Point) -> float
    fixed dx = a.x - b.x
    fixed dy = a.y - b.y
    <- root(dx * dx + dy * dy)
fi

; Only the main file's main starts the program: this one is an ordinary task.
task main()
    show("geometry")
fi

priv task pi() -> float
    <- 3.14159
fi

; Newton's method: Vela has no math library yet.
priv task root(n: float) -> float
    flex guess = n
    each step in 0..30
        when guess > 0.0
            guess = (guess + n / guess) / 2.0
        fi
    fi
    <- guess
fi
