; A stack of numbers in a region, for tests/run/modules.vela. It includes a module
; from the folder above.

include ../numbers (add)

shape Node
    value: int
    below: maybe ^Node
fi

task push(r: region, top: maybe ^Node@r, value: int) -> ^Node@r
    <- new Node(Node { value: value, below: top }) at r
fi

task sum(top: maybe ^Node@r) -> total: int, count: int
    total, count <- 0, 0
    when top is {node}
        fixed below, under = sum(node^.below)
        total, count <- add(below, node^.value), numbers.add(under, 1)
    fi
fi
