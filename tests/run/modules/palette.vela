; Colors, for tests/run/modules.vela.

kind Color
    Red
    Blue
    Custom(red: int, green: int, blue: int)
    str(r: region) -> text@r
        <- describe(.this).str() at r
    fi
fi

task describe(color: Color) -> text
    match color
    case Red
        <- "red"
    case Blue
        <- "blue"
    case Custom r g b
        <- mix(r, g, b)
    fi
fi

priv task mix(r: int, g: int, b: int) -> text
    when r + g + b > 50
        <- "light"
    fi
    <- "dark"
fi
