; Block scoping: variables live until the end of their block, and sibling
; blocks may reuse names.

task main()
    when true
        fixed y = 1
        show(y)
    else
        fixed y = 2
        show(y)
    fi

    when false
        fixed y = "unused"
        show(y)
    else
        fixed y = 3
        show(y)
    fi

    each i in 0..3
        fixed square = i * i
        show(square)
    fi
    each i in 0..1
        show(i)
    fi

    flex n = 0
    loop n < 2
        fixed step = 1
        n = n + step
    fi
    show(n)
fi
