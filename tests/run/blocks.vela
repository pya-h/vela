; A block of its own, `block … fi`: what it declares, its names and regions,
; ends at its `fi`, so a region closes there, and the files opened in it with
; it, though the task goes on.

include std/files {File, FileMode, FileError}

; A block whose every path sends counts as sending.
task sign(n: int) -> int
    block
        when n < 0
            <- -1
        fi
        <- 1
    fi
fi

; A result set inside a block is set after it.
task halves(n: int) -> half: int, rest: int
    block
        half <- n / 2
        rest <- n - n / 2
    fi
fi

task main()
    hold total = 0
    block
        hold step = 2
        total = total + step
    fi
    ; Another block may use the same name for something else.
    block
        bind step = "three"
        total = total + step.len
    fi
    show(total, " ", sign(-3), " ", sign(4))
    bind half, rest = halves(7)
    show(half, " ", rest)

    ; Blocks nest, each with a default region of its own, and one in a loop
    ; starts again each round.
    each i in 0..3
        block
            region r default
            bind kept = new int(i * 10)
            block
                region inner default
                bind more = new int(kept^ + 1)
                total = total + more^
            fi
        fi
    fi
    show(total)

    ; A reference made in a block names its place until the block ends.
    block
        hold& t = &total
        t = 0
    fi
    show(total)

    ; A file opened in a block's region is closed at its fi.
    hold notes = File { path: "notes.txt" }
    block
        region r
        notes.open(FileMode.Read) at r { failure e
            show("could not open notes.txt")
            <-
        }
        show(notes.line() at r { "" } { "" })
    fi
    region later
    bind after = notes.line() at later { failure e
        show("closed at the block's fi")
        none
    }
    show(after { "(nothing read)" })
    ; And so it opens again.
    block
        region r
        notes.open(FileMode.Read) at r { <- }
        show(notes.line() at r { "" } { "" })
    fi
fi
