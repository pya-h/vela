# Arrays: `[type; count]` values held in place, copied whole. Literals list
# their values or repeat one; `xs[i]` reads and writes an item, `xs.len` is the
# count, and `each` goes through the items.

shape Point
    x: int
    y: int
fi

shape Polygon
    corners: [Point; 3]
    name: text
fi

kind Reading
    Missing
    Samples(values: [float; 2])
fi

task total(xs: [int; 4]) -> int
    hold sum = 0
    each x in xs
        sum = sum + x
    fi
    <- sum
fi

task halves(xs: [int; 4]) -> [int; 2], [int; 2]
    <- [xs[0], xs[1]], [xs[2], xs[3]]
fi

task parse(word: text) -> int or text
    when word == "one"
        <- 1
    fi
    <- fail "not a number"
fi

task main()
    bind scores: [int; 4] = [90, 72, 85, 60]
    show(scores.len)
    show(scores[2])
    show(total(scores))

    # An array is a value: assigning copies it.
    hold copy = scores
    copy[0] = 0
    show(scores[0])
    show(copy[0])

    # Repeated values, nested arrays, and a count computed from constants.
    hold grid = [[0; 3]; 2 * 1]
    grid[1][2] = 5
    each row in grid
        each cell in row
            show(cell)
        fi
    fi

    # `each` goes through the array as it was when the loop started.
    hold numbers = [1, 2, 3]
    each n in numbers
        numbers[2] = 30
        show(n)
    fi
    show(numbers[2])

    # Items that are shapes, and arrays in shapes, kinds, and results.
    hold triangle = Polygon { corners: [Point { x: 0, y: 0 }; 3], name: "t" }
    triangle.corners[1].x = 4
    triangle.corners[2] = Point { x: 0, y: 3 }
    show(triangle.corners[1].x + triangle.corners[2].y)
    bind reading = Samples([0.5, 1.5])
    match reading
    case Missing
        show(0.0)
    case Samples values
        show(values[0] + values[1])
    fi
    bind front, back = halves(scores)
    show(front[1] + back[0])

    # `none` and `fail e` make the items a `maybe` or a `T or E`.
    bind slots = [none, 7, none]
    show(slots[0])
    show(slots[1])
    bind empty: [maybe text; 2] = [none; 2]
    show(empty[1])
    bind parsed = [parse("one"), fail "skipped"]
    show(parsed[0] { 0 })
    show(parsed[1] { fail problem
        show(problem)
        -1
    })
    hold kept: maybe [int; 2] = none
    kept = [3, 4]
    when kept is {pair}
        show(pair.len + pair[1])
    fi

    # The index is computed first, then the value; a plan B runs in its turn.
    hold order = [10, 20, 30]
    hold missing: maybe int = none
    order[missing { 2 }] = order[missing { 0 }] + 1
    show(order[2])
    show([4, 5, 6][1])
fi
