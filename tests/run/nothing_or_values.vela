; A `nothing ~ E` is a value too: it can be bound, held, stored in a field, and
; passed to a task, and `case {_}` matches its success.

shape Saved
    result: nothing ~ text
fi

task save(n: int) -> nothing ~ text
    when n > 1
        <- fail "big"
    fi
fi

task take(x: nothing ~ text) -> int
    match x
    case {_}
        <- 1
    case failure e
        show(e)
        <- 2
    fi
fi

task main()
    fixed x = save(5)
    show(take(x))
    fixed s = Saved { result: save(0) }
    show(take(s.result))
    flex y: nothing ~ text = save(0)
    y = fail "z"
    show(take(y))
fi
