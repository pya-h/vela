; A plan B with a region of its own runs, and frees it, on every pass of a
; loop condition, and not at all when `and` doesn't need its value.

task main()
    flex count = 0
    fixed m: maybe int = none
    loop m {
        region r
        fixed p = new int(count) at r
        p^
    } < 3
        count = count + 1
    fi
    show(count)

    fixed b: maybe bool = none
    show(false and b {
        region unused
        fixed flag = new bool(true) at unused
        show("not shown")
        flag^
    })
fi
