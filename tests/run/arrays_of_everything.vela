; Arrays returned from tasks and indexed directly, arrays of shapes, kinds,
; pointers into a region, and text, and an array boxed in a region.

shape Point
    x: int
    y: int
fi

shape Node
    value: int
    next: maybe ^Node
fi

kind Light
    Red
    Dimmed(level: int)
fi

task make() -> [int#3]
    <- [1, 2, 3]
fi

task main()
    hold xs = make()
    xs[0] = 10
    show(xs[0] + make()[0])

    bind points = [Point { x: 1, y: 2 }, Point { x: 3, y: 4 }]
    each p in points
        show(p.x * p.y)
    fi

    bind lights = [Red, Dimmed(5), Light.Dimmed(7)]
    each l in lights
        match l
        case Red
            show("red")
        case Dimmed level
            show(level)
        fi
    fi

    region r
    bind a = new Node(Node { value: 1, next: none }) at r
    bind b = new Node(Node { value: 2, next: a }) at r
    hold ptrs: [^Node#3]@r = [a, b, a]
    ptrs[2] = b
    each p in ptrs
        show(p^.value)
    fi
    bind boxed = new [^Node#3](ptrs) at r
    show(boxed^[1]^.next { a }^.value)

    hold words: [text#2] = ["a", "b"]
    words[1] = "c"
    show(words[1])
fi
