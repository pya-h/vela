; A shape's shared field is one value for the whole program, never part of a
; value: it is read and changed through the shape's name, `Point.made`.

include shared_fields/tally

kind Mood
    Calm
    Loud
fi

shape Spot
    x: int
    y: int

    alters move(by: int)
        .x = .x + by
    fi
fi

shape Point
    x: int
    ; A field may fall back on a shared field that never changes.
    y: int = Point.start
    shared start: int = 7
    shared name: text = "point"
    ; A shared field's first value may name the shared fields above it.
    shared corners: [int#3] = [Point.start, 2, 3]
    shared pair: (int, text) = (1, "one")
    shared mood: Mood = Mood.Loud
    shared spare: maybe int = none
    shared flex made: int = 0
    shared read seen: int = 0
    shared flex origin: Spot = Spot { x: 0, y: 0 }
    shared flex big: [int#20] = [0#20]

    alters look()
        Point.seen = Point.seen + 1
        .x = .x + Point.start
    fi
fi

; Another shape's first value may name these too.
shape Grid
    shared flex side: int = Point.start
fi

task bump(flex& n: int)
    n = n + 1
fi

; Point.big is large, so it is given by a hidden pointer where it is a place that
; only the task changes; a shared field is not, so the task gets a copy.
task first_after_change(values: [int#20]) -> int
    Point.big[0] = 99
    <- values[0]
fi

task main()
    show(Point.start, " ", Point.name, " ", Point.corners[0], Point.corners[1], Point.corners[2])
    show(Point.pair.1, " ", Point.spare {-1})
    when Point.mood is Loud
        show("loud")
    fi

    ; Changed through its name, given to a flex& parameter, and through a reference.
    Point.made = Point.made + 1
    bump(&Point.made)
    flex& r = &Point.made
    r = r * 10
    show(Point.made)
    fixed& seen_now = &Point.seen

    ; A method changes a read-only shared field of its own shape.
    flex p = Point { x: 1 }
    p.look()
    p.look()
    show(p.x, " ", p.y, " ", Point.seen, " ", seen_now)

    ; A shared value that is a shape: its fields and its methods.
    Point.origin.move(5)
    Point.origin.y = 2
    show(Point.origin.x, Point.origin.y)

    ; An item of a shared array, and a copy of it given to a task.
    Point.big[0] = 1
    show(first_after_change(Point.big), " ", Point.big[0])

    Grid.side = Grid.side + 1
    show(Grid.side)

    ; In loops and conditions, read again each round.
    loop Point.made < 23
        Point.made = Point.made + 1
    fi
    when Point.made == 23 and Point.start > 0
        show("made ", Point.made)
    fi

    ; Another file's shared fields, read and changed as that file allows.
    flex t = tally.Tally {}
    t.tick()
    t.tick()
    tally.Tally.limit = tally.Tally.limit + 1
    show(tally.Tally.made, " ", tally.Tally.limit, " ", t.n, " ", t.reveal(), " ", t.reveal())
fi
