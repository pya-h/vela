# Pointers live in regions: `new` allocates in one (written `new T(v) in r`
# or `new@r T(v)`), `^` reads and writes through the pointer, and the region
# frees everything in it when its block closes.

shape Point
    x: int
    y: int
fi

task main()
    region r
    bind n: ^int@r = new int(42) in r
    show(n^)
    n^ = n^ + 1
    show(n^)

    bind p = new@r Point(Point { x: 3, y: 4 })
    show(p^.x * p^.y)
fi
