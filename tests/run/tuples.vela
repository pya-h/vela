# Tuples: `(int, text)` holds two or more values, read by position as `t.0`,
# `t.1`. Their items never change; a `hold` tuple takes a whole new tuple.
# Names unpack a tuple, with or without parentheses, and nested parts in
# parentheses. Several results (`-> int, int`) stay separate from tuples.

shape Point
    x: int
    y: int
fi

kind Grade
    Pass(mark: int)
    Fail
fi

task divide(a: int, b: int) -> (int, int)
    <- (a / b, a % b)
fi

task divmod(a: int, b: int) -> int, int
    <- a / b, a % b
fi

# A tuple holding text of the caller's region.
task tagged(r: region, line: text@r) -> (text@r, int)
    <- (line, 7)
fi

# A tuple whose text is all in one region, written once.
task first_two(names: [text]@r) -> (text, text)@r
    <- (names[0], names[1])
fi

task main()
    region r
    bind pair: (text, int) = ("Ada", 36)
    show(pair.0)
    show(pair.1)

    # Nested tuples, a whole new value for a hold tuple, and items that can't change.
    hold t = (1, (2.5, "deep"))
    show(t.1.1)
    t = (2, (3.5, "other"))
    show(t.1.0)
    show(t.0)

    # Unpacking: a list of names, parentheses, nested parts, and `_`.
    bind q, rest = divide(17, 5)
    show(q * 10 + rest)
    bind (a, b) = divide(20, 6)
    show(a * 10 + b)
    bind first, (second, third) = t
    show(first)
    show(second)
    show(third)
    bind _, (_, only) = t
    show(only)
    bind (_, (_, _)) = t
    (_, _) = divide(1, 1)
    bind typed: int, (half: float, label: text) = t
    show(typed)
    show(half)
    show(label)

    # Several results are received as before, and can be put in a tuple.
    bind whole, left = divmod(9, 4)
    bind packed = (whole, left)
    show(packed.0 + packed.1)

    # Assignment into hold variables: with or without parentheses, nested.
    hold x = 0
    hold y = 0
    x, y = divide(9, 4)
    show(x * 10 + y)
    (y, x) = (x, y)
    show(y * 10 + x)
    hold word = ""
    hold number = 0.0
    _, (number, word) = t
    show(word)
    show(number)

    # Values that can't change as items: a shape, a kind, maybe, and T or E.
    bind mixed: (Point, Grade, maybe text, int or text) = (Point { x: 3, y: 4 }, Pass(90), none, 5)
    show(mixed.0.x + mixed.0.y)
    match mixed.1
        case Pass mark
            show(mark)
        case Fail
            show("fail")
    fi
    show(mixed.2 == none)
    show(mixed.3 { 0 })

    # Tuples in a slice, behind a pointer, and in a maybe.
    hold scores = new [(text, int)]() at r
    scores.add(("Ada", 90))
    scores.add(("Bob", 75))
    each score in scores
        show(score.0)
    fi
    scores[1] = ("Cy", 80)
    show(scores[1].1)
    bind boxed = new (int, int)((5, 6)) at r
    show(boxed^.1)
    boxed^ = (7, 8)
    show(boxed^.0)
    bind found: maybe (int, text) = (1, "one")
    bind (id, name) = found { (0, "none") }
    show(id)
    show(name)

    # Equality, item by item, text by its characters.
    show((1, "a") == (1, "a"))
    show((1, (2.5, "a")) != (1, (2.5, "b")))
    show(pair == ("Ada", 36))

    # Text of a region in a tuple.
    bind line = scan("") at r { "none" }
    bind held = tagged(r, line)
    show(held.0)
    show(held.1)
    hold names = new [text]() at r
    names.add(line)
    names.add("second")
    bind (one, two) = first_two(names)
    show(one)
    show(two)
    bind kept = held.copy() at r
    show(kept.0 == held.0)
fi
