; Tuples: `(int, text)` holds two or more values, read by position as `t.0`,
; `t.1`. Their items never change; a `flex` tuple takes a whole new tuple.
; Names unpack a tuple, with or without parentheses, and nested parts in
; parentheses. Several results (`-> int, int`) stay separate from tuples.

shape Point
    x: int
    y: int
fi

kind Grade
    Pass(mark: int)
    Fail
fi

kind Score
    Mark(points: int, note: text)
    Missing
fi

task parsed(n: int) -> (int, int) ~ (text, int)
    when n < 0
        <- fail ("negative", n)
    fi
    <- (n, n * 2)
fi

task divide(a: int, b: int) -> (int, int)
    <- (a / b, a % b)
fi

task divmod(a: int, b: int) -> int, int
    <- a / b, a % b
fi

; A tuple holding text of the caller's region.
task tagged(r: region, line: text@r) -> (text@r, int)
    <- (line, 7)
fi

; A tuple whose text is all in one region, written once.
task first_two(names: [text]@r) -> (text, text)@r
    <- (names[0], names[1])
fi

; A tuple in a region, written on the whole and on an item: the same region.
task label(t: (int, text@r)@r) -> text@r
    <- t.1
fi

; A tuple's items always match, so this block always runs and always sends.
task total(t: (int, (int, int))) -> sum: int
    when t is (first, (second, third))
        sum <- first + second + third
    fi
fi

task main()
    region r
    fixed pair: (text, int) = ("Ada", 36)
    show(pair.0)
    show(pair.1)

    ; Nested tuples, a whole new value for a flex tuple, and items that can't change.
    flex t = (1, (2.5, "deep"))
    show(t.1.1)
    t = (2, (3.5, "other"))
    show(t.1.0)
    show(t.0)

    ; Unpacking: a list of names, parentheses, nested parts, and `_`.
    fixed q, rest = divide(17, 5)
    show(q * 10 + rest)
    fixed (a, b) = divide(20, 6)
    show(a * 10 + b)
    fixed first, (second, third) = t
    show(first)
    show(second)
    show(third)
    fixed _, (_, only) = t
    show(only)
    fixed (_, (_, _)) = t
    (_, _) = divide(1, 1)
    fixed typed: int, (half: float, label: text) = t
    show(typed)
    show(half)
    show(label)

    ; Several results are received as before, and can be put in a tuple.
    fixed whole, left = divmod(9, 4)
    fixed packed = (whole, left)
    show(packed.0 + packed.1)

    ; Assignment into flex variables: with or without parentheses, nested.
    flex x = 0
    flex y = 0
    x, y = divide(9, 4)
    show(x * 10 + y)
    (y, x) = (x, y)
    show(y * 10 + x)
    flex word = ""
    flex number = 0.0
    _, (number, word) = t
    show(word)
    show(number)

    ; Values that can't change as items: a shape, a kind, maybe, and T ~ E.
    fixed grade = Mark(45, "ok")
    fixed mixed: (Point, Grade, maybe text, int ~ text) = (Point { x: 3, y: 4 }, Pass(90), none, 5)
    show(mixed.0.x + mixed.0.y)
    match mixed.1
        case Pass mark
            show(mark)
        case Fail
            show("fail")
    fi
    show(mixed.2 == none)
    show(mixed.3 { 0 })

    ; Tuples in a slice, behind a pointer, and in a maybe.
    flex scores = new [(text, int)]() at r
    scores.add(("Ada", 90))
    scores.add(("Bob", 75))
    each score in scores
        show(score.0)
    fi
    scores[1] = ("Cy", 80)
    show(scores[1].1)
    fixed boxed = new (int, int)((5, 6)) at r
    show(boxed^.1)
    boxed^ = (7, 8)
    show(boxed^.0)
    fixed found: maybe (int, text) = (1, "one")
    fixed (id, name) = found { (0, "none") }
    show(id)
    show(name)

    ; Similarity, item by item, text by its characters; '==' compares where
    ; two tuples are.
    show((1, "a") ~= (1, "a"))
    show((1, (2.5, "a")) <> (1, (2.5, "b")))
    show(pair ~= ("Ada", 36))
    show(pair == pair)

    ; Patterns: braces take the value out, parentheses take the tuple apart,
    ; and `flex` names can be assigned.
    fixed person: maybe (text, int) = ("Ada", 36)
    when person is {(who, years)}
        show(who)
        show(years)
    fi
    match parsed(4)
        case {(value, doubled)}
            show(value + doubled)
        case failure (reason, where_at)
            show(reason)
            show(where_at)
    fi
    match parsed(-2)
        case {(value, doubled)}
            show(value + doubled)
        case failure (reason, where_at)
            show(reason)
            show(where_at)
    fi
    when pair is (title, age)
        show(title)
        show(age)
    fi
    when pair is flex (name_held, age_held)
        name_held = "Cy"
        age_held = age_held + 1
        show(name_held)
        show(age_held)
    fi
    when pair is (_, _)
        show("dropped")
    fi
    show(total((1, (2, 3))))
    when person is {flex changing}
        changing = ("Bob", 1)
        show(changing.0)
    fi
    match grade
        case Mark flex points note
            points = points * 2
            show(points)
            show(note)
        case Missing
            show("missing")
    fi

    ; Text of a region in a tuple.
    fixed line = scan("") at r { "none" }
    fixed held = tagged(r, line)
    show(held.0)
    show(held.1)
    flex names = new [text]() at r
    names.add(line)
    names.add("second")
    fixed (one, two) = first_two(names)
    show(one)
    show(two)
    fixed kept = held.copy() at r
    show(kept.0 == held.0)
    fixed numbered = (held.1, held.0)
    show(label(numbered))
fi
