; The user's examples of what stays allowed with a fixed name, in the new words.
; Hole B is accepted: a flex owner may still change what a fixed name made of
; it sees. A value copied whole, a shape of an int and text, may be given to a
; flex name. And the general rule: what a task reads to make new data may be
; given to a flex name, while what it sends back of its parameter is only read.

shape Test
    n: int
    name: text
fi

task first_two(xs: [int]@r) -> [int]@r
    <- xs[0..2]
fi

task lengths(r: region, names: [text]@r) -> [int]@r
    flex out = new [int]() at r
    each name in names
        out.add(name.len)
    fi
    <- out
fi

task main()
    region r default

    ; Hole B: the owner changes what both see.
    flex ys = [1, 2, ...]
    fixed zs = ys
    ys[0] = 7
    show(zs)

    ; Copied whole, so the flex copy is a value of its own.
    fixed a = Test { n: 1, name: "a" }
    flex c = a
    c.n = 2
    c.name = "c"
    show(a.n, " ", a.name, " ", c.n, " ", c.name)

    ; Kept fixed, a part a task sends back is read; new data may change.
    fixed nums = [1, 2, 3, ...]
    fixed part = first_two(nums)
    fixed names = ["ada", "bo", ...]
    flex sizes = lengths(r, names)
    sizes[0] = 0
    show(part, " ", sizes, " ", nums)

    ; A fixed name made of a fresh value never changes.
    fixed fresh = [4, 5, ...]
    show(fresh)
fi
