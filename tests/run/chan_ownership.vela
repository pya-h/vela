; Channels transfer ownership of messages between concurrent tasks.
; Builtin operations: chan_new, dispatch, wait_and_receive, receive, close, .len, .cap

shape Packet
    id: int
    tag: text
fi

task main()
    region r default
    fixed c = chan_new<int>(4)
    show("cap: ", c.cap)
    show("initial len: ", c.len)

    show("dispatch 10: ", c.dispatch(10))
    show("dispatch 20: ", c.dispatch(20))
    show("len after 2: ", c.len)

    show("wait_and_receive 1: ", c.wait_and_receive())
    show("wait_and_receive 2: ", c.wait_and_receive())
    show("len after wait_and_receive: ", c.len)

    show("dispatch 30: ", c.dispatch(30))
    show("receive: ", c.receive())
    show("receive empty: ", c.receive())

    c.close()

    fixed q = chan_new<own Packet>(2)
    flex p = Packet { id: 101, tag: "hello" }
    dispatch(q, own p)

    p = Packet { id: 102, tag: "world" }
    show("reassigned p.id: ", p.id)
    dispatch(q, own p)

    fixed r1 = q.wait_and_receive()
    show("received r1 id: ", r1.id, " tag: ", r1.tag)
    fixed r2 = q.wait_and_receive()
    show("received r2 id: ", r2.id, " tag: ", r2.tag)
    q.close()
fi

