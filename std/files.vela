# std/files: files on the disk. A program brings it in with
# `include std/files {File, FileMode}`, or names it `files.File` after
# `include std/files`.

# How a file is opened.
kind FileMode
    # Read from its start; the file must be there.
    Read
    # Written from its start, emptied first, and made when it isn't there.
    Write
    # Written at its end, and made when it isn't there.
    Append
    # Read and written; the file must be there.
    ReadWrite
fi

# What a File says of itself, as its own methods left it. A region that ends
# closes a file opened in it, and a copy of a File can close it too, and neither
# can tell this File; its methods then find it closed (see `NotOpen`).
kind FileState
    # Made, and not opened yet.
    Idle
    Open
    Closed
    # Deleted.
    Gone
fi

# What went wrong.
kind FileError
    # There is no file at the path, or none that can be read.
    NotFound
    # The system doesn't let the program open the file so.
    NotAllowed
    # Opened again before it was closed.
    AlreadyOpen
    # Not open: never opened, closed, deleted, or closed by its region or a copy.
    NotOpen
    # Read when opened only to write, or written when opened only to read.
    WrongMode
    # Anything else the system reports.
    Failed
fi

# A file, named by its path. Making one opens nothing: a File is made, then
# asked about or opened, and only its own methods change what it says of
# itself. A file is opened in a region, which closes it when its block ends:
# `file.open(FileMode.Read) at r`.
shape File
    read path: text
    read state: FileState = FileState.Idle
    # How it was opened last; none before it is.
    read mode: maybe FileMode = none
    priv handle: int = -1

    # Opens the file as `mode` says, until `close()` or the end of `within`'s block.
    alters open(mode: FileMode, within: region) -> unit ~ FileError
        when is_open(.handle)
            <- fail FileError.AlreadyOpen
        fi
        bind got = open_handle(.path, mode_code(mode), within)
        when got < 0
            <- fail error_of(-got)
        fi
        .handle = got
        .state = FileState.Open
        .mode = mode
    fi

    # Closes the file. One its region or a copy closed is closed already.
    alters close() -> unit ~ FileError
        when not is_open(.handle)
            .left_closed()
            <- fail FileError.NotOpen
        fi
        bind status = close_handle(.handle)
        .handle = -1
        .state = FileState.Closed
        when status != 0
            <- fail error_of(status)
        fi
    fi

    # The rest of the file, from where reading is.
    read(into: region) -> text@into ~ FileError
        bind got = read_rest(.handle, into)
        when status() != 0
            <- fail error_of(status())
        fi
        <- got
    fi

    # The next line, without its line break; none at the end of the file.
    line(into: region) -> maybe text@into ~ FileError
        bind got = read_line(.handle, into)
        bind code = status()
        when code == ended_code()
            <- none
        fi
        when code != 0
            <- fail error_of(code)
        fi
        <- got
    fi

    # The rest of the file, line by line.
    lines(into: region) -> [text@into]@into ~ FileError
        hold all = new [text]() at into
        loop true
            bind got = read_line(.handle, into)
            bind code = status()
            when code == ended_code()
                <- all
            fi
            when code != 0
                <- fail error_of(code)
            fi
            all.add(got)
        fi
        <- all
    fi

    # Writes `t` where writing is.
    write(t: text@p) -> unit ~ FileError
        bind status = write_text(.handle, t)
        when status != 0
            <- fail error_of(status)
        fi
    fi

    # Whether nothing more can be read: at the end, or not open to read.
    ended() -> bool
        <- at_end(.handle)
    fi

    # How many bytes the file has: an open one as written so far.
    size() -> int ~ FileError
        bind got = size_of(.path, .handle)
        when got < 0
            <- fail error_of(-got)
        fi
        <- got
    fi

    # Whether a file that can be read is at the path.
    exists() -> bool
        <- path_exists(.path)
    fi

    # Gives the file another path, on the disk and here.
    alters rename(to: text@this) -> unit ~ FileError
        bind status = rename_path(.path, to)
        when status != 0
            <- fail error_of(status)
        fi
        .path = to
    fi

    # Deletes the file, closing it first when it is open.
    alters delete() -> unit ~ FileError
        when is_open(.handle)
            bind closed = close_handle(.handle)
            .handle = -1
            .state = FileState.Closed
            when closed != 0
                <- fail error_of(closed)
            fi
        fi
        bind status = remove_path(.path)
        when status != 0
            <- fail error_of(status)
        fi
        .handle = -1
        .state = FileState.Gone
    fi

    # The path, and what the File says of itself: `notes.txt (open)`.
    str(into: region) -> text@into
        bind said = match .state
        case Idle = "idle"
        case Open = "open"
        case Closed = "closed"
        case Gone = "gone"
        fi
        <- "{.path} ({said})" at into
    fi

    # A File that says it is open, whose file was closed by its region or a
    # copy, is closed.
    priv alters left_closed()
        match .state
        case Open
            .state = FileState.Closed
        case _
        fi
    fi
fi

# The status the runtime gives at the end of a file, which is no error.
priv task ended_code() -> int
    <- 7
fi

priv task mode_code(mode: FileMode) -> int
    <- match mode
    case Read = 0
    case Write = 1
    case Append = 2
    case ReadWrite = 3
    fi
fi

# The FileError a status of the runtime names (see `runtime/vela_rt.h`).
priv task error_of(status: int) -> FileError
    when status == 1
        <- FileError.NotFound
    else when status == 2
        <- FileError.NotAllowed
    else when status == 3
        <- FileError.AlreadyOpen
    else when status == 4
        <- FileError.NotOpen
    else when status == 5
        <- FileError.WrongMode
    fi
    <- FileError.Failed
fi

# The C the compiler writes for these is in `runtime/vela_rt.h`, and which one
# each is in `src/library.rs`.
priv native task path_exists(path: text@p) -> bool
priv native task open_handle(path: text@p, mode: int, within: region) -> int
priv native task is_open(handle: int) -> bool
priv native task close_handle(handle: int) -> int
priv native task read_rest(handle: int, into: region) -> text@into
priv native task read_line(handle: int, into: region) -> text@into
priv native task write_text(handle: int, t: text@p) -> int
priv native task at_end(handle: int) -> bool
priv native task size_of(path: text@p, handle: int) -> int
priv native task rename_path(from: text@p, to: text@q) -> int
priv native task remove_path(path: text@p) -> int
priv native task status() -> int
