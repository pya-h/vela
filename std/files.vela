; std/files: region-scoped file handles and disk I/O.

kind FileMode
    Read
    Write
    Append
    ReadWrite
fi

; Tracks operations called on this value; region cleanup or copies closing the handle do not update it.
kind FileState
    Idle
    Open
    Closed
    Gone
fi

kind FileError
    NotFound
    NotAllowed
    AlreadyOpen
    ; Also returned when a region or copy already closed the handle.
    NotOpen
    WrongMode
    Failed
fi

; Constructing a `File` does not open it; `open` ties handle cleanup to `within`'s region.
shape File
    read path: text
    read state: FileState = FileState.Idle
    read mode: maybe FileMode = none
    priv handle: int = -1

    alters open(mode: FileMode, within: region) -> nothing ~ FileError
        when is_open(.handle)
            <- fail FileError.AlreadyOpen
        fi
        fixed got = open_handle(.path, mode_code(mode), within)
        when got < 0
            <- fail error_of(-got)
        fi
        .handle = got
        .state = FileState.Open
        .mode = mode
    fi

    alters close() -> nothing ~ FileError
        when not is_open(.handle)
            .left_closed()
            <- fail FileError.NotOpen
        fi
        fixed status = close_handle(.handle)
        .handle = -1
        .state = FileState.Closed
        when status != 0
            <- fail error_of(status)
        fi
    fi

    read(into: region) -> text@into ~ FileError
        fixed got = read_rest(.handle, into)
        when status() != 0
            <- fail error_of(status())
        fi
        <- got
    fi

    ; Strips trailing newline; returns `none` at EOF.
    line(into: region) -> maybe text@into ~ FileError
        fixed got = read_line(.handle, into)
        fixed code = status()
        when code == ended_code()
            <- none
        fi
        when code != 0
            <- fail error_of(code)
        fi
        <- got
    fi

    lines(into: region) -> [text@into]@into ~ FileError
        flex all = new [text]() at into
        endless
            fixed got = read_line(.handle, into)
            fixed code = status()
            when code == ended_code()
                <- all
            fi
            when code != 0
                <- fail error_of(code)
            fi
            all.add(got)
        fi
        <- all
    fi

    write(t: text@p) -> nothing ~ FileError
        fixed status = write_text(.handle, t)
        when status != 0
            <- fail error_of(status)
        fi
    fi

    ended() -> bool
        <- at_end(.handle)
    fi

    size() -> int ~ FileError
        fixed got = size_of(.path, .handle)
        when got < 0
            <- fail error_of(-got)
        fi
        <- got
    fi

    exists() -> bool
        <- path_exists(.path)
    fi

    alters rename(to: text@this) -> nothing ~ FileError
        fixed status = rename_path(.path, to)
        when status != 0
            <- fail error_of(status)
        fi
        .path = to
    fi

    alters delete() -> nothing ~ FileError
        when is_open(.handle)
            fixed closed = close_handle(.handle)
            .handle = -1
            .state = FileState.Closed
            when closed != 0
                <- fail error_of(closed)
            fi
        fi
        fixed status = remove_path(.path)
        when status != 0
            <- fail error_of(status)
        fi
        .handle = -1
        .state = FileState.Gone
    fi

    str(into: region) -> text@into
        fixed said = match .state
        case Idle = "idle"
        case Open = "open"
        case Closed = "closed"
        case Gone = "gone"
        fi
        <- "{.path} ({said})" at into
    fi

    ; Syncs local `state` after a region or copy closes the handle.
    priv alters left_closed()
        match .state
        case Open
            .state = FileState.Closed
        case _
        fi
    fi
fi

; Sentinel code matching `runtime/vela_rt.h` EOF status.
priv task ended_code() -> int
    <- 7
fi

priv task mode_code(mode: FileMode) -> int
    <- match mode
    case Read = 0
    case Write = 1
    case Append = 2
    case ReadWrite = 3
    fi
fi

; Maps status codes from `runtime/vela_rt.h` to `FileError`.
priv task error_of(status: int) -> FileError
    when status == 1
        <- FileError.NotFound
    else when status == 2
        <- FileError.NotAllowed
    else when status == 3
        <- FileError.AlreadyOpen
    else when status == 4
        <- FileError.NotOpen
    else when status == 5
        <- FileError.WrongMode
    fi
    <- FileError.Failed
fi

priv native task path_exists(path: text@p) -> bool
priv native task open_handle(path: text@p, mode: int, within: region) -> int
priv native task is_open(handle: int) -> bool
priv native task close_handle(handle: int) -> int
priv native task read_rest(handle: int, into: region) -> text@into
priv native task read_line(handle: int, into: region) -> text@into
priv native task write_text(handle: int, t: text@p) -> int
priv native task at_end(handle: int) -> bool
priv native task size_of(path: text@p, handle: int) -> int
priv native task rename_path(from: text@p, to: text@q) -> int
priv native task remove_path(path: text@p) -> int
priv native task status() -> int
