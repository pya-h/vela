; std/math: math constants and `<math.h>` bindings (domain errors yield nan).

#P = 3.141592653589793

; `math.e ** x` lowers to `exp(x)`.
#e = 2.718281828459045

native task pow(x: float, y: float) -> float

native task sin(x: float) -> float

native task cos(x: float) -> float

native task tan(x: float) -> float

native task asin(x: float) -> float

native task acos(x: float) -> float

native task atan(x: float) -> float

native task sinh(x: float) -> float

native task cosh(x: float) -> float

native task tanh(x: float) -> float

native task exp(x: float) -> float

; Bases 2, 10, and `e` use dedicated exact routines.
native task log(x: float, base: float = 10.0) -> float

