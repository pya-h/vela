; std/loops: outcome error kind for value-producing loops.

; `B` comes from `break = v`; `M` comes from a final-line `fail LoopResult.Manual(m)` (`bool` for void loops).
kind LoopResult<B, M>
    ; Condition was false initially or the range was empty.
    Skipped
    Broke(value: maybe B)
    ; Final pass hit `continue` before reaching its last expression.
    EndedByContinue
    Manual(value: M)
fi
