; std/collections: tasks over a slice's items, written to be read in a pipe,
; `nums |> filter(n -> n > 2) at r |> map(n -> n * 10) at r`. Each takes the
; slice first, then what it does with an item, then the region a new slice
; goes in, last, so `at r` gives it. A program brings them in with
; `include std/collections (map, filter)`, or names `collections.map(…)` after
; `include std/collections`. Every step goes through all the items and makes
; its slice at once; `take` and `skip` make none, as they are views.

; A new slice in `r` of what `f` gives for each item, in order.
task map<T, R>(xs: [T]@a, f: (T) -> R, r: region) -> [R]@r
    flex made = new [R]() at r
    each x in xs
        made.add(f(x))
    fi
    <- made
fi

; A new slice in `r` of the items `keep` holds for, in order.
task filter<T>(xs: [T]@a, keep: (T) -> bool, r: region) -> [T]@r
    flex made = new [T]() at r
    each x in xs
        when keep(x)
            made.add(x)
        fi
    fi
    <- made
fi

; `initial`, then what `step` gives for it and the first item, then for that
; and the second, and so on: `fold(xs, 0, (sum, n) -> sum + n)` adds them up.
task fold<T, A>(xs: [T]@a, initial: A, step: (A, T) -> A) -> A
    flex done = initial
    each x in xs
        done = step(done, x)
    fi
    <- done
fi

; A new slice in `r` of pairs, an item of `xs` with the item of `ys` at the
; same place, as long as the shorter of the two.
task zip<A: frozen, B: frozen>(xs: [A]@a, ys: [B]@b, r: region) -> [(A, B)]@r
    flex made = new [(A, B)]() at r
    loop flex i = 0 || i < xs.len and i < ys.len || i++
        made.add((xs[i], ys[i]))
    fi
    <- made
fi

; A new slice in `r` of each item with its place, from 0: `(0, first)`,
; `(1, second)`, and so on.
task enumerate<T: frozen>(xs: [T]@a, r: region) -> [(int, T)]@r
    flex made = new [(int, T)]() at r
    flex i = 0
    each x in xs
        made.add((i, x))
        i++
    fi
    <- made
fi

; The first `n` items, a view of the same slice: all of them when it has
; fewer, none when `n` is below 1.
task take<T>(xs: [T]@a, n: int) -> [T]@a
    <- xs[0..within(n, xs.len)]
fi

; The items after the first `n`, a view of the same slice: none when it has
; `n` or fewer, all of them when `n` is below 1.
task skip<T>(xs: [T]@a, n: int) -> [T]@a
    <- xs[within(n, xs.len)..xs.len]
fi

; The first item `test` holds for, or none.
task find<T>(xs: [T]@a, test: (T) -> bool) -> maybe T
    each x in xs
        when test(x)
            <- x
        fi
    fi
    <- none
fi

; Whether `test` holds for every item; true for no items.
task all<T>(xs: [T]@a, test: (T) -> bool) -> bool
    each x in xs
        when not test(x)
            <- false
        fi
    fi
    <- true
fi

; Whether `test` holds for some item; false for no items.
task any<T>(xs: [T]@a, test: (T) -> bool) -> bool
    each x in xs
        when test(x)
            <- true
        fi
    fi
    <- false
fi

; `n` brought within 0 to `count`.
priv task within(n: int, count: int) -> int
    when n < 0
        <- 0
    else when n > count
        <- count
    fi
    <- n
fi
