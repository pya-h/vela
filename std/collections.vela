; std/collections: lazy `Iterator` adapters and eager slice tasks.

shape Pair<A, B>
    first: A
    second: B
fi

shape Indexed<T>
    index: int
    item: T
fi

pattern Iterator<T>
    ; Marked `alters` because advancing consumes the iterator; consumers also require a mutable place.
    alters next() -> maybe T

    map<R>(f: [@this](T) -> R) -> MapIter<this, T, R>@this
        <- MapIter { inner: .this, f: f }
    fi

    filter(keep: [@this](T) -> bool) -> FilterIter<this, T>@this
        <- FilterIter { inner: .this, keep: keep }
    fi

    take(n: int) -> TakeIter<this, T>@this
        <- TakeIter<this, T> { inner: .this, left: n }
    fi

    skip(n: int) -> SkipIter<this, T>@this
        <- SkipIter<this, T> { inner: .this, left: n }
    fi

    enumerate() -> EnumerateIter<this, T>@this
        <- EnumerateIter<this, T> { inner: .this, place: 0 }
    fi

    ; Slices passed for `other` auto-wrap into `SliceIter`.
    zip<U: Iterator<V>, V>(other: U) -> ZipIter<this, T, U, V>@this
        <- ZipIter<this, T, U, V> { first: .this, second: other }
    fi

    alters collect(r: region) -> [T]@r
        flex made = new [T]() at r
        endless
            fixed item = .next() { break }
            made.add(item)
        fi
        <- made
    fi

    alters fold<A>(initial: A, step: [@q](A, T) -> A) -> A
        flex done = initial
        endless
            fixed item = .next() { break }
            done = step(done, item)
        fi
        <- done
    fi

    alters find(test: [@q](T) -> bool) -> maybe T
        endless
            fixed item = .next() { <- none }
            when test(item)
                <- item
            fi
        fi
        <- none
    fi

    alters all(test: [@q](T) -> bool) -> bool
        endless
            fixed item = .next() { break }
            when not test(item)
                <- false
            fi
        fi
        <- true
    fi

    alters any(test: [@q](T) -> bool) -> bool
        endless
            fixed item = .next() { break }
            when test(item)
                <- true
            fi
        fi
        <- false
    fi
fi

shape MapIter<I: Iterator<T>, T, R>::Iterator<R>
    inner: I
    f: [@this](T) -> R

    alters next() -> maybe R
        fixed item = .inner.next() { <- none }
        <- .f(item)
    fi
fi

shape FilterIter<I: Iterator<T>, T>::Iterator<T>
    inner: I
    keep: [@this](T) -> bool

    alters next() -> maybe T
        endless
            fixed item = .inner.next() { <- none }
            when .keep(item)
                <- item
            fi
        fi
    fi
fi

shape TakeIter<I: Iterator<T>, T>::Iterator<T>
    inner: I
    left: int

    alters next() -> maybe T
        when .left <= 0
            <- none
        fi
        .left--
        <- .inner.next() { <- none }
    fi
fi

shape SkipIter<I: Iterator<T>, T>::Iterator<T>
    inner: I
    left: int

    alters next() -> maybe T
        loop .left > 0
            .left--
            fixed _ = .inner.next() { <- none }
        fi
        <- .inner.next() { <- none }
    fi
fi

shape EnumerateIter<I: Iterator<T>, T>::Iterator<Indexed<T>@this>
    inner: I
    place: int

    alters next() -> maybe Indexed<T>@this
        fixed item = .inner.next() { <- none }
        fixed res = Indexed { index: .place, item: item }
        .place++
        <- res
    fi
fi

shape ZipIter<A: Iterator<T>, T, B: Iterator<V>, V>::Iterator<Pair<T, V>@this>
    first: A
    second: B

    alters next() -> maybe Pair<T, V>@this
        fixed a = .first.next() { <- none }
        fixed b = .second.next() { <- none }
        <- Pair { first: a, second: b }
    fi
fi

; Backing iterator synthesized by the compiler for slice adapter chains.
shape SliceIter<T>::Iterator<T>
    items: [T]
    place: int

    alters next() -> maybe T
        when .place >= .items.len
            <- none
        fi
        fixed item = .items[.place]
        .place++
        <- item
    fi
fi

task map<T, R>(xs: [T]@a, f: (T) -> R, r: region) -> [R]@r
    flex made = new [R]() at r
    each x in xs
        made.add(f(x))
    fi
    <- made
fi

task filter<T>(xs: [T]@a, keep: (T) -> bool, r: region) -> [T]@r
    flex made = new [T]() at r
    each x in xs
        when keep(x)
            made.add(x)
        fi
    fi
    <- made
fi

task fold<T, A>(xs: [T]@a, initial: A, step: (A, T) -> A) -> A
    flex done = initial
    each x in xs
        done = step(done, x)
    fi
    <- done
fi

task zip<A: frozen, B: frozen>(xs: [A]@a, ys: [B]@b, r: region) -> [(A, B)]@r
    flex made = new [(A, B)]() at r
    loop flex i = 0 || i < xs.len and i < ys.len || i++
        made.add((xs[i], ys[i]))
    fi
    <- made
fi

task enumerate<T: frozen>(xs: [T]@a, r: region) -> [(int, T)]@r
    flex made = new [(int, T)]() at r
    flex i = 0
    each x in xs
        made.add((i, x))
        i++
    fi
    <- made
fi

; Zero-copy view; clamps out-of-range `n`.
task take<T>(xs: [T]@a, n: int) -> [T]@a
    <- xs[0..within(n, xs.len)]
fi

; Zero-copy view; clamps out-of-range `n`.
task skip<T>(xs: [T]@a, n: int) -> [T]@a
    <- xs[within(n, xs.len)..xs.len]
fi

task find<T>(xs: [T]@a, test: (T) -> bool) -> maybe T
    each x in xs
        when test(x)
            <- x
        fi
    fi
    <- none
fi

task all<T>(xs: [T]@a, test: (T) -> bool) -> bool
    each x in xs
        when not test(x)
            <- false
        fi
    fi
    <- true
fi

task any<T>(xs: [T]@a, test: (T) -> bool) -> bool
    each x in xs
        when test(x)
            <- true
        fi
    fi
    <- false
fi

priv task within(n: int, count: int) -> int
    when n < 0
        <- 0
    else when n > count
        <- count
    fi
    <- n
fi
