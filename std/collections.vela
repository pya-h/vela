; std/collections: lazy `Iterator` adapters and eager slice tasks.

shape Pair<A, B>
    first: A
    second: B
fi

shape Indexed<T>
    index: int
    item: T
fi

pattern Iterator<T>
    ; Marked `alters` because advancing consumes the iterator; consumers also require a mutable place.
    alters next() -> maybe T

    map<R>(f: [@this](T) -> R) -> MapIter<this, T, R>@this
        <- MapIter { inner: .this, f: f }
    fi

    filter(keep: [@this](T) -> bool) -> FilterIter<this, T>@this
        <- FilterIter { inner: .this, keep: keep }
    fi

    take(n: int) -> TakeIter<this, T>@this
        <- TakeIter<this, T> { inner: .this, left: n }
    fi

    skip(n: int) -> SkipIter<this, T>@this
        <- SkipIter<this, T> { inner: .this, left: n }
    fi

    enumerate() -> EnumerateIter<this, T>@this
        <- EnumerateIter<this, T> { inner: .this, place: 0 }
    fi

    ; Slices passed for `other` auto-wrap into `SliceIter`.
    zip<U: Iterator<V>, V>(other: U) -> ZipIter<this, T, U, V>@this
        <- ZipIter<this, T, U, V> { first: .this, second: other }
    fi

    alters collect(r: region) -> [T]@r
        flex made = new [T]() at r
        endless
            fixed item = .next() { break }
            made.add(item)
        fi
        <- made
    fi

    alters fold<A>(initial: A, step: [@q](A, T) -> A) -> A
        flex done = initial
        endless
            fixed item = .next() { break }
            done = step(done, item)
        fi
        <- done
    fi

    alters find(test: [@q](T) -> bool) -> maybe T
        endless
            fixed item = .next() { <- none }
            when test(item)
                <- item
            fi
        fi
        <- none
    fi

    alters all(test: [@q](T) -> bool) -> bool
        endless
            fixed item = .next() { break }
            when not test(item)
                <- false
            fi
        fi
        <- true
    fi

    alters any(test: [@q](T) -> bool) -> bool
        endless
            fixed item = .next() { break }
            when test(item)
                <- true
            fi
        fi
        <- false
    fi
fi

shape MapIter<I: Iterator<T>, T, R>::Iterator<R>
    inner: I
    f: [@this](T) -> R

    alters next() -> maybe R
        fixed item = .inner.next() { <- none }
        <- .f(item)
    fi
fi

shape FilterIter<I: Iterator<T>, T>::Iterator<T>
    inner: I
    keep: [@this](T) -> bool

    alters next() -> maybe T
        endless
            fixed item = .inner.next() { <- none }
            when .keep(item)
                <- item
            fi
        fi
    fi
fi

shape TakeIter<I: Iterator<T>, T>::Iterator<T>
    inner: I
    left: int

    alters next() -> maybe T
        when .left <= 0
            <- none
        fi
        .left--
        <- .inner.next() { <- none }
    fi
fi

shape SkipIter<I: Iterator<T>, T>::Iterator<T>
    inner: I
    left: int

    alters next() -> maybe T
        loop .left > 0
            .left--
            fixed _ = .inner.next() { <- none }
        fi
        <- .inner.next() { <- none }
    fi
fi

shape EnumerateIter<I: Iterator<T>, T>::Iterator<Indexed<T>@this>
    inner: I
    place: int

    alters next() -> maybe Indexed<T>@this
        fixed item = .inner.next() { <- none }
        fixed res = Indexed { index: .place, item: item }
        .place++
        <- res
    fi
fi

shape ZipIter<A: Iterator<T>, T, B: Iterator<V>, V>::Iterator<Pair<T, V>@this>
    first: A
    second: B

    alters next() -> maybe Pair<T, V>@this
        fixed a = .first.next() { <- none }
        fixed b = .second.next() { <- none }
        <- Pair { first: a, second: b }
    fi
fi

; Backing iterator synthesized by the compiler for slice adapter chains.
shape SliceIter<T>::Iterator<T>
    items: [T]
    place: int

    alters next() -> maybe T
        when .place >= .items.len
            <- none
        fi
        fixed item = .items[.place]
        .place++
        <- item
    fi
fi

task map<T, R>(xs: [T]@a, f: (T) -> R, r: region) -> [R]@r
    flex made = new [R]() at r
    each x in xs
        made.add(f(x))
    fi
    <- made
fi

task filter<T>(xs: [T]@a, keep: (T) -> bool, r: region) -> [T]@r
    flex made = new [T]() at r
    each x in xs
        when keep(x)
            made.add(x)
        fi
    fi
    <- made
fi

task fold<T, A>(xs: [T]@a, initial: A, step: (A, T) -> A) -> A
    flex done = initial
    each x in xs
        done = step(done, x)
    fi
    <- done
fi

task zip<A: frozen, B: frozen>(xs: [A]@a, ys: [B]@b, r: region) -> [(A, B)]@r
    flex made = new [(A, B)]() at r
    loop flex i = 0 || i < xs.len and i < ys.len || i++
        made.add((xs[i], ys[i]))
    fi
    <- made
fi

task enumerate<T: frozen>(xs: [T]@a, r: region) -> [(int, T)]@r
    flex made = new [(int, T)]() at r
    flex i = 0
    each x in xs
        made.add((i, x))
        i++
    fi
    <- made
fi

; Zero-copy view; clamps out-of-range `n`.
task take<T>(xs: [T]@a, n: int) -> [T]@a
    <- xs[0..within(n, xs.len)]
fi

; Zero-copy view; clamps out-of-range `n`.
task skip<T>(xs: [T]@a, n: int) -> [T]@a
    <- xs[within(n, xs.len)..xs.len]
fi

task find<T>(xs: [T]@a, test: (T) -> bool) -> maybe T
    each x in xs
        when test(x)
            <- x
        fi
    fi
    <- none
fi

task all<T>(xs: [T]@a, test: (T) -> bool) -> bool
    each x in xs
        when not test(x)
            <- false
        fi
    fi
    <- true
fi

task any<T>(xs: [T]@a, test: (T) -> bool) -> bool
    each x in xs
        when test(x)
            <- true
        fi
    fi
    <- false
fi

task sort<T: ordered>(flex xs: [T]@a)
    when xs.len <= 1
        <-
    fi
    introsort_range(xs, 0, xs.len - 1, depth_limit(xs.len))
fi

task sort_by<T>(flex xs: [T]@a, cmp: (T, T) -> int)
    when xs.len <= 1
        <-
    fi
    introsort_by_range(xs, 0, xs.len - 1, cmp, depth_limit(xs.len))
fi

task sorted<T: frozen>(xs: [T]@a, cmp: (T, T) -> int, r: region default) -> [T]@r
    flex copy = new [T]() at r
    each x in xs
        copy.add(x)
    fi
    sort_by(copy, cmp)
    <- copy
fi

task reverse<T>(flex xs: [T]@a)
    flex i = 0
    flex j = xs.len - 1
    loop i < j
        xs[i], xs[j] = xs[j], xs[i]
        i++
        j--
    fi
fi

task reversed<T: frozen>(xs: [T]@a, r: region default) -> [T]@r
    flex copy = new [T]() at r
    flex i = xs.len - 1
    loop i >= 0
        copy.add(xs[i])
        i--
    fi
    <- copy
fi

task binary_search<T>(xs: [T]@a, target: T, cmp: (T, T) -> int) -> maybe int
    flex low = 0
    flex high = xs.len - 1
    loop low <= high
        fixed mid = low + (high - low) / 2
        fixed c = cmp(xs[mid], target)
        when c == 0
            <- mid
        else when c < 0
            low = mid + 1
        else
            high = mid - 1
        fi
    fi
    <- none
fi

task contains<T: same>(xs: [T]@a, target: T) -> bool
    each item in xs
        when item == target
            <- true
        fi
    fi
    <- false
fi

task index_of<T: same>(xs: [T]@a, target: T) -> maybe int
    each i, item in xs
        when item == target
            <- i
        fi
    fi
    <- none
fi

priv task depth_limit(n: int) -> int
    flex limit = 0
    flex m = n
    loop m > 1
        m = m / 2
        limit += 2
    fi
    <- limit
fi

priv task introsort_range<T: ordered>(flex xs: [T]@a, low: int, high: int, depth: int)
    when low < high
        when high - low < 16
            insertion_sort(xs, low, high)
            <-
        fi
        when depth <= 0
            heapsort_range(xs, low, high)
            <-
        fi
        fixed mid = low + (high - low) / 2
        when xs[mid] < xs[low]
            xs[low], xs[mid] = xs[mid], xs[low]
        fi
        when xs[high] < xs[low]
            xs[low], xs[high] = xs[high], xs[low]
        fi
        when xs[mid] < xs[high]
            xs[mid], xs[high] = xs[high], xs[mid]
        fi
        fixed pivot = xs[high]
        flex i = low - 1
        each j in low..high
            when xs[j] <= pivot
                i++
                xs[i], xs[j] = xs[j], xs[i]
            fi
        fi
        xs[i + 1], xs[high] = xs[high], xs[i + 1]
        fixed pi = i + 1
        introsort_range(xs, low, pi - 1, depth - 1)
        introsort_range(xs, pi + 1, high, depth - 1)
    fi
fi

priv task heapsort_range<T: ordered>(flex xs: [T]@a, low: int, high: int)
    fixed count = high - low + 1
    flex i = count / 2 - 1
    loop i >= 0
        sift_down(xs, low, count, i)
        i--
    fi
    flex end = count - 1
    loop end > 0
        xs[low], xs[low + end] = xs[low + end], xs[low]
        sift_down(xs, low, end, 0)
        end--
    fi
fi

priv task sift_down<T: ordered>(flex xs: [T]@a, low: int, count: int, start: int)
    flex root = start
    loop root * 2 + 1 < count
        fixed child = root * 2 + 1
        flex swap = root
        when xs[low + swap] < xs[low + child]
            swap = child
        fi
        when child + 1 < count and xs[low + swap] < xs[low + child + 1]
            swap = child + 1
        fi
        when swap == root
            <-
        fi
        xs[low + root], xs[low + swap] = xs[low + swap], xs[low + root]
        root = swap
    fi
fi

priv task insertion_sort<T: ordered>(flex xs: [T]@a, low: int, high: int)
    each i in (low + 1)..=high
        flex j = i
        loop j > low and xs[j - 1] > xs[j]
            xs[j - 1], xs[j] = xs[j], xs[j - 1]
            j--
        fi
    fi
fi

priv task introsort_by_range<T>(flex xs: [T]@a, low: int, high: int, cmp: (T, T) -> int, depth: int)
    when low < high
        when high - low < 16
            insertion_sort_by(xs, low, high, cmp)
            <-
        fi
        when depth <= 0
            heapsort_by_range(xs, low, high, cmp)
            <-
        fi
        fixed mid = low + (high - low) / 2
        when cmp(xs[mid], xs[low]) < 0
            xs[low], xs[mid] = xs[mid], xs[low]
        fi
        when cmp(xs[high], xs[low]) < 0
            xs[low], xs[high] = xs[high], xs[low]
        fi
        when cmp(xs[mid], xs[high]) < 0
            xs[mid], xs[high] = xs[high], xs[mid]
        fi
        fixed pivot = xs[high]
        flex i = low - 1
        each j in low..high
            when cmp(xs[j], pivot) <= 0
                i++
                xs[i], xs[j] = xs[j], xs[i]
            fi
        fi
        xs[i + 1], xs[high] = xs[high], xs[i + 1]
        fixed pi = i + 1
        introsort_by_range(xs, low, pi - 1, cmp, depth - 1)
        introsort_by_range(xs, pi + 1, high, cmp, depth - 1)
    fi
fi

priv task heapsort_by_range<T>(flex xs: [T]@a, low: int, high: int, cmp: (T, T) -> int)
    fixed count = high - low + 1
    flex i = count / 2 - 1
    loop i >= 0
        sift_down_by(xs, low, count, i, cmp)
        i--
    fi
    flex end = count - 1
    loop end > 0
        xs[low], xs[low + end] = xs[low + end], xs[low]
        sift_down_by(xs, low, end, 0, cmp)
        end--
    fi
fi

priv task sift_down_by<T>(flex xs: [T]@a, low: int, count: int, start: int, cmp: (T, T) -> int)
    flex root = start
    loop root * 2 + 1 < count
        fixed child = root * 2 + 1
        flex swap = root
        when cmp(xs[low + swap], xs[low + child]) < 0
            swap = child
        fi
        when child + 1 < count and cmp(xs[low + swap], xs[low + child + 1]) < 0
            swap = child + 1
        fi
        when swap == root
            <-
        fi
        xs[low + root], xs[low + swap] = xs[low + swap], xs[low + root]
        root = swap
    fi
fi

priv task insertion_sort_by<T>(flex xs: [T]@a, low: int, high: int, cmp: (T, T) -> int)
    each i in (low + 1)..=high
        flex j = i
        loop j > low and cmp(xs[j - 1], xs[j]) > 0
            xs[j - 1], xs[j] = xs[j], xs[j - 1]
            j--
        fi
    fi
fi

priv task within(n: int, count: int) -> int
    when n < 0
        <- 0
    else when n > count
        <- count
    fi
    <- n
fi
