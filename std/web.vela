; std/web: networking, HTTP server, client, routing, and web primitives.

include std/files {File, FileMode, FileError}

kind SocketError
    WouldBlock
    Closed
    Failed
    NotFound
    AddressInUse
    ConnectionRefused
    ConnectionReset
    Timeout
fi

kind Method
    Get
    Post
    Put
    Patch
    Delete
    Head
    Options
fi

kind WebError
    ListenFailed
    BadRequest(why: text)
    PayloadTooLarge
    RouteNotFound(where: text)
    MethodNotAllowed(method: text, path: text)
    Unauthorized(why: text)
    ServerFailed(why: text)
fi

shape Socket
    priv handle: int = -1

    shared open(within: region) -> Socket ~ SocketError
        fixed h = native_socket_open(within)
        when h < 0
            <- fail error_of(-h)
        fi
        <- Socket { handle: h }
    fi

    bind_to(host: text@p, port: int) -> nothing ~ SocketError
        fixed res = native_socket_bind(.handle, host, port)
        when res < 0
            <- fail error_of(-res)
        fi
    fi

    listen(backlog: int = 128) -> nothing ~ SocketError
        fixed res = native_socket_listen(.handle, backlog)
        when res < 0
            <- fail error_of(-res)
        fi
    fi

    accept(within: region) -> Socket ~ SocketError
        fixed client = native_socket_accept(.handle, within)
        when client < 0
            <- fail error_of(-client)
        fi
        <- Socket { handle: client }
    fi

    connect(host: text@p, port: int) -> nothing ~ SocketError
        fixed res = native_socket_connect(.handle, host, port)
        when res < 0
            <- fail error_of(-res)
        fi
    fi

    read(max_bytes: int, into: region) -> text@into ~ SocketError
        fixed t = native_socket_read(.handle, max_bytes, into)
        fixed st = native_socket_status()
        when st != 0
            <- fail error_of(st)
        fi
        <- t
    fi

    write(data: text@p) -> int ~ SocketError
        fixed n = native_socket_write(.handle, data)
        when n < 0
            <- fail error_of(-n)
        fi
        <- n
    fi

    poll(events: int, timeout_ms: int) -> int ~ SocketError
        fixed r = native_socket_poll(.handle, events, timeout_ms)
        when r < 0
            <- fail error_of(-r)
        fi
        <- r
    fi

    raw_handle() -> int
        <- .handle
    fi

    alters close() -> nothing ~ SocketError
        when .handle < 0
            <- fail SocketError.Closed
        fi
        fixed res = native_socket_close(.handle)
        .handle = -1
        when res < 0
            <- fail error_of(-res)
        fi
    fi
fi

task socket(within: region) -> Socket ~ SocketError
    <- Socket.open(within)
fi

shape Request
    method: Method
    path: text
    raw_query: text
    headers: [text: text]
    body_data: text
    params: [text: text]

    header(name: text@p) -> maybe text@this
        when .headers[#name] is {found}
            <- found
        fi
        each k, v in .headers
            when text_eq_ignore_case(k, name)
                <- v
            fi
        fi
        <- none
    fi

    body() -> text@this
        <- .body_data
    fi

    param(name: text@p) -> maybe text@this
        when .params[#name] is {found}
            <- found
        fi
        <- none
    fi

    query(key: text@p) -> maybe text@this
        <- query_param(.raw_query, key)
    fi

    body_lines(r: region default) -> [text]@r
        flex lines = new [text]() at r
        flex pos = 0
        loop pos < .body_data.len
            fixed next_nl = text_find(.body_data, "\n", pos)
            when next_nl < 0
                lines.add("{cut(.body_data, pos, .body_data.len)}" at r)
                break
            fi
            fixed line_end = when next_nl > pos and cut(.body_data, next_nl - 1, next_nl) == "\r" next_nl - 1 else next_nl fi
            lines.add("{cut(.body_data, pos, line_end)}" at r)
            pos = next_nl + 1
        fi
        <- lines
    fi
fi

shape Response
    status: int = 200
    reason: text = "OK"
    headers: [text: text]
    body_data: text = ""
    is_stream: bool = false
    chunks: maybe [text] = none

    shared text(body: text@r, r: region default) -> Response@r
        flex hdrs = new [text: text]() at r
        hdrs["content-type"] = "text/plain; charset=utf-8"
        <- Response { status: 200, reason: "OK", headers: hdrs, body_data: body }
    fi

    shared html(body: text@r, r: region default) -> Response@r
        flex hdrs = new [text: text]() at r
        hdrs["content-type"] = "text/html; charset=utf-8"
        <- Response { status: 200, reason: "OK", headers: hdrs, body_data: body }
    fi

    shared json(body: text@r, r: region default) -> Response@r
        flex hdrs = new [text: text]() at r
        hdrs["content-type"] = "application/json; charset=utf-8"
        <- Response { status: 200, reason: "OK", headers: hdrs, body_data: body }
    fi

    shared json_of<T: shown>(val: T, r: region default) -> Response@r
        <- Response.json(val.json(r), r)
    fi

    shared json_map<K: shown, V: shown>(map: [K: V]@r, r: region default) -> Response@r
        <- Response.json(map.json(r), r)
    fi

    shared stream(chunks: [text]@r, r: region default) -> Response@r
        flex hdrs = new [text: text]() at r
        hdrs["content-type"] = "text/plain; charset=utf-8"
        hdrs["transfer-encoding"] = "chunked"
        <- Response { status: 200, reason: "OK", headers: hdrs, body_data: "", is_stream: true, chunks: chunks }
    fi

    shared stream_with_type(chunks: [text]@r, content_type: text@r, r: region default) -> Response@r
        flex hdrs = new [text: text]() at r
        hdrs["content-type"] = content_type
        hdrs["transfer-encoding"] = "chunked"
        <- Response { status: 200, reason: "OK", headers: hdrs, body_data: "", is_stream: true, chunks: chunks }
    fi

    shared sse(chunks: [text]@r, r: region default) -> Response@r
        flex hdrs = new [text: text]() at r
        hdrs["content-type"] = "text/event-stream; charset=utf-8"
        hdrs["cache-control"] = "no-cache"
        hdrs["transfer-encoding"] = "chunked"
        <- Response { status: 200, reason: "OK", headers: hdrs, body_data: "", is_stream: true, chunks: chunks }
    fi

    shared with_status(code: int, r: region default, custom_reason: text@r = "") -> Response@r
        fixed r_name = when custom_reason != "" custom_reason else reason_of(code) fi
        <- Response { status: code, reason: r_name, headers: new [text: text]() at r, body_data: "" }
    fi

    shared redirect(to: text@r, r: region default, code: int = 302) -> Response@r
        flex hdrs = new [text: text]() at r
        hdrs["location"] = to
        <- Response { status: code, reason: reason_of(code), headers: hdrs, body_data: "" }
    fi

    alters header(name: text@this, value: text@this) -> Response@this
        .headers[name] = value
        <- .this
    fi

    alters status_code(code: int, custom_reason: text@this = "") -> Response@this
        .status = code
        .reason = when custom_reason != "" custom_reason else reason_of(code) fi
        <- .this
    fi

    alters set_body(content: text@this) -> Response@this
        .body_data = content
        <- .this
    fi
fi

task text_response(body: text@r, r: region default) -> Response@r
    <- Response.text(body, r)
fi

task html_response(body: text@r, r: region default) -> Response@r
    <- Response.html(body, r)
fi

task json_response(body: text@r, r: region default) -> Response@r
    <- Response.json(body, r)
fi

task json(body: text@r, r: region default) -> Response@r
    <- Response.json(body, r)
fi

task json_of<T: shown>(val: T, r: region default) -> Response@r
    <- Response.json_of(val, r)
fi

task json_map<K: shown, V: shown>(map: [K: V]@r, r: region default) -> Response@r
    <- Response.json_map(map, r)
fi

task stream_response(chunks: [text]@r, r: region default) -> Response@r
    <- Response.stream(chunks, r)
fi

task stream(chunks: [text]@r, r: region default) -> Response@r
    <- Response.stream(chunks, r)
fi

task stream_with_type(chunks: [text]@r, content_type: text@r, r: region default) -> Response@r
    <- Response.stream_with_type(chunks, content_type, r)
fi

task sse_response(chunks: [text]@r, r: region default) -> Response@r
    <- Response.sse(chunks, r)
fi

task sse(chunks: [text]@r, r: region default) -> Response@r
    <- Response.sse(chunks, r)
fi

task sse_event(data: text@p, event: text@p, id: text@p, r: region default) -> text@r
    flex res: text@r = ""
    when event.len > 0
        res = "event: {event}\n" at r
    fi
    when id.len > 0
        res = "{res}id: {id}\n" at r
    fi
    res = "{res}data: {data}\n\n" at r
    <- res
fi

task sse_msg(event: text@p, data: text@p, r: region default) -> text@r
    <- sse_event(data, event, "", r)
fi

task sse_data(data: text@p, r: region default) -> text@r
    <- sse_event(data, "", "", r)
fi

task status_response(code: int, r: region default, custom_reason: text@r = "") -> Response@r
    <- Response.with_status(code, r, custom_reason)
fi

task status(code: int, r: region default, custom_reason: text@r = "") -> Response@r
    <- Response.with_status(code, r, custom_reason)
fi

task redirect(to: text@r, r: region default, code: int = 302) -> Response@r
    <- Response.redirect(to, r, code)
fi

shape ServerState
    shared flex should_stop: bool = false

    shared stop()
        ServerState.should_stop = true
    fi

    shared reset()
        ServerState.should_stop = false
    fi
fi

task stop_server()
    ServerState.stop()
fi

shape Server
    addr: text
    max_body_size: int = 1048576
    keep_alive_enabled: bool = true
    read_timeout_ms: int = 5000
    idle_timeout_ms: int = 15000
    running: bool = true
    error_handler: maybe (WebError@r, Request@r, @r) -> Response@r = none

    shared new(addr: text@p = "127.0.0.1:8080") -> Server@p
        <- Server { addr: addr, max_body_size: 1048576, keep_alive_enabled: true, read_timeout_ms: 5000, idle_timeout_ms: 15000, running: true, error_handler: none }
    fi

    shared stop()
        ServerState.stop()
    fi

    body_limit(limit: int) -> Server@this
        <- Server { addr: .addr, max_body_size: limit, keep_alive_enabled: .keep_alive_enabled, read_timeout_ms: .read_timeout_ms, idle_timeout_ms: .idle_timeout_ms, running: .running, error_handler: .error_handler }
    fi

    keep_alive(enabled: bool) -> Server@this
        <- Server { addr: .addr, max_body_size: .max_body_size, keep_alive_enabled: enabled, read_timeout_ms: .read_timeout_ms, idle_timeout_ms: .idle_timeout_ms, running: .running, error_handler: .error_handler }
    fi

    timeouts(read_ms: int, idle_ms: int) -> Server@this
        <- Server { addr: .addr, max_body_size: .max_body_size, keep_alive_enabled: .keep_alive_enabled, read_timeout_ms: read_ms, idle_timeout_ms: idle_ms, running: .running, error_handler: .error_handler }
    fi

    on_error(handler: (WebError@r, Request@r, @r) -> Response@r) -> Server@this
        <- Server { addr: .addr, max_body_size: .max_body_size, keep_alive_enabled: .keep_alive_enabled, read_timeout_ms: .read_timeout_ms, idle_timeout_ms: .idle_timeout_ms, running: .running, error_handler: handler }
    fi

    serve(handler: (Request@r, @r) -> Response@r ~ WebError@r = default_route) -> nothing ~ WebError
        <- run_event_loop(.this, handler)
    fi
fi

shape Client
    timeout_ms: int = 5000

    shared new(timeout_ms: int = 5000) -> Client
        <- Client { timeout_ms: timeout_ms }
    fi

    timeout(ms: int) -> Client
        <- Client { timeout_ms: ms }
    fi

    get(url: text@p, r: region default) -> Response@r ~ WebError@r
        <- http_client_request("GET", url, "", "text/plain", .timeout_ms, r)
    fi

    post(url: text@p, body: text@p, content_type: text@p, r: region default) -> Response@r ~ WebError@r
        <- http_client_request("POST", url, body, content_type, .timeout_ms, r)
    fi

    post_json(url: text@p, body: text@p, r: region default) -> Response@r ~ WebError@r
        <- http_client_request("POST", url, body, "application/json", .timeout_ms, r)
    fi

    shared fetch(url: text@p, r: region default) -> Response@r ~ WebError@r
        <- http_client_request("GET", url, "", "text/plain", 5000, r)
    fi

    shared fetch_post(url: text@p, body: text@p, content_type: text@p, r: region default) -> Response@r ~ WebError@r
        <- http_client_request("POST", url, body, content_type, 5000, r)
    fi

    shared fetch_json(url: text@p, body: text@p, r: region default) -> Response@r ~ WebError@r
        <- http_client_request("POST", url, body, "application/json", 5000, r)
    fi
fi

task fetch(url: text@p, r: region default) -> Response@r ~ WebError@r
    <- Client.fetch(url, r)
fi

task fetch_post(url: text@p, body: text@p, content_type: text@p, r: region default) -> Response@r ~ WebError@r
    <- Client.fetch_post(url, body, content_type, r)
fi

task fetch_json(url: text@p, body: text@p, r: region default) -> Response@r ~ WebError@r
    <- Client.fetch_json(url, body, r)
fi

shape RouteEntry
    method_code: int = 0
    pattern: text = ""
    handler: maybe (Request@r, @r) -> Response@r ~ WebError@r = none
    folder: text = ""
    prefix: text = ""
fi

shape Router
    count: int = 0
    routes: [RouteEntry#128] = [RouteEntry {}#128]
    error_handler: maybe (WebError@r, Request@r, @r) -> Response@r = none

    shared new() -> Router
        <- Router {}
    fi

    alters on_error(handler: (WebError@r, Request@r, @r) -> Response@r) -> Router@this
        .error_handler = handler
        <- .this
    fi

    alters enroll(m: int, pattern: text, handler: (Request@r, @r) -> Response@r ~ WebError@r) -> Router@this
        when .count < 128
            .routes[.count] = RouteEntry { method_code: m, pattern: pattern, handler: handler }
            .count++
        fi
        <- .this
    fi

    alters get(pattern: text, handler: (Request@r, @r) -> Response@r ~ WebError@r) -> Router@this
        <- .enroll(1, pattern, handler)
    fi

    alters post(pattern: text, handler: (Request@r, @r) -> Response@r ~ WebError@r) -> Router@this
        <- .enroll(2, pattern, handler)
    fi

    alters put(pattern: text, handler: (Request@r, @r) -> Response@r ~ WebError@r) -> Router@this
        <- .enroll(3, pattern, handler)
    fi

    alters patch(pattern: text, handler: (Request@r, @r) -> Response@r ~ WebError@r) -> Router@this
        <- .enroll(4, pattern, handler)
    fi

    alters delete(pattern: text, handler: (Request@r, @r) -> Response@r ~ WebError@r) -> Router@this
        <- .enroll(5, pattern, handler)
    fi

    alters files(pattern: text, folder: text, prefix: text = "") -> Router@this
        when .count < 128
            .routes[.count] = RouteEntry { method_code: 1, pattern: pattern, folder: folder, prefix: prefix }
            .count++
        fi
        <- .this
    fi

    route(req: Request@r, r: region default) -> Response@r ~ WebError@r
        flex idx = 0
        flex path_matched = false
        loop idx < .count
            fixed entry = .routes[idx]
            flex params = new [text: text]() at r
            when match_route(entry.pattern, req.path, params, r)
                path_matched = true
                when entry.method_code == 0 or entry.method_code == method_code(req.method)
                    when entry.folder != ""
                        <- serve_file_request(entry.folder, entry.prefix, req, r)
                    else when entry.handler is {h}
                        fixed routed_req = Request { method: req.method, path: req.path, raw_query: req.raw_query, headers: req.headers, body_data: req.body_data, params: params }
                        fixed resp = h(routed_req, r) { failure err
                            when .error_handler is {eh}
                                <- eh(err, routed_req, r)
                            fi
                            <- fail err
                        }
                        <- resp
                    fi
                fi
            fi
            idx++
        fi
        when path_matched
            when .error_handler is {eh}
                <- eh(WebError.MethodNotAllowed(method_name(req.method), req.path), req, r)
            fi
            <- fail WebError.MethodNotAllowed(method_name(req.method), req.path)
        fi
        when .error_handler is {eh}
            <- eh(WebError.RouteNotFound(req.path), req, r)
        fi
        <- fail WebError.RouteNotFound(req.path)
    fi
fi

shape DefaultRouter
    shared flex count: int = 0
    shared flex routes: [RouteEntry#128] = [RouteEntry {}#128]
    shared flex error_handler: maybe (WebError@r, Request@r, @r) -> Response@r = none

    shared on_error(handler: (WebError@r, Request@r, @r) -> Response@r)
        DefaultRouter.error_handler = handler
    fi

    shared enroll(m: int, pattern: text, handler: (Request@r, @r) -> Response@r ~ WebError@r)
        when DefaultRouter.count < 128
            DefaultRouter.routes[DefaultRouter.count] = RouteEntry { method_code: m, pattern: pattern, handler: handler }
            DefaultRouter.count++
        fi
    fi

    shared files(pattern: text, folder: text, prefix: text = "")
        DefaultRouter.enroll_files(pattern, folder, prefix)
    fi

    shared enroll_files(pattern: text, folder: text, prefix: text = "")
        when DefaultRouter.count < 128
            DefaultRouter.routes[DefaultRouter.count] = RouteEntry { method_code: 1, pattern: pattern, folder: folder, prefix: prefix }
            DefaultRouter.count++
        fi
    fi

    shared clear()
        DefaultRouter.count = 0
        DefaultRouter.error_handler = none
    fi

    shared route(req: Request@r, r: region default) -> Response@r ~ WebError@r
        flex idx = 0
        flex path_matched = false
        loop idx < DefaultRouter.count
            fixed entry = DefaultRouter.routes[idx]
            flex params = new [text: text]() at r
            when match_route(entry.pattern, req.path, params, r)
                path_matched = true
                when entry.method_code == 0 or entry.method_code == method_code(req.method)
                    when entry.folder != ""
                        <- serve_file_request(entry.folder, entry.prefix, req, r)
                    else when entry.handler is {h}
                        fixed routed_req = Request { method: req.method, path: req.path, raw_query: req.raw_query, headers: req.headers, body_data: req.body_data, params: params }
                        fixed resp = h(routed_req, r) { failure err
                            when DefaultRouter.error_handler is {eh}
                                <- eh(err, routed_req, r)
                            fi
                            <- fail err
                        }
                        <- resp
                    fi
                fi
            fi
            idx++
        fi
        when path_matched
            when DefaultRouter.error_handler is {eh}
                <- eh(WebError.MethodNotAllowed(method_name(req.method), req.path), req, r)
            fi
            <- fail WebError.MethodNotAllowed(method_name(req.method), req.path)
        fi
        when DefaultRouter.error_handler is {eh}
            <- eh(WebError.RouteNotFound(req.path), req, r)
        fi
        <- fail WebError.RouteNotFound(req.path)
    fi

    shared get(handler: (Request@r, @r) -> Response@r ~ WebError@r, pattern: text)
        DefaultRouter.enroll(1, pattern, handler)
    fi

    shared post(handler: (Request@r, @r) -> Response@r ~ WebError@r, pattern: text)
        DefaultRouter.enroll(2, pattern, handler)
    fi

    shared put(handler: (Request@r, @r) -> Response@r ~ WebError@r, pattern: text)
        DefaultRouter.enroll(3, pattern, handler)
    fi

    shared patch(handler: (Request@r, @r) -> Response@r ~ WebError@r, pattern: text)
        DefaultRouter.enroll(4, pattern, handler)
    fi

    shared delete(handler: (Request@r, @r) -> Response@r ~ WebError@r, pattern: text)
        DefaultRouter.enroll(5, pattern, handler)
    fi
fi

task default_route(req: Request@r, r: region default) -> Response@r ~ WebError@r
    <- DefaultRouter.route(req, r)
fi

task on_error(handler: (WebError@r, Request@r, @r) -> Response@r)
    DefaultRouter.on_error(handler)
fi

task get(handler: (Request@r, @r) -> Response@r ~ WebError@r, pattern: text)
    DefaultRouter.enroll(1, pattern, handler)
fi

task post(handler: (Request@r, @r) -> Response@r ~ WebError@r, pattern: text)
    DefaultRouter.enroll(2, pattern, handler)
fi

task put(handler: (Request@r, @r) -> Response@r ~ WebError@r, pattern: text)
    DefaultRouter.enroll(3, pattern, handler)
fi

task patch(handler: (Request@r, @r) -> Response@r ~ WebError@r, pattern: text)
    DefaultRouter.enroll(4, pattern, handler)
fi

task delete(handler: (Request@r, @r) -> Response@r ~ WebError@r, pattern: text)
    DefaultRouter.enroll(5, pattern, handler)
fi

task route(handler: (Request@r, @r) -> Response@r ~ WebError@r, pattern: text)
    DefaultRouter.enroll(0, pattern, handler)
fi

task router() -> Router
    <- Router.new()
fi

shape FileServer
    folder: text
    prefix: text = ""

    shared new(folder: text@p, prefix: text@p = "") -> FileServer@p
        <- FileServer { folder: folder, prefix: prefix }
    fi

    serve(req: Request@r, r: region default) -> Response@r ~ WebError@r
        <- serve_file_request(.folder, .prefix, req, r)
    fi
fi

task files(folder: text@p, req: Request@r, prefix: text@p, r: region default) -> Response@r ~ WebError@r
    <- serve_file_request(folder, prefix, req, r)
fi

task static_files(folder: text@p, req: Request@r, r: region default) -> Response@r ~ WebError@r
    <- serve_file_request(folder, "", req, r)
fi

task serve_files(pattern: text, folder: text, prefix: text = "")
    DefaultRouter.files(pattern, folder, prefix)
fi

task file_response(path: text@p, r: region default) -> Response@r ~ WebError@r
    when not validate_file_path(path)
        <- fail WebError.BadRequest("invalid file path")
    fi
    flex f = File { path: path }
    when not f.exists()
        <- fail WebError.RouteNotFound("{path}" at r)
    fi
    f.open(FileMode.Read, r) { failure _
        <- fail WebError.RouteNotFound("{path}" at r)
    }
    fixed content = f.read(r) { failure _
        f.close() { failure _ }
        <- fail WebError.ServerFailed("failed reading file")
    }
    f.close() { failure _ }
    flex hdrs = new [text: text]() at r
    hdrs["content-type"] = mime_type(path, r)
    <- Response { status: 200, reason: "OK", headers: hdrs, body_data: content }
fi

task match_route(pattern: text@p, path: text@r, flex params: [text: text]@r, r: region default) -> bool
    fixed norm_path: text@r = when path.len > 1 and cut(path, path.len - 1, path.len) == "/" cut(path, 0, path.len - 1) else path fi
    when pattern == norm_path
        <- true
    fi

    when pattern.len >= 2 and cut(pattern, pattern.len - 2, pattern.len) == "/*"
        fixed prefix = cut(pattern, 0, pattern.len - 2)
        when norm_path.len >= prefix.len and cut(norm_path, 0, prefix.len) == prefix
            when norm_path.len == prefix.len
                params["*"] = ""
                <- true
            fi
            when cut(norm_path, prefix.len, prefix.len + 1) == "/"
                params["*"] = cut(norm_path, prefix.len + 1, norm_path.len)
                <- true
            fi
        fi
        <- false
    fi

    flex pat_pos = 0
    flex path_pos = 0
    loop pat_pos < pattern.len and path_pos < norm_path.len
        fixed next_pat_slash = text_find(pattern, "/", pat_pos)
        fixed pat_end = when next_pat_slash >= 0 next_pat_slash else pattern.len fi
        fixed pat_seg = cut(pattern, pat_pos, pat_end)
        pat_pos = when next_pat_slash >= 0 next_pat_slash + 1 else pattern.len fi

        fixed next_path_slash = text_find(norm_path, "/", path_pos)
        fixed path_end = when next_path_slash >= 0 next_path_slash else norm_path.len fi
        fixed path_seg = cut(norm_path, path_pos, path_end)
        path_pos = when next_path_slash >= 0 next_path_slash + 1 else norm_path.len fi

        when pat_seg.len >= 2 and cut(pat_seg, 0, 1) == "\{" and cut(pat_seg, pat_seg.len - 1, pat_seg.len) == "\}"
            fixed param_name = cut(pat_seg, 1, pat_seg.len - 1)
            params["{param_name}" at r] = path_seg
        else when pat_seg == "*"
            params["*"] = cut(norm_path, path_pos, norm_path.len)
            <- true
        else when pat_seg != path_seg
            <- false
        fi
    fi

    <- pat_pos >= pattern.len and path_pos >= norm_path.len
fi

shape ActiveConn
    sock: Socket
    active: bool = false
    last_active: int = 0
    reading: bool = false
    buf: text = ""
fi

task is_request_complete(buf: text@p) -> bool
    fixed body_start = text_find(buf, "\r\n\r\n", 0)
    when body_start < 0
        <- false
    fi
    fixed te_idx = text_find(buf, "transfer-encoding:", 0)
    fixed te_idx_upper = when te_idx >= 0 te_idx else text_find(buf, "Transfer-Encoding:", 0) fi
    when te_idx_upper >= 0 and te_idx_upper < body_start
        fixed is_chunked = text_find(buf, "chunked", te_idx_upper) >= 0
        when is_chunked
            <- text_find(buf, "\r\n0\r\n\r\n", body_start) >= 0 or (buf.len >= body_start + 9 and cut(buf, body_start + 4, body_start + 9) == "0\r\n\r\n")
        fi
    fi
    fixed cl_idx = text_find(buf, "Content-Length:", 0)
    fixed cl_idx_lower = when cl_idx >= 0 cl_idx else text_find(buf, "content-length:", 0) fi
    when cl_idx_lower >= 0 and cl_idx_lower < body_start
        fixed cl_end = text_find(buf, "\r\n", cl_idx_lower)
        when cl_end <= cl_idx_lower + 15
            <- false
        fi
        fixed cl_val_str = trim(cut(buf, cl_idx_lower + 15, cl_end))
        fixed content_len = int(cl_val_str) { 0 }
        ; Compared with what has come, not added to where it starts, so a huge length can't overflow.
        <- content_len <= buf.len - body_start - 4
    fi
    <- true
fi

task process_connection_request(flex client: Socket, raw: text@r, handler: (Request@r, @r) -> Response@r ~ WebError@r, max_body: int, keep_alive_enabled: bool, err_handler: maybe (WebError@r, Request@r, @r) -> Response@r, r: region default) -> bool
    fixed req = parse_request(raw, r) { failure e
        send_error_response(client, 400, "Bad Request", "Malformed request headers\n", r)
        <- false
    }
    when req.body_data.len > max_body
        when err_handler is {eh}
            fixed err_resp = eh(WebError.PayloadTooLarge, req, r)
            send_response(client, err_resp, false, r)
            <- false
        else when DefaultRouter.error_handler is {deh}
            fixed err_resp = deh(WebError.PayloadTooLarge, req, r)
            send_response(client, err_resp, false, r)
            <- false
        fi
        send_error_response(client, 413, "Payload Too Large", "413 Payload Too Large\n", r)
        <- false
    fi

    flex will_keep = keep_alive_enabled
    when req.header("connection") is {c}
        when text_eq_ignore_case(c, "close")
            will_keep = false
        fi
    fi

    fixed resp = handler(req, r) { failure err
        fixed err_resp = when err_handler is {eh}
            eh(err, req, r)
        else when DefaultRouter.error_handler is {deh}
            deh(err, req, r)
        else
            match err
            case WebError.RouteNotFound where_ = status(404, r, "Not Found").header("content-type", "text/plain").set_body("404 Not Found: {where_}\n")
            case WebError.BadRequest why = status(400, r, "Bad Request").header("content-type", "text/plain").set_body("400 Bad Request: {why}\n")
            case WebError.PayloadTooLarge = status(413, r, "Payload Too Large").header("content-type", "text/plain").set_body("413 Payload Too Large\n")
            case WebError.MethodNotAllowed method path = status(405, r, "Method Not Allowed").header("content-type", "text/plain").set_body("405 Method Not Allowed: {method} {path}\n")
            case WebError.Unauthorized why = status(401, r, "Unauthorized").header("content-type", "text/plain").set_body("401 Unauthorized: {why}\n")
            case _ = status(500, r, "Internal Server Error").header("content-type", "text/plain").set_body("500 Internal Server Error\n")
            fi
        fi
        send_response(client, err_resp, false, r)
        <- false
    }

    when resp.headers[#"connection"] is {c}
        when text_eq_ignore_case(c, "close")
            will_keep = false
        fi
    fi

    send_response(client, resp, will_keep, r)
    <- will_keep
fi

task event_loop_tick(server: Server@p, server_sock: Socket, flex& conns: [ActiveConn@r#64], handler: (Request@r, @r) -> Response@r ~ WebError@r, timeout_ms: int, r: region default)
    fixed now = time_ms()

    flex c_idx = 0
    loop c_idx < 64
        fixed conn = conns[c_idx]
        when conn.active
            fixed elapsed = now - conn.last_active
            when conn.reading and elapsed > server.read_timeout_ms
                send_error_response(conn.sock, 408, "Request Timeout", "408 Request Timeout\n", r)
                Poll.unwatch(conn.sock)
                flex s = conn.sock
                s.close() { failure _ }
                conns[c_idx] = ActiveConn { sock: server_sock, active: false }
            else when not conn.reading and elapsed > server.idle_timeout_ms
                Poll.unwatch(conn.sock)
                flex s = conn.sock
                s.close() { failure _ }
                conns[c_idx] = ActiveConn { sock: server_sock, active: false }
            fi
        fi
        c_idx++
    fi

    when ServerState.should_stop
        <-
    fi

    Poll.wait(timeout_ms)

    when Poll.is_readable(server_sock)
        endless
            fixed client_sock = server_sock.accept(r) { failure _
                break
            }
            flex slot_idx = 0
            flex placed = false
            loop slot_idx < 64
                when not conns[slot_idx].active
                    conns[slot_idx] = ActiveConn { sock: client_sock, active: true, last_active: now, reading: false, buf: "" }
                    Poll.watch(client_sock, 1)
                    placed = true
                    break
                fi
                slot_idx++
            fi
            when not placed
                send_error_response(client_sock, 503, "Service Unavailable", "503 Server Busy\n", r)
                flex cs = client_sock
                cs.close() { failure _ }
            fi
        fi
    fi

    flex i = 0
    loop i < 64
        fixed conn = conns[i]
        when conn.active and Poll.is_readable(conn.sock)
            region req_r default
            fixed chunk = conn.sock.read(4096, req_r) { failure _
                Poll.unwatch(conn.sock)
                flex cs = conn.sock
                cs.close() { failure _ }
                conns[i] = ActiveConn { sock: server_sock, active: false }
                i++
                continue
            }
            when chunk.len == 0
                Poll.unwatch(conn.sock)
                flex cs = conn.sock
                cs.close() { failure _ }
                conns[i] = ActiveConn { sock: server_sock, active: false }
            else
                fixed is_complete = when conn.buf.len == 0 is_request_complete(chunk) else is_request_complete("{conn.buf}{chunk}" at req_r) fi
                when is_complete
                    fixed full_req = when conn.buf.len == 0 chunk else "{conn.buf}{chunk}" at req_r fi
                    fixed keep_conn = process_connection_request(conn.sock, full_req, handler, server.max_body_size, server.keep_alive_enabled, server.error_handler, req_r)
                    when keep_conn
                        conns[i] = ActiveConn { sock: conn.sock, active: true, last_active: time_ms(), reading: false, buf: "" }
                    else
                        Poll.unwatch(conn.sock)
                        flex cs = conn.sock
                        cs.close() { failure _ }
                        conns[i] = ActiveConn { sock: server_sock, active: false }
                    fi
                else when conn.buf.len + chunk.len > server.max_body_size + 65536
                    ; A request still unfinished past the largest body and 64 KiB of headers is refused,
                    ; so a client can't make the server hold an endless request.
                    send_error_response(conn.sock, 413, "Payload Too Large", "413 Payload Too Large\n", req_r)
                    Poll.unwatch(conn.sock)
                    flex cs = conn.sock
                    cs.close() { failure _ }
                    conns[i] = ActiveConn { sock: server_sock, active: false }
                else
                    fixed partial_buf = when conn.buf.len == 0 "{chunk}" at r else "{conn.buf}{chunk}" at r fi
                    conns[i] = ActiveConn { sock: conn.sock, active: true, last_active: time_ms(), reading: true, buf: partial_buf }
                fi
            fi
        fi
        i++
    fi
fi

task cleanup_event_loop(server_sock: Socket, flex& conns: [ActiveConn@r#64])
    flex j = 0
    loop j < 64
        when conns[j].active
            Poll.unwatch(conns[j].sock)
            flex cs = conns[j].sock
            cs.close() { failure _ }
        fi
        j++
    fi
    flex s_close = server_sock
    s_close.close() { failure _ }
    Poll.clear()
fi

task run_event_loop(server: Server@p, handler: (Request@r, @r) -> Response@r ~ WebError@r) -> nothing ~ WebError
    region srv_r default
    ServerState.reset()
    fixed (host, port) = parse_addr(server.addr)
    fixed server_sock = Socket.open(srv_r) { failure e
        <- fail WebError.ListenFailed
    }
    server_sock.bind_to(host, port) { failure e
        <- fail WebError.ListenFailed
    }
    server_sock.listen(128) { failure e
        <- fail WebError.ListenFailed
    }

    flex conns: [ActiveConn@srv_r#64] = [ActiveConn { sock: server_sock }#64]
    Poll.clear()
    Poll.watch(server_sock, 1)

    loop not ServerState.should_stop
        event_loop_tick(server, server_sock, &conns, handler, 50, srv_r)
    fi

    cleanup_event_loop(server_sock, &conns)
fi

task serve(addr: text@p, handler: (Request@r, @r) -> Response@r ~ WebError@r = default_route) -> nothing ~ WebError
    fixed s = Server.new(addr)
    <- s.serve(handler)
fi

task serve_one(server_sock: Socket, handler: (Request@r, @r) -> Response@r ~ WebError@r, r: region default) -> nothing ~ WebError
    fixed client_sock = server_sock.accept(r) { failure e
        <- fail WebError.BadRequest("failed accepting connection")
    }
    handle_connection(client_sock, handler, 1048576, r)
fi

task handle_connection(flex client: Socket, handler: (Request@r, @r) -> Response@r ~ WebError@r, max_body: int, r: region default) -> nothing
    fixed raw = read_http_request(client, max_body, r) { failure e
        send_error_response(client, 400, "Bad Request", "Malformed HTTP request\n", r)
        client.close() { failure _ }
        <-
    }
    process_connection_request(client, raw, handler, max_body, false, none, r)
    client.close() { failure _ }
fi

task send_error_response(client: Socket, code: int, reason: text@r, body: text@r, r: region default) -> nothing
    fixed resp = status(code, r, reason).header("content-type", "text/plain").set_body(body)
    send_response(client, resp, false, r)
fi

; Writes all of 'data'. One write on a socket that doesn't wait sends only what fits, so a large
; response would end early; this waits while the client's side is full, and gives up, false, when
; the client takes nothing for 5 seconds or the connection ends.
priv task write_all(client: Socket, data: text@p) -> bool
    flex sent = 0
    loop sent < data.len
        fixed n = client.write(cut(data, sent, data.len)) { failure _
            <- false
        }
        when n == 0
            fixed ready = client.poll(2, 5000) { failure _
                <- false
            }
            when ready == 0
                <- false
            fi
        fi
        sent += n
    fi
    <- true
fi

; 't' with each line break made a space: a header or reason holding one would end it early and
; start a header, or a response, its text chose.
priv task one_line(t: text@p, r: region) -> text@r
    flex out: text@r = ""
    flex from = 0
    flex i = 0
    loop i < t.len
        when t[i] == '\r' or t[i] == '\n'
            out = "{out}{cut(t, from, i)} " at r
            from = i + 1
        fi
        i++
    fi
    <- "{out}{cut(t, from, t.len)}" at r
fi

task send_response(client: Socket, resp: Response@r, keep_alive: bool, r: region default) -> nothing
    when resp.is_stream and resp.chunks is {chunk_list}
        flex wire = "HTTP/1.1 {resp.status} {one_line(resp.reason, r)}\r\n"
        when not resp.headers.has("transfer-encoding")
            wire = "{wire}Transfer-Encoding: chunked\r\n"
        fi
        when not resp.headers.has("connection")
            fixed conn_val = when keep_alive "keep-alive" else "close" fi
            wire = "{wire}Connection: {conn_val}\r\n"
        fi
        each k, v in resp.headers
            wire = "{wire}{one_line(k, r)}: {one_line(v, r)}\r\n"
        fi
        wire = "{wire}\r\n"
        when not write_all(client, wire)
            <-
        fi
        each chunk in chunk_list
            when chunk.len > 0
                fixed hex_len = int_to_hex(chunk.len, r)
                when not write_all(client, "{hex_len}\r\n{chunk}\r\n")
                    <-
                fi
            fi
        fi
        write_all(client, "0\r\n\r\n")
        <-
    fi
    flex wire = "HTTP/1.1 {resp.status} {one_line(resp.reason, r)}\r\n"
    when not resp.headers.has("content-length")
        wire = "{wire}Content-Length: {resp.body_data.len}\r\n"
    fi
    when not resp.headers.has("connection")
        fixed conn_val = when keep_alive "keep-alive" else "close" fi
        wire = "{wire}Connection: {conn_val}\r\n"
    fi
    each k, v in resp.headers
        wire = "{wire}{one_line(k, r)}: {one_line(v, r)}\r\n"
    fi
    wire = "{wire}\r\n{resp.body_data}"
    write_all(client, wire)
fi

task read_http_request(client: Socket, max_body: int, r: region default) -> text@r ~ WebError
    flex chunk = client.read(4096, r) { failure e
        <- fail WebError.BadRequest("failed reading from client")
    }
    when chunk.len == 0
        <- fail WebError.BadRequest("empty request")
    fi
    fixed hdr_end = text_find(chunk, "\r\n\r\n", 0)
    when hdr_end < 0
        endless
            fixed more = client.read(4096, r) { "" }
            when more.len == 0
                break
            fi
            chunk = "{chunk}{more}"
            when text_find(chunk, "\r\n\r\n", 0) >= 0
                break
            fi
            when chunk.len > 65536
                <- fail WebError.BadRequest("request headers too large")
            fi
        fi
    fi

    fixed body_start = text_find(chunk, "\r\n\r\n", 0)
    when body_start >= 0
        fixed cl_idx = text_find(chunk, "Content-Length:", 0)
        fixed cl_idx_lower = when cl_idx >= 0 cl_idx else text_find(chunk, "content-length:", 0) fi
        when cl_idx_lower >= 0 and cl_idx_lower < body_start
            fixed cl_end = text_find(chunk, "\r\n", cl_idx_lower)
            fixed cl_val_str = trim(cut(chunk, cl_idx_lower + 15, cl_end))
            fixed content_len = int(cl_val_str) { 0 }
            when content_len > max_body
                <- fail WebError.PayloadTooLarge
            fi
            loop chunk.len - body_start - 4 < content_len
                fixed more = client.read(4096, r) { "" }
                when more.len == 0
                    break
                fi
                chunk = "{chunk}{more}"
            fi
        fi
    fi
    <- chunk
fi

task parse_request(raw: text@r, r: region default) -> Request@r ~ WebError
    fixed line_end = text_find(raw, "\r\n", 0)
    when line_end < 0
        <- fail WebError.BadRequest("missing request line")
    fi
    fixed req_line = cut(raw, 0, line_end)

    fixed sp1 = text_find(req_line, " ", 0)
    when sp1 < 0
        <- fail WebError.BadRequest("invalid request line")
    fi
    fixed sp2 = text_find(req_line, " ", sp1 + 1)
    when sp2 < 0
        <- fail WebError.BadRequest("invalid request line")
    fi

    fixed method_str = cut(req_line, 0, sp1)
    fixed uri = cut(req_line, sp1 + 1, sp2)
    fixed method = method_of(method_str) { Method.Get }

    fixed q_mark = text_find(uri, "?", 0)
    fixed path: text@r = when q_mark >= 0 cut(uri, 0, q_mark) else uri fi
    fixed query: text@r = when q_mark >= 0 cut(uri, q_mark + 1, uri.len) else "" fi

    flex headers = new [text: text]() at r
    fixed hdr_end = text_find(raw, "\r\n\r\n", 0)
    when hdr_end < 0
        <- fail WebError.BadRequest("headers not terminated")
    fi

    flex cursor = line_end + 2
    loop cursor < hdr_end
        fixed next_crlf = text_find(raw, "\r\n", cursor)
        when next_crlf < 0 or next_crlf > hdr_end
            break
        fi
        fixed line = cut(raw, cursor, next_crlf)
        cursor = next_crlf + 2
        when line.len == 0
            continue
        fi
        fixed colon = text_find(line, ":", 0)
        when colon > 0
            fixed h_name = to_lower(trim(cut(line, 0, colon)), r)
            fixed h_val = trim(cut(line, colon + 1, line.len))
            headers[h_name] = h_val
        fi
    fi

    fixed raw_body = cut(raw, hdr_end + 4, raw.len)
    fixed is_chunked = when headers[#"transfer-encoding"] is {te}
        text_find(te, "chunked", 0) >= 0
    else
        false
    fi
    ; A body is as long as its Content-Length says, and bytes after it aren't part of it.
    fixed declared = when headers[#"content-length"] is {cl} int(cl) { -1 } else -1 fi
    fixed sized_body = when declared >= 0 and declared < raw_body.len cut(raw_body, 0, declared) else raw_body fi
    fixed body = when is_chunked decode_chunked_body(raw_body, r) else sized_body fi
    <- Request { method: method, path: path, raw_query: query, headers: headers, body_data: body, params: new [text: text]() at r }
fi

task parse_addr(addr: text@p) -> (text@p, int)
    fixed colon = text_find(addr, ":", 0)
    when colon < 0
        <- (addr, 80)
    fi
    when colon == 0
        fixed port = int(cut(addr, 1, addr.len)) { 80 }
        <- ("127.0.0.1", port)
    fi
    fixed host = cut(addr, 0, colon)
    fixed port = int(cut(addr, colon + 1, addr.len)) { 80 }
    <- (host, port)
fi

task parse_url(url: text@p) -> (text@p, int, text@p) ~ WebError
    flex rest = url
    when url.len >= 8 and cut(url, 0, 8) == "https://"
        <- fail WebError.BadRequest("https is not supported")
    fi
    when url.len >= 7 and cut(url, 0, 7) == "http://"
        rest = cut(url, 7, url.len)
    fi
    fixed slash_idx = text_find(rest, "/", 0)
    fixed host_port = when slash_idx >= 0 cut(rest, 0, slash_idx) else rest fi
    fixed path = when slash_idx >= 0 cut(rest, slash_idx, rest.len) else "/" fi
    fixed (host, port) = parse_addr(host_port)
    <- (host, port, path)
fi

task is_response_complete(buf: text@p) -> bool
    fixed body_start = text_find(buf, "\r\n\r\n", 0)
    when body_start < 0
        <- false
    fi
    fixed te_idx = text_find(buf, "transfer-encoding:", 0)
    fixed te_idx_upper = when te_idx >= 0 te_idx else text_find(buf, "Transfer-Encoding:", 0) fi
    when te_idx_upper >= 0 and te_idx_upper < body_start
        fixed is_chunked = text_find(buf, "chunked", te_idx_upper) >= 0
        when is_chunked
            <- text_find(buf, "\r\n0\r\n\r\n", body_start) >= 0 or (buf.len >= body_start + 9 and cut(buf, body_start + 4, body_start + 9) == "0\r\n\r\n")
        fi
    fi
    fixed cl_idx = text_find(buf, "Content-Length:", 0)
    fixed cl_idx_lower = when cl_idx >= 0 cl_idx else text_find(buf, "content-length:", 0) fi
    when cl_idx_lower >= 0 and cl_idx_lower < body_start
        fixed cl_end = text_find(buf, "\r\n", cl_idx_lower)
        when cl_end <= cl_idx_lower + 15
            <- false
        fi
        fixed cl_val_str = trim(cut(buf, cl_idx_lower + 15, cl_end))
        fixed content_len = int(cl_val_str) { 0 }
        ; Compared with what has come, not added to where it starts, so a huge length can't overflow.
        <- content_len <= buf.len - body_start - 4
    fi
    fixed sp1 = text_find(buf, " ", 0)
    when sp1 >= 0 and sp1 + 4 <= body_start
        fixed code_str = cut(buf, sp1 + 1, sp1 + 4)
        when code_str == "204" or code_str == "304"
            <- true
        fi
    fi
    <- false
fi

task parse_response(raw: text@r, r: region default) -> Response@r
    fixed line_end = text_find(raw, "\r\n", 0)
    fixed status_line = when line_end >= 0 cut(raw, 0, line_end) else raw fi
    fixed sp1 = text_find(status_line, " ", 0)
    fixed sp2 = when sp1 >= 0 text_find(status_line, " ", sp1 + 1) else -1 fi
    fixed status_code = when sp1 >= 0
        fixed code_end = when sp2 >= 0 sp2 else status_line.len fi
        int(cut(status_line, sp1 + 1, code_end)) { 200 }
    else
        200
    fi
    fixed reason = when sp2 >= 0
        trim(cut(status_line, sp2 + 1, status_line.len))
    else
        reason_of(status_code)
    fi

    flex headers = new [text: text]() at r
    fixed hdr_end = text_find(raw, "\r\n\r\n", 0)
    when hdr_end >= 0
        flex pos = line_end + 2
        loop pos < hdr_end
            fixed next_line = text_find(raw, "\r\n", pos)
            when next_line < 0 or next_line > hdr_end
                break
            fi
            fixed line = cut(raw, pos, next_line)
            fixed colon = text_find(line, ":", 0)
            when colon > 0
                fixed h_name = to_lower(trim(cut(line, 0, colon)), r)
                fixed h_val = trim(cut(line, colon + 1, line.len))
                headers[h_name] = h_val
            fi
            pos = next_line + 2
        fi
        fixed body_raw = cut(raw, hdr_end + 4, raw.len)
        fixed is_chunked = when headers[#"transfer-encoding"] is {te}
            text_find(te, "chunked", 0) >= 0
        else
            false
        fi
        fixed body = when is_chunked decode_chunked_body(body_raw, r) else body_raw fi
        <- Response { status: status_code, reason: reason, headers: headers, body_data: body }
    fi
    <- Response { status: status_code, reason: reason, headers: headers, body_data: "" }
fi

task http_client_request(method_str: text@p, url: text@p, body: text@p, content_type: text@p, timeout_ms: int, r: region default) -> Response@r ~ WebError@r
    fixed (host, port, path) = parse_url(url) { failure e
        <- fail e
    }
    fixed sock = Socket.open(r) { failure _
        <- fail WebError.BadRequest("failed opening client socket")
    }
    sock.connect(host, port) { failure _
        flex s = sock
        s.close() { failure _ }
        <- fail WebError.BadRequest("failed connecting to server")
    }

    fixed poll_wr = sock.poll(2, timeout_ms) { 0 }
    when poll_wr <= 0
        flex s = sock
        s.close() { failure _ }
        <- fail WebError.BadRequest("connection timed out")
    fi

    flex req_wire: text@r = "{method_str} {path} HTTP/1.1\r\nHost: {host}:{port}\r\nConnection: close\r\nUser-Agent: Vela/0.1\r\n" at r
    when body.len > 0
        req_wire = "{req_wire}Content-Type: {content_type}\r\nContent-Length: {body.len}\r\n" at r
    fi
    req_wire = "{req_wire}\r\n{body}" at r

    sock.write(req_wire) { failure _
        flex s = sock
        s.close() { failure _ }
        <- fail WebError.BadRequest("failed writing request")
    }

    flex raw_resp: text@r = ""
    fixed deadline = time_ms() + timeout_ms
    endless
        fixed now = time_ms()
        when now > deadline
            flex s = sock
            s.close() { failure _ }
            <- fail WebError.BadRequest("read timed out")
        fi
        fixed remaining = deadline - now
        fixed wait_time = when remaining > 1000 1000 else remaining fi
        fixed poll_rd = sock.poll(1, wait_time) { 0 }
        when poll_rd > 0
            fixed chunk = sock.read(4096, r) { failure _
                break
            }
            when chunk.len == 0
                break
            fi
            raw_resp = "{raw_resp}{chunk}" at r
            when is_response_complete(raw_resp)
                break
            fi
        fi
    fi
    flex s = sock
    s.close() { failure _ }

    when raw_resp.len == 0
        <- fail WebError.BadRequest("empty response from server")
    fi
    <- parse_response(raw_resp, r)
fi

task reason_of(code: int) -> text
    when code == 200
        <- "OK"
    else when code == 201
        <- "Created"
    else when code == 204
        <- "No Content"
    else when code == 301
        <- "Moved Permanently"
    else when code == 302
        <- "Found"
    else when code == 304
        <- "Not Modified"
    else when code == 400
        <- "Bad Request"
    else when code == 401
        <- "Unauthorized"
    else when code == 403
        <- "Forbidden"
    else when code == 404
        <- "Not Found"
    else when code == 405
        <- "Method Not Allowed"
    else when code == 413
        <- "Payload Too Large"
    else when code == 500
        <- "Internal Server Error"
    fi
    <- "OK"
fi

task method_of(name: text@p) -> maybe Method
    when name == "GET"
        <- Method.Get
    else when name == "POST"
        <- Method.Post
    else when name == "PUT"
        <- Method.Put
    else when name == "PATCH"
        <- Method.Patch
    else when name == "DELETE"
        <- Method.Delete
    else when name == "HEAD"
        <- Method.Head
    else when name == "OPTIONS"
        <- Method.Options
    fi
    <- none
fi

task method_name(m: Method) -> text
    fixed name = match m
    case Method.Get = "GET"
    case Method.Post = "POST"
    case Method.Put = "PUT"
    case Method.Patch = "PATCH"
    case Method.Delete = "DELETE"
    case Method.Head = "HEAD"
    case Method.Options = "OPTIONS"
    fi
    <- name
fi

task method_code(m: Method) -> int
    fixed c = match m
    case Method.Get = 1
    case Method.Post = 2
    case Method.Put = 3
    case Method.Patch = 4
    case Method.Delete = 5
    case Method.Head = 6
    case Method.Options = 7
    fi
    <- c
fi

task to_lower(s: text@p, into: region default) -> text@into
    <- native_text_lower(s, into)
fi

task trim(s: text@p) -> text@p
    <- native_text_trim(s)
fi

task text_find(haystack: text@p, needle: text@q, from: int = 0) -> int
    <- native_text_find(haystack, needle, from)
fi

task text_eq_ignore_case(a: text@p, b: text@q) -> bool
    <- native_text_eq_ignore_case(a, b)
fi

task query_param(raw_query: text@p, key: text@q) -> maybe text@p
    when raw_query.len == 0 or key.len == 0
        <- none
    fi
    flex cursor = 0
    loop cursor < raw_query.len
        fixed next_amp = text_find(raw_query, "&", cursor)
        fixed part_end = when next_amp >= 0 next_amp else raw_query.len fi
        fixed part = cut(raw_query, cursor, part_end)
        cursor = part_end + 1
        fixed eq = text_find(part, "=", 0)
        when eq > 0
            fixed k = cut(part, 0, eq)
            when k == key
                <- cut(part, eq + 1, part.len)
            fi
        fi
    fi
    <- none
fi

priv task error_of(code: int) -> SocketError
    when code == 1
        <- SocketError.WouldBlock
    else when code == 2
        <- SocketError.Closed
    else when code == 3
        <- SocketError.Failed
    else when code == 4
        <- SocketError.NotFound
    else when code == 5
        <- SocketError.AddressInUse
    else when code == 6
        <- SocketError.ConnectionRefused
    else when code == 7
        <- SocketError.ConnectionReset
    else when code == 8
        <- SocketError.Timeout
    fi
    <- SocketError.Failed
fi

task time_ms() -> int
    <- native_time_ms()
fi

task sleep_ms(ms: int)
    native_sleep_ms(ms)
fi

shape Poll
    shared clear()
        native_poll_clear()
    fi

    shared watch(sock: Socket, events: int = 1) -> int
        <- native_poll_add(sock.raw_handle(), events)
    fi

    shared unwatch(sock: Socket) -> int
        <- native_poll_remove(sock.raw_handle())
    fi

    shared wait(timeout_ms: int) -> int
        <- native_poll_wait(timeout_ms)
    fi

    shared revents(sock: Socket) -> int
        <- native_poll_revents(sock.raw_handle())
    fi

    shared is_readable(sock: Socket) -> bool
        <- native_poll_is_readable(sock.raw_handle())
    fi

    shared is_writable(sock: Socket) -> bool
        <- native_poll_is_writable(sock.raw_handle())
    fi
fi

task int_to_hex(n: int, r: region default) -> text@r
    when n <= 0
        <- "0"
    fi
    fixed digits = "0123456789abcdef"
    flex val = n
    flex res: text@r = ""
    loop val > 0
        fixed rem = val % 16
        res = "{cut(digits, rem, rem + 1)}{res}" at r
        val = val / 16
    fi
    <- res
fi

task hex_to_int(s: text@p) -> int
    flex val = 0
    flex i = 0
    loop i < s.len
        fixed ch = cut(s, i, i + 1)
        fixed d = when ch >= "0" and ch <= "9"
            int(ch) { 0 }
        else when ch == "a" or ch == "A"
            10
        else when ch == "b" or ch == "B"
            11
        else when ch == "c" or ch == "C"
            12
        else when ch == "d" or ch == "D"
            13
        else when ch == "e" or ch == "E"
            14
        else when ch == "f" or ch == "F"
            15
        else
            -1
        fi
        when d < 0
            break
        fi
        ; Too many digits for an int: -1, as a length no chunk has.
        when val > 576460752303423487
            <- -1
        fi
        val = val * 16 + d
        i++
    fi
    <- val
fi

task decode_chunked_body(raw_body: text@r, r: region default) -> text@r
    flex result: text@r = ""
    flex cursor = 0
    loop cursor < raw_body.len
        fixed crlf = text_find(raw_body, "\r\n", cursor)
        when crlf < 0
            break
        fi
        fixed hex_str = trim(cut(raw_body, cursor, crlf))
        cursor = crlf + 2
        fixed chunk_len = hex_to_int(hex_str)
        when chunk_len <= 0
            break
        fi
        when chunk_len > raw_body.len - cursor
            break
        fi
        fixed chunk = cut(raw_body, cursor, cursor + chunk_len)
        result = "{result}{chunk}" at r
        cursor = cursor + chunk_len + 2
    fi
    <- result
fi

; The bytes of 's' from 'from' to 'to', kept within it. Requests are bytes a client chose, so a
; cut lands anywhere, even inside a character, where a text slice would stop the server.
priv task cut(s: text@p, from: int, to: int) -> text@p
    <- native_text_bytes(s, from, to)
fi

task text_rfind(haystack: text@p, needle: text@q) -> int
    flex last = -1
    flex pos = 0
    loop pos < haystack.len
        fixed found = text_find(haystack, needle, pos)
        when found < 0
            break
        fi
        last = found
        pos = found + 1
    fi
    <- last
fi

task mime_type(path: text@p, r: region default) -> text
    fixed last_slash = text_rfind(path, "/")
    fixed filename_start = when last_slash >= 0 last_slash + 1 else 0 fi
    fixed filename = cut(path, filename_start, path.len)
    fixed dot_idx = text_rfind(filename, ".")
    when dot_idx < 0
        <- "application/octet-stream"
    fi
    fixed ext = to_lower(cut(filename, dot_idx + 1, filename.len), r)
    when ext == "html" or ext == "htm"
        <- "text/html; charset=utf-8"
    else when ext == "css"
        <- "text/css; charset=utf-8"
    else when ext == "js" or ext == "mjs"
        <- "application/javascript; charset=utf-8"
    else when ext == "json"
        <- "application/json; charset=utf-8"
    else when ext == "txt" or ext == "log" or ext == "md"
        <- "text/plain; charset=utf-8"
    else when ext == "png"
        <- "image/png"
    else when ext == "jpg" or ext == "jpeg"
        <- "image/jpeg"
    else when ext == "gif"
        <- "image/gif"
    else when ext == "svg"
        <- "image/svg+xml"
    else when ext == "ico"
        <- "image/x-icon"
    else when ext == "wasm"
        <- "application/wasm"
    fi
    <- "application/octet-stream"
fi

task validate_file_path(path: text@p) -> bool
    when path.len == 0
        <- false
    fi
    flex i = 0
    loop i < path.len
        fixed c = path[i]
        when c < ' ' or c == char(127) or c == '\\' or c == ':'
            <- false
        fi
        i++
    fi
    flex pos = 0
    loop pos < path.len
        fixed next_slash = text_find(path, "/", pos)
        fixed seg_end = when next_slash >= 0 next_slash else path.len fi
        fixed seg = cut(path, pos, seg_end)
        when seg == ".."
            <- false
        fi
        when seg.len == 0 and pos > 0 and seg_end < path.len
            <- false
        fi
        when next_slash < 0
            break
        fi
        pos = next_slash + 1
    fi
    <- true
fi

task serve_file_request(folder: text@p, prefix: text@p, req: Request@r, r: region default) -> Response@r ~ WebError@r
    flex sub_path: text@r = ""
    when req.param("*") is {matched_wildcard}
        sub_path = matched_wildcard
    else when prefix.len > 0
        when req.path.len < prefix.len or cut(req.path, 0, prefix.len) != prefix
            <- fail WebError.RouteNotFound(req.path)
        fi
        sub_path = "{cut(req.path, prefix.len, req.path.len)}" at r
    else
        sub_path = req.path
    fi
    loop sub_path.len > 0 and cut(sub_path, 0, 1) == "/"
        sub_path = "{cut(sub_path, 1, sub_path.len)}" at r
    fi
    when sub_path.len == 0 or sub_path == "."
        sub_path = "index.html"
    fi
    when sub_path.len > 0 and cut(sub_path, sub_path.len - 1, sub_path.len) == "/"
        sub_path = "{sub_path}index.html" at r
    fi
    when not validate_file_path(sub_path)
        <- fail WebError.BadRequest("invalid path: traversal or illegal character rejected")
    fi
    fixed disk_path: text@r = when folder.len == 0
        sub_path
    else when cut(folder, folder.len - 1, folder.len) == "/"
        "{folder}{sub_path}" at r
    else
        "{folder}/{sub_path}" at r
    fi
    flex f = File { path: disk_path }
    when not f.exists()
        <- fail WebError.RouteNotFound(req.path)
    fi
    f.open(FileMode.Read, r) { failure _
        <- fail WebError.RouteNotFound(req.path)
    }
    fixed content = f.read(r) { failure _
        f.close() { failure _ }
        <- fail WebError.ServerFailed("failed reading static file")
    }
    f.close() { failure _ }
    flex hdrs = new [text: text]() at r
    hdrs["content-type"] = mime_type(disk_path, r)
    <- Response { status: 200, reason: "OK", headers: hdrs, body_data: content }
fi

