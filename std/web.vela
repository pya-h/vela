priv native task native_socket_bind(handle: int, host: text@p, port: int) -> int
priv native task native_socket_listen(handle: int, backlog: int) -> int
priv native task native_socket_accept(handle: int, within: region) -> int
priv native task native_socket_connect(handle: int, host: text@p, port: int) -> int
priv native task native_socket_read(handle: int, max_bytes: int, into: region) -> text@into
priv native task native_socket_write(handle: int, data: text@p) -> int
priv native task native_socket_close(handle: int) -> int
priv native task native_socket_poll(handle: int, events: int, timeout_ms: int) -> int
priv native task native_socket_status() -> int
priv native task native_text_find(haystack: text@p, needle: text@q, from: int) -> int
priv native task native_text_lower(s: text@p, into: region) -> text@into
priv native task native_text_trim(s: text@p) -> text@p
priv native task native_text_bytes(s: text@p, from: int, to: int) -> text@p
priv native task native_text_eq_ignore_case(a: text@p, b: text@q) -> bool
priv native task native_time_ms() -> int
priv native task native_sleep_ms(ms: int) -> int
priv native task native_poll_clear()
priv native task native_poll_add(handle: int, events: int) -> int
priv native task native_poll_remove(handle: int) -> int
priv native task native_poll_wait(timeout_ms: int) -> int
priv native task native_poll_revents(handle: int) -> int
