{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Vela",
  "scopeName": "source.vela",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#characters" },
    { "include": "#constants" },
    { "include": "#decorators" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#operators" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.semicolon.vela",
          "match": ";.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.vela",
          "begin": "\"",
          "end": "\"|(?=$)",
          "patterns": [
            {
              "name": "constant.character.escape.vela",
              "match": "\\\\[ntr\\\\\"0{}]"
            },
            {
              "name": "meta.embedded.line.vela",
              "begin": "\\{",
              "end": "\\}|(?=$)",
              "beginCaptures": {
                "0": { "name": "punctuation.section.embedded.begin.vela" }
              },
              "endCaptures": {
                "0": { "name": "punctuation.section.embedded.end.vela" }
              },
              "patterns": [
                { "include": "$self" }
              ]
            }
          ]
        }
      ]
    },
    "characters": {
      "patterns": [
        {
          "name": "string.quoted.single.vela",
          "match": "'(?:\\\\[ntr\\\\'\"0{}]|[^\\\\'\\n])'"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.vela",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.none.vela",
          "match": "\\b(none)\\b"
        },
        {
          "name": "constant.numeric.hex.vela",
          "match": "\\b0x[0-9a-fA-F_]+\\b"
        },
        {
          "name": "constant.numeric.octal.vela",
          "match": "\\b0o[0-7_]+\\b"
        },
        {
          "name": "constant.numeric.binary.vela",
          "match": "\\b0b[01_]+\\b"
        },
        {
          "name": "constant.numeric.float.vela",
          "match": "\\b\\d[0-9_]*\\.[0-9_]+\\b"
        },
        {
          "name": "constant.numeric.integer.vela",
          "match": "\\b\\d[0-9_]*\\b"
        }
      ]
    },
    "decorators": {
      "patterns": [
        {
          "name": "entity.name.function.decorator.vela",
          "match": "\\$(?:[a-zA-Z_][a-zA-Z0-9_]*|\\([a-zA-Z_][a-zA-Z0-9_]*\\))"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(task)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.task.vela" },
            "2": { "name": "entity.name.function.vela" }
          }
        },
        {
          "match": "\\b(kind|shape|actor|event|pattern|alias)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.type.vela" },
            "2": { "name": "entity.name.type.vela" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.vela",
          "match": "\\b(when|else|loop|endless|each|break|continue|block|match|case|select|otherwise|after|fi|finally)\\b"
        },
        {
          "name": "keyword.control.exception.vela",
          "match": "\\b(fail|failure)\\b"
        },
        {
          "name": "storage.modifier.mutability.vela",
          "match": "\\b(fixed|flex|bind|hold)\\b"
        },
        {
          "name": "keyword.control.concurrency.vela",
          "match": "\\b(rush|spawn)\\b"
        },
        {
          "name": "keyword.other.declaration.vela",
          "match": "\\b(task|kind|shape|actor|event|pattern|alias|include)\\b"
        },
        {
          "name": "keyword.other.modifier.vela",
          "match": "\\b(priv|shared|own|type|new|region|at|default|alters)\\b"
        },
        {
          "name": "keyword.operator.logical.vela",
          "match": "\\b(and|or|not|in|is|maybe)\\b"
        },
        {
          "name": "support.function.builtin.vela",
          "match": "\\b(show|scan|chan_new)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.vela",
          "match": "\\b(int|int64|int32|int16|int8|uint|uint64|uint32|uint16|uint8|unit|float|float64|float32|bool|text|char|nothing)\\b"
        },
        {
          "name": "storage.type.container.vela",
          "match": "\\b(Chan|Commitment|Actor|List|Map|Poll)\\b"
        },
        {
          "name": "entity.name.type.custom.vela",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.channel.vela",
          "match": "<<-|->>"
        },
        {
          "name": "keyword.operator.arrow.function.vela",
          "match": "<-|->|=>|\\|>>*"
        },
        {
          "name": "keyword.operator.logical.parts.vela",
          "match": "\\|\\|"
        },
        {
          "name": "keyword.operator.pointer.vela",
          "match": "\\^|@|&|\\?"
        },
        {
          "name": "keyword.operator.comparison.vela",
          "match": "==|!=|~=|<>|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.error.vela",
          "match": "~"
        },
        {
          "name": "keyword.operator.compound.assignment.vela",
          "match": "\\+=|-=|\\*=|/=|%=|\\*\\*="
        },
        {
          "name": "keyword.operator.arithmetic.vela",
          "match": "\\+\\+|--|\\*\\*|\\+|-|\\*|/|%"
        },
        {
          "name": "keyword.operator.assignment.vela",
          "match": ":=|="
        },
        {
          "name": "punctuation.separator.vela",
          "match": "::|\\.\\.\\.|\\.\\.|\\.|,|:|#"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.member.vela",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*(?=\\s*\\()"
        },
        {
          "name": "variable.other.vela",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
