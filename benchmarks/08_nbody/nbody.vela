; Canonical 5-body solar system orbital simulation (Sun, Jupiter, Saturn, Uranus, Neptune).
; Tests double-precision vector operations, symplectic numerical integration, and array of shapes.

#DAYS_PER_YEAR = 365.24
#SOLAR_MASS = 39.47841760435743

shape Body
    x: float
    y: float
    z: float
    vx: float
    vy: float
    vz: float
    mass: float
fi

task advance(flex& b: [Body#5], dt: float)
    each i in 0..5
        each j in (i + 1)..5
            fixed dx = b[i].x - b[j].x
            fixed dy = b[i].y - b[j].y
            fixed dz = b[i].z - b[j].z
            fixed dist2 = dx * dx + dy * dy + dz * dz
            fixed dist = dist2 ** 0.5
            fixed mag = dt / (dist2 * dist)
            b[i].vx -= dx * b[j].mass * mag
            b[i].vy -= dy * b[j].mass * mag
            b[i].vz -= dz * b[j].mass * mag
            b[j].vx += dx * b[i].mass * mag
            b[j].vy += dy * b[i].mass * mag
            b[j].vz += dz * b[i].mass * mag
        fi
    fi
    each i in 0..5
        b[i].x += dt * b[i].vx
        b[i].y += dt * b[i].vy
        b[i].z += dt * b[i].vz
    fi
fi

task energy(b: [Body#5]) -> float
    flex e = 0.0
    each i in 0..5
        e += 0.5 * b[i].mass * (b[i].vx * b[i].vx + b[i].vy * b[i].vy + b[i].vz * b[i].vz)
        each j in (i + 1)..5
            fixed dx = b[i].x - b[j].x
            fixed dy = b[i].y - b[j].y
            fixed dz = b[i].z - b[j].z
            fixed dist = (dx * dx + dy * dy + dz * dz) ** 0.5
            e -= (b[i].mass * b[j].mass) / dist
        fi
    fi
    <- e
fi

task offset_momentum(flex& b: [Body#5])
    flex px = 0.0
    flex py = 0.0
    flex pz = 0.0
    each i in 0..5
        px += b[i].vx * b[i].mass
        py += b[i].vy * b[i].mass
        pz += b[i].vz * b[i].mass
    fi
    b[0].vx = -px / SOLAR_MASS
    b[0].vy = -py / SOLAR_MASS
    b[0].vz = -pz / SOLAR_MASS
fi

task init_bodies() -> [Body#5]
    flex b: [Body#5] = [Body { x: 0.0, y: 0.0, z: 0.0, vx: 0.0, vy: 0.0, vz: 0.0, mass: 0.0 } # 5]
    b[0] = Body { x: 0.0, y: 0.0, z: 0.0, vx: 0.0, vy: 0.0, vz: 0.0, mass: SOLAR_MASS }
    b[1] = Body { x: 4.8414314424647209, y: -1.1603200440274284, z: -0.1036220444711231, vx: 0.0016600766427440369 * DAYS_PER_YEAR, vy: 0.0076990111848140506 * DAYS_PER_YEAR, vz: -0.0000690460016972063 * DAYS_PER_YEAR, mass: 0.0009547919384243266 * SOLAR_MASS }
    b[2] = Body { x: 8.34336641812488, y: 4.124798564124305, z: -0.4035234171143214, vx: -0.002767425107268624 * DAYS_PER_YEAR, vy: 0.004998528012349172 * DAYS_PER_YEAR, vz: 0.00002304172975737639 * DAYS_PER_YEAR, mass: 0.00028588567272224176 * SOLAR_MASS }
    b[3] = Body { x: 12.894369562139131, y: -15.111151401698631, z: -0.22330757889265573, vx: 0.002964601375647616 * DAYS_PER_YEAR, vy: 0.0023784717397656363 * DAYS_PER_YEAR, vz: -0.000029658956854023756 * DAYS_PER_YEAR, mass: 0.00004366244043351563 * SOLAR_MASS }
    b[4] = Body { x: 15.379697114850917, y: -25.919314609987964, z: 0.17925877295037118, vx: 0.002680677724903893 * DAYS_PER_YEAR, vy: 0.001628241700382423 * DAYS_PER_YEAR, vz: -0.00009515922545197159 * DAYS_PER_YEAR, mass: 0.000051513890204661145 * SOLAR_MASS }
    <- b
fi

task main()
    flex bodies = init_bodies()
    offset_momentum(&bodies)
    show(int(energy(bodies) * 1000000.0))
    each step in 0..5000000
        advance(&bodies, 0.01)
    fi
    show(int(energy(bodies) * 1000000.0))
fi
