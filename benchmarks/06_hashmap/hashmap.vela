task main()
    region r default
    flex counts = new [int: int]() at r
    flex seed = 123456789
    each i in 0..5000000
        seed = (seed * 1103515245 + 12345) % 2147483648
        fixed key = seed % 200000
        counts[key] = counts[#key] { 0 } + 1
    fi
    flex total = 0
    each _, v in counts
        total += v
    fi
    show("unique: ", counts.len, " total: ", total)
fi
